{% for collection in product.collections %}

	{% if collection.title == 'License Plates' or collection.title == 'Image Hats' %}
        <button class="accordion">View Bulk Pricing</button>
        <div class="accordion-content">
            <table class="discount-info">
                <thead>
                    <tr>
                        <th class="discount-box-header">Order More Save More</th>
                        <th class="discount-box-header2">Price per item</th>
                      </tr>
                </thead>
                
                <tbody>
                <tr>
                    <td class="discount-box-header2">2+</td>
                    <td><span class="saso-price">$ 32.99</span></td>
                  </tr>    
                <tr>
                    <td class="discount-box-header2">3+</td>
                    <td><span class="saso-price">$ 30.99</span></td>
                  </tr>    
                <tr>
                    <td class="discount-box-header2">6+</td>
                    <td><span class="saso-price">$ 29.99</span></td>
                  </tr>    
                <tr>
                    <td class="discount-box-header2">12+</td>
                    <td><span class="saso-price">$ 24.99</span></td>
                  </tr>    
                <tr>
                    <td class="discount-box-header2">24+</td>
                    <td><span class="saso-price">$ 22.99</span></td>
                  </tr>    
                <tr>
                    <td class="discount-box-header2">36+</td>
                  {% if collection.title == 'Plaid'%}
                      <td><span class="saso-price">$ 19.99</span>
                  {% else %}
                    <td><span class="saso-price">$ 16.99</span></td>
                  {% endif %}
                  </tr>    
                </tbody>
            </table>
        </div>
	{% endif %}

{% endfor %}

{%- comment -%} Image Hats: tag-based (collection was renamed from "Image Hats" to
  "Custom Image Hats", so gate on the reliable `bulkhat` tag). Same standard hat tiers. {%- endcomment -%}
