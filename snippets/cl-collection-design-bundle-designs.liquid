{%- assign cdb_collection = product.metafields.custom.bundle_design_collection.value -%}
{%- assign cdb_components = product.metafields.custom.bundle_components.value -%}
{%- assign cdb_multiplier = product.metafields.custom.bundle_component_multiplier.value | default: 1 | plus: 0 -%}
{%- if cdb_multiplier < 1 -%}{%- assign cdb_multiplier = 1 -%}{%- endif -%}
{%- assign cdb_hat_count = cdb_components.size | times: cdb_multiplier -%}

{%- unless cdb_embedded -%}
  {{ 'cl-collection-design-bundle.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

<section class="{% unless cdb_embedded %}cl-cdb cl-cdb-component {% endunless %}cl-cdb__panel"
         data-cl-cdb-product="{{ product.id }}"
         {% if show_heading == false %}aria-label="Choose your design"{% else %}aria-labelledby="cl-cdb-design-heading-{{ product.id }}"{% endif %}>
  <div class="cl-cdb__step">1</div>
  <div class="cl-cdb__panel-body">
    {%- unless show_heading == false -%}
      <h2 id="cl-cdb-design-heading-{{ product.id }}">Choose your design</h2>
    {%- endunless -%}
    <p>Select one design. It will be applied to all {{ cdb_hat_count }} hats.</p>
    <script type="application/json" data-cl-cdb-designs>
      [
        {%- assign emitted_design = false -%}
        {%- for design in cdb_collection.products -%}
          {%- if design.type contains 'Hat' -%}
            {%- if emitted_design -%},{%- endif -%}
            {
              "id": {{ design.id | json }},
              "handle": {{ design.handle | json }},
              "title": {{ design.title | json }},
              "image": {{ design.featured_image | image_url: width: 600 | json }},
              "fields": {%- if design.metafields.custom.personalization_fields.value != blank -%}{{ design.metafields.custom.personalization_fields.value | json }}{%- else -%}["Custom Initial","Custom Text"]{%- endif -%}
            }
            {%- assign emitted_design = true -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    </script>
    <div class="cl-cdb__design-grid" data-cl-cdb-design-grid></div>
  </div>
</section>
