{% comment %} vue setup for product scroll {% endcomment %}

<script>
  // Pass all product tags to let API find the matching discount
  const productTags = {{ product.tags | json }};
  const productHandle = {{ product.handle | json }};

  {%- comment -%}
    Upsell modal toggle: boolean metafield custom.upsell_modal = true, set on the
    PRODUCT (one at a time) OR on a COLLECTION (bulk). Add the definition for both
    Products and Collections under Settings > Custom data. Product wins; else any
    enabled collection turns it on.
  {%- endcomment -%}
  {%- assign cl_modal_ok = false -%}
  {%- if product.metafields.custom.upsell_modal.value -%}{%- assign cl_modal_ok = true -%}{%- endif -%}
  {%- unless cl_modal_ok -%}
    {%- for c in product.collections -%}
      {%- if c.metafields.custom.upsell_modal.value -%}{%- assign cl_modal_ok = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endunless -%}
  const CL_MODAL_ENABLED = {% if cl_modal_ok %}true{% else %}false{% endif %};

  const { ref, reactive, createApp, watch, onBeforeMount } = Vue;

  if(document.querySelector('#add-to-cart-form')) { 

    const productForm = createApp({
      delimiters: ['${', '}'],
      setup() {
        let comments = ref([]);
        let selected = ref("Snapback");
        let page = 1;
        let isLoading = ref(true);
        let variant = ref([]);
        let options = ref([]);
        let items = ref([0, 1, 2, 3, 4, 5, 6, 7]);
        let qtySelected = reactive({});
        let basePrice = ref(34.99);
        let totalQty = ref(0);
        let subTotal = ref(0.00);
        let indiPrice = ref(0.00);
        let messageDiscount = ref("ORDER MORE THAN 1 FOR DISCOUNTED PRICING");
        let discountQtys = ref([]);
        let discountAmounts = ref([]);
        let discountName = ref("");
        let prevCartItem = false;
        let cartData;
        let scrollContent;
        let displayStyle = ref(false);

        // ----- Upsell / milestone state -----
        let showUpsell = ref(false);
        let upsellDismissed = ref(false);
        let upsell = reactive({ moreNeeded: 0, nextQty: 0, nextPrice: '0.00', savings: 0 });
        let modalImg = ref('');
        let modalColorLabel = ref('');
        let modalCustom1 = ref('');
        let modalCustom2 = ref('');
        let modalMonth = ref('');
        let modalYear = ref('');
        let editingCustom = ref(false);
        let hasSecondLine = ref(false);
        let customMax1 = ref(20);
        let customMax2 = ref(26);
        let monthMax = ref(3);
        let yearMax = ref(4);
        let qtySnapshot = {};
        let pendingProperties = null;
        let cartQty = ref(0);   // qty of THIS product already in the cart (discount is cart-wide)

        // On-page batch + what's already in the cart — the qty the discount engine actually sees.
        const combinedQty = () => totalQty.value + cartQty.value;

        // Read current cart and total the quantity for this product.
        const refreshCartQty = () => {
          return fetch('/cart.js')
            .then(r => r.json())
            .then(cart => {
              let q = 0;
              (cart.items || []).forEach(it => { if (it.handle === productHandle) q += it.quantity; });
              cartQty.value = q;
            })
            .catch(() => {});
        };

        // Discount tiers above qty 1, derived from the app-provided breaks. [{qty, price}]
        const milestoneTiers = () => {
          const qtys = discountQtys.value, amounts = discountAmounts.value;
          const out = [];
          for (let i = 0; i < qtys.length; i++) {
            if (qtys[i] <= 1) continue;
            out.push({ qty: qtys[i], price: (basePrice.value - amounts[i]).toFixed(2) });
          }
          return out;
        };

        // Next reachable tier above the current total quantity, or null if at the top.
        const getNextTier = () => {
          const qtys = discountQtys.value, amounts = discountAmounts.value;
          const q = combinedQty();
          for (let i = 0; i < qtys.length; i++) {
            if (q < qtys[i] && qtys[i] > 1) {
              return { qty: qtys[i], price: (basePrice.value - amounts[i]).toFixed(2), moreNeeded: qtys[i] - q };
            }
          }
          return null;
        };

        // Progress-bar fill % aligned to the evenly-spaced tier dots (not raw quantity).
        const milestoneFill = () => {
          const tiers = milestoneTiers();
          const n = tiers.length;
          if (!n) return 0;
          const q = combinedQty();
          const slot = 100 / n;            // each dot occupies one equal slot
          let reached = -1;
          for (let i = 0; i < n; i++) { if (q >= tiers[i].qty) reached = i; }
          if (reached === n - 1) return 100;
          // position of the last reached dot's centre (0 if none reached yet)
          const pos = reached >= 0 ? (reached + 0.5) * slot : 0;
          const nextPos = (reached + 1 + 0.5) * slot;
          const curQty = reached >= 0 ? tiers[reached].qty : 0;
          const nextQty = tiers[reached + 1].qty;
          const frac = Math.min(1, Math.max(0, (q - curQty) / (nextQty - curQty)));
          return Math.min(100, Math.max(0, pos + frac * (nextPos - pos)));
        };

        // Live headline that tracks the customer's current quantity / next tier.
        const upsellHeadline = () => {
          const nextTier = getNextTier();
          if (!nextTier) {
            return `You're getting our best price — $${indiPrice.value} each!`;
          }
          return `Add ${nextTier.moreNeeded} more & pay $${nextTier.price} each`;
        };

        // The savings amount, surfaced separately so it can be emphasised in the headline.
        const upsellSavings = () => {
          const nextTier = getNextTier();
          if (!nextTier) return '';
          const savings = Math.max(0, (parseFloat(indiPrice.value) - parseFloat(nextTier.price)) * nextTier.qty);
          return savings > 0 ? savings.toFixed(2) : '';
        };

        // Next tier (for the header subtext) — exposed for the template.
        const upsellNext = () => getNextTier();

        // Tier cards for the modal header, each tagged reached / current / future.
        const tierCards = () => {
          const tiers = milestoneTiers();
          const q = combinedQty();
          let currentIdx = -1;
          tiers.forEach((t, i) => { if (q >= t.qty) currentIdx = i; });
          return tiers.map((t, i) => ({
            qty: t.qty,
            price: t.price,
            state: i < currentIdx ? 'reached' : (i === currentIdx ? 'current' : 'future')
          }));
        };

        const load = async $state => {
            // Count this product's hats already in the cart (discount is cart-wide).
            refreshCartQty();

            // Fetch discount data from app proxy (send all product tags)
            if (productTags && productTags.length > 0) {
            fetch(`/apps/citylocs/discount-info?tags=${encodeURIComponent(JSON.stringify(productTags))}`)
              .then(res => res.json())
              .then(data => {
                console.log('App Proxy API Response:', data);
                if (data.discountBreak && data.discountAmount) {
                  // Add 1 at the start for single item (no discount)
                  discountQtys.value = [1, ...data.discountBreak.map(Number)];
                  discountAmounts.value = [0, ...data.discountAmount.map(Number)];
                  discountName.value = data.discountMessage || "";
                }
              })
              .catch(err => console.log('App Proxy Error:', err));
            }

            try {
              const productGet = await axios.get("{{ product.handle }}.js");

              productGet.data.variants.forEach((prodEl, idx) => {
                if( prodEl.inventory_management != "shopify" || 
                  (prodEl.inventory_management == "shopify" && prodEl.inventory_quantity > 0) ) {
                  variant.value.push(prodEl);
                }
              })

              const selectedVars = variant.value.filter(varEl => varEl.option1 == selected.value);
              options.value = [];
              options.value.push(...selectedVars);

              const queryString = window.location.search;
              const urlParams = new URLSearchParams(queryString);
              const itemId = urlParams.get('id');
              const editProduct = urlParams.get('editProduct');

              if(editProduct) {
                prevCartItem = true;
                checkProduct(itemId);
              } else {
                isLoading.value = false;
              }

            } catch (error) {
              console.log(error);
            }
        }

        const checkLoading = () => {
          if(!isLoading.value) {
            return "hide-div";
          }
        }

        const checkOptions = () => {
          if(isLoading.value) {
            return "hide-div";
          }
        }

        const selectionButton = (event) => {
            event.preventDefault();
            const clickedOption = event.currentTarget.dataset.value;
            selected.value = clickedOption;
        }

        const addQty = (optionId, inputVal) => {
          if(inputVal) {
            qtySelected[optionId] = inputVal;
            return;
          }

          let optionQty = 0;
          if(qtySelected[optionId]) {
            optionQty = qtySelected[optionId];
          }
          optionQty++;
          qtySelected[optionId] = optionQty;
        }

        const inputQty = (optionId, inputVal) => {
          qtySelected[optionId] = Number(inputVal);
        }

        const minQty = (optionId) => {
          if(qtySelected[optionId] > 0) {          
            let optionQty = 0;
            if(qtySelected[optionId]) {
              optionQty = qtySelected[optionId];
            } else {
            return;
          }
            optionQty = optionQty - 1;
            qtySelected[optionId] = optionQty;
          }
        }

        const handleQty = (prodID) => {
          if(qtySelected[prodID]) {
          return qtySelected[prodID];
        } else {
          return 0;
        }
        }

        const displayImg = (imgSrc) => {
          Fancybox.show([ {
            src: imgSrc,
            type: "image",
          } ]);
        }

        const toggleApproval = (add) => {
          if($('input[name="properties[Custom Text]"]').val().length < 1) {
            Fancybox.show([ {
              src: "<h2>Please enter your custom text, before adding to cart.</h2>",
              type: "html",
            } ]);
            return
          } else if(totalQty.value == 0) {
            Fancybox.show([ {
              src: "<h2>Please select a quantity.  No quantity has been selected.</h2>",
              type: "html",
            } ]);
            return
          } else if(add) {
          displayStyle.value = true;
          } else {
            displayStyle.value = false;
          }
        }

        const checkProduct = (itemId) => {
          const prodTitle = $(".product-title").text().trim();
          event.preventDefault();
          axios({
            method: 'GET',
            url: '/cart.js'
          })
          .then( (response) => {
            cartData = response.data;

            cartData.items.forEach(el => {
            if( el.product_title == prodTitle && el.id == itemId) {
              if(el.properties["Custom Text"]) {
                $("#user_input").val( el.properties["Custom Text"] );
              }
              addQty(el.id, el.quantity);
            }

          })
            isLoading.value = false;
          })
          .catch( (error) => {
            console.error('Error:', error);
          });
        }

        const displayApproval = (event) => {
            event.preventDefault();

            Fancybox.bind("[data-fancybox]", {
              // Your custom options
            });
        }

        const addToCart = (event) => {
          event.preventDefault();
          
          const base_url = window.location.origin;
          const cartUrl = base_url + '/cart';
          
          let custom1;
          let custom2;
          let custom3;
          
          if( $('input[name*="ustom Text Two"]').val() ) {
            custom2 = $('input[name*="ustom Text Two"]').val();
          } else if( $('#second_user_input').val() ) {
            custom2 = $('#second_user_input').val();
          }

          try{
            if($('input[name*="ustom Text Two"]').val().length < 1 && document.getElementById("2ndmandatory")) {
            Fancybox.show([ {
              src: '<h2>Please enter "Custom Text Two" before adding to cart.</h2>',
              type: "html",
            } ]);
            return
          }
          } catch{
            
          }


          if( $('input[name*="Custom Text Three"]').val() ) {
            custom3 = $('input[name*="Custom Text Three"]').val();
          }
  
          const custom1Input =  $('input[name="properties[Custom Text]"]').val();

          if( document.getElementById("engraved-hat-select") != null  
              && $('#engraved-hat-select').val() == "Select" ) { 
                Fancybox.show([ {
                  src: "<h2>Please select a state from the dropdown menu</h2>",
                  type: "html",
                } ]);
                return
          } 

          if ($('input[name="properties[Custom Text]"]').val())
            {
                custom1 = $('input[name="properties[Custom Text]"]').val();
            } else if ($('#user_input').val()) {
                custom1 = $('#user_input').val();
            }


          if($('input[name="properties[Custom Text]"]').val().length < 1) {
            Fancybox.show([ {
              src: "<h2>Please enter your custom text, before adding to cart.</h2>",
              type: "html",
            } ]);
            return
          };
          
          let properties;

          if(custom3) {
            properties = {
              'Custom Text': custom1.toUpperCase(),
              'Custom Text Two': custom2.toUpperCase(),
              'Custom Text Three': custom3.toUpperCase()
            }

          } else if(custom2) {
            properties = {
              'Custom Text': custom1.toUpperCase(),
              'Custom Text Two': custom2.toUpperCase()
            }
          } else {
            properties = {
              'Custom Text': custom1.toUpperCase()
            }
          }

          // check if any other fields are custom 
          // month
          if(  $('input[name="properties[Month]"]').val()) properties["Month"] = $('input[name="properties[Month]"]').val();
          // date
          if(  $('input[name="properties[Year]"]').val()) properties["Year"] = $('input[name="properties[Year]"]').val(); 


          // add state to object if engraved state plate
          if( document.getElementById("engraved-hat-select") != null ) {
            properties['state'] = $('#engraved-hat-select').val();
          }

          // ----- Upsell gate: offer the next tier before adding -----
          const nextTier = getNextTier();
          if (CL_MODAL_ENABLED && totalQty.value > 0 && !upsellDismissed.value && nextTier) {
            upsell.moreNeeded = nextTier.moreNeeded;
            upsell.nextQty = nextTier.qty;
            upsell.nextPrice = nextTier.price;
            const perHatSavings = (parseFloat(indiPrice.value) - parseFloat(nextTier.price));
            upsell.savings = Math.max(0, perHatSavings * nextTier.qty).toFixed(2);
            pendingProperties = properties;
            // Snapshot current selection so "No thanks" can revert any modal edits.
            qtySnapshot = {};
            Object.keys(qtySelected).forEach(k => { qtySnapshot[k] = qtySelected[k]; });
            if (options.value.length) setModalView(options.value[0]);
            modalCustom1.value = properties['Custom Text'] || '';
            modalCustom2.value = properties['Custom Text Two'] || '';
            modalMonth.value = properties['Month'] || '';
            modalYear.value = properties['Year'] || '';
            editingCustom.value = false;
            hasSecondLine.value = !!(document.querySelector('#second_user_input') || document.querySelector('input[name*="ustom Text Two"]'));
            // Pull real character limits off the page inputs so the modal enforces the same caps.
            const ml = (sel, fallback) => {
              const el = document.querySelector(sel);
              const v = el && el.getAttribute('maxlength');
              return v ? parseInt(v, 10) : fallback;
            };
            customMax1.value = ml('input[name="properties[Custom Text]"]', ml('#user_input', 20));
            customMax2.value = ml('#second_user_input', ml('input[name*="ustom Text Two"]', 26));
            monthMax.value = ml('input[name="properties[Month]"]', 3);
            yearMax.value = ml('input[name="properties[Year]"]', 4);
            showUpsell.value = true;
            return;
          }

          executeAdd(properties);
        }

        // Performs the actual cart add/update once the upsell has been resolved.
        // Clear the on-page configurator after a successful add so re-clicking ATC
        // can't duplicate the order, and let the upsell modal offer again for a new batch.
        const resetSelection = () => {
          Object.keys(qtySelected).forEach(k => { qtySelected[k] = 0; });
          upsellDismissed.value = false;
          prevCartItem = false;
          // The cart just changed — re-read it so the next batch is tier-aware.
          refreshCartQty();
        };

        const executeAdd = (properties) => {
          const base_url = window.location.origin;
          const cartUrl = base_url + '/cart';

          // Re-read custom text from the DOM (used by the edit-mode branch below).
          let custom1 = $('input[name="properties[Custom Text]"]').val() || $('#user_input').val();
          let custom2 = $('input[name*="ustom Text Two"]').val() || $('#second_user_input').val();

          if(totalQty.value > 0 && !prevCartItem) {
            let items = [];
            let url = '/cart/add.js';

            Object.keys(qtySelected).forEach(selected => {
              let currentItem = {
                id: selected,
                quantity: qtySelected[selected],
                properties: properties
              }

              items.push(currentItem);
            })

            axios({
              method: 'post',
              url: url,
              data: {
                items: items
              }
            })
            .then( (response) => {
              resetSelection();
              AMP_API.OPEN_CART();
              {% comment %} window.location.href = cartUrl; {% endcomment %}
            })
            .catch( (error) => {
              console.error('Error:', error);
            }); 
          } else if(totalQty.value > 0 && prevCartItem) {

            let updates = {};
            let items = [];

            Object.keys(qtySelected).forEach((selected, idx) => { 

              {% comment %} updates[selected] = qtySelected[selected]; {% endcomment %}
              let currentProduct = {
                quantity: qtySelected[selected]
              }
              // check for custom text
             if(custom1 && !custom2) {
                currentProduct['properties'] = {
                  "Custom Text": custom1
                }
              } else if(custom2) {
                currentProduct['properties'] = {
                  "Custom Text": custom1,
                  "Custom Text Two": custom2
                }
              }
  
                  let currentItem = {
                    id: selected,
                    quantity: qtySelected[selected],
                    properties: properties
                  }
              
                  items.push(currentItem);             
            }) 

            postShopifyAPI({ items });
          } else {
            // Nothing selected (e.g. just added a batch) — show their current cart.
            try { AMP_API.OPEN_CART(); } catch (e) {}
          }
        }

        // Distinct hat styles (option1) available for this product, for the modal switcher.
        const styleList = () => {
          const seen = [];
          variant.value.forEach(v => { if (v.option1 && !seen.includes(v.option1)) seen.push(v.option1); });
          return seen;
        };

        // Switch style inside the modal (reuses the existing `selected` watcher to refilter colors).
        const selectStyle = (style) => {
          selected.value = style;
          if (options.value.length) setModalView(options.value[0]);
        };

        // Update the modal gallery image (on color hover / qty change).
        const setModalImg = (src) => { if (src) modalImg.value = src; };

        // Set the gallery image AND the color-chip label from a color option.
        const setModalView = (option) => {
          if (!option) return;
          modalImg.value = option.featured_media.preview_image.src;
          modalColorLabel.value = ((option.option3 || '') + ' ' + (option.option2 || '')).trim();
        };

        // Toggle inline editing of the custom text.
        const toggleEditCustom = () => { editingCustom.value = !editingCustom.value; };
        const onEditCustom1 = (val) => { modalCustom1.value = val; };
        const onEditCustom2 = (val) => { modalCustom2.value = val; };
        const onEditMonth = (val) => { modalMonth.value = val; };
        const onEditYear = (val) => { modalYear.value = val; };

        // Mirror the modal's custom text/date back to the page inputs (keeps preview + cart in sync).
        const writeCustomToDOM = () => {
          const c1 = (modalCustom1.value || '').toUpperCase();
          const c2 = (modalCustom2.value || '').toUpperCase();
          const fire = (sel, v) => {
            const el = document.querySelector(sel);
            if (el) { el.value = v; el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true })); }
          };
          fire('input[name="properties[Custom Text]"]', c1);
          fire('#user_input', c1);
          if (hasSecondLine.value) { fire('#second_user_input', c2); fire('input[name*="ustom Text Two"]', c2); }
          fire('input[name="properties[Month]"]', modalMonth.value || '');
          fire('input[name="properties[Year]"]', modalYear.value || '');
        };

        // Accept: add everything currently configured and open the cart drawer.
        const acceptConfigurator = () => {
          // Sync any edited custom text into the cart payload + the page.
          writeCustomToDOM();
          if (pendingProperties) {
            pendingProperties['Custom Text'] = (modalCustom1.value || '').toUpperCase();
            if (hasSecondLine.value && modalCustom2.value) {
              pendingProperties['Custom Text Two'] = modalCustom2.value.toUpperCase();
            } else {
              delete pendingProperties['Custom Text Two'];
            }
            if (modalMonth.value) pendingProperties['Month'] = modalMonth.value;
            if (modalYear.value) pendingProperties['Year'] = modalYear.value;
          }
          upsellDismissed.value = true;
          showUpsell.value = false;
          if (pendingProperties) executeAdd(pendingProperties);
        };

        // Decline: revert any modal changes to what they had, then proceed.
        const declineUpsell = () => {
          upsellDismissed.value = true;
          showUpsell.value = false;
          Object.keys(qtySelected).forEach(k => { qtySelected[k] = 0; });
          Object.keys(qtySnapshot).forEach(k => { qtySelected[k] = qtySnapshot[k]; });
          if (pendingProperties) executeAdd(pendingProperties);
        };

        watch( selected, () => {
            const updatedOptions = variant.value.filter(varEl => varEl.option1 == selected.value);
            options.value = [];
            options.value.push(...updatedOptions);
        })

        // Cart-aware pricing: the tier is decided by (this batch + what's already in the cart),
        // and the on-page batch is priced at that combined-tier rate (matches the cart engine).
        const recalc = () => {
          const qtys = discountQtys.value;
          const amounts = discountAmounts.value;
          if (!qtys.length) return;

          let buildQty = 0;
          Object.keys(qtySelected).forEach(s => { buildQty += qtySelected[s]; });
          totalQty.value = buildQty;

          const combined = buildQty + cartQty.value;

          let idxPrice = 0;
          for (let i = 0; i < qtys.length; i++) {
            if (combined == qtys[i]) { idxPrice = i; break; }
            else if (combined < qtys[i]) { idxPrice = i - 1; break; }
            else { idxPrice = qtys.length - 1; }
          }
          idxPrice = Math.max(0, idxPrice);

          const perHat = basePrice.value - amounts[idxPrice];
          const totalProdCost = buildQty * perHat;
          subTotal.value = totalProdCost.toFixed(2);
          indiPrice.value = (buildQty > 0 ? perHat : 0).toFixed(2);

          if (idxPrice === qtys.length - 1) {
            const maxDiscount = amounts[amounts.length - 1];
            messageDiscount.value = `YOU SAVED $${maxDiscount} PER ${discountName.value.toUpperCase() || 'ITEM'}!`;
            return;
          }
          const toNext = qtys[idxPrice + 1] - combined;
          const nextPrice = (basePrice.value - amounts[idxPrice + 1]).toFixed(2);
          messageDiscount.value = `ORDER ${toNext} MORE AND GET THEM AT ${nextPrice} EACH`;
        };

        watch( qtySelected, recalc );
        watch( cartQty, recalc );
        watch( discountQtys, recalc );

        function postShopifyAPI(data) {
          let updates = {
          }
          data.items.forEach(el => {
            updates[el.id] = 0; 
          })
          // remove all quantites before we update
            axios({
                method: 'post',
                url: '/cart/update.js',
                data: {
                  updates: updates
                }
              })
              .then(response => {
                // add after removing
                  axios({
                    method: 'post',
                    url: '/cart/add.js',
                    data: data
                  })
                  .then(response => {
                    resetSelection();
                    AMP_API.OPEN_CART();
                    {% comment %} window.location.href = "https://citylocs.com/cart"; {% endcomment %}
                  })
                  .catch( (error) => {
                    console.error('Error:', error);
                  })

              })
              .catch( (error) => {
                console.error('Error:', error);
              });
        }
        
        onBeforeMount(load);

        return {
          selected,
          comments,
          page,
          variant,
          options,
          items,
          selectionButton,
          addQty,
          minQty,
          inputQty,
          handleQty,
          addToCart,
          totalQty,
          subTotal,
          indiPrice,
          messageDiscount,
          checkLoading,
          checkOptions,
          displayImg,
          displayStyle,
          toggleApproval,
          milestoneTiers,
          milestoneFill,
          combinedQty,
          cartQty,
          upsellHeadline,
          upsellSavings,
          upsellNext,
          tierCards,
          modalColorLabel,
          setModalView,
          showUpsell,
          upsell,
          modalImg,
          modalCustom1,
          modalCustom2,
          modalMonth,
          modalYear,
          editingCustom,
          hasSecondLine,
          customMax1,
          customMax2,
          monthMax,
          yearMax,
          toggleEditCustom,
          onEditCustom1,
          onEditCustom2,
          onEditMonth,
          onEditYear,
          styleList,
          selectStyle,
          setModalImg,
          acceptConfigurator,
          declineUpsell
        };
      },
      methods: {
        setProdImg(optionImg) {
          return optionImg;
        }
      }
    })
    productForm.mount('#add-to-cart-form')
  }
</script>

