{%- comment -%}
  Collection Design Bundle — GemPages storefront block.

  Add to a GemPages Custom Code element with:
    {% render 'cl-collection-design-bundle' %}

  Product configuration:
    custom.bundle_mode = collection_design
    custom.bundle_design_collection = one collection reference
    custom.bundle_components = list.variant_reference
    custom.bundle_component_multiplier = integer (1 for 3-pack, 2 for 6-pack)
{%- endcomment -%}

{%- assign cdb_mode = product.metafields.custom.bundle_mode.value | default: product.metafields.custom.bundle_mode -%}
{%- assign cdb_collection = product.metafields.custom.bundle_design_collection.value -%}
{%- assign cdb_components = product.metafields.custom.bundle_components.value -%}
{%- assign cdb_multiplier = product.metafields.custom.bundle_component_multiplier.value | default: 1 | plus: 0 -%}
{%- if cdb_multiplier < 1 -%}{%- assign cdb_multiplier = 1 -%}{%- endif -%}
{%- assign cdb_hat_count = cdb_components.size | times: cdb_multiplier -%}

{{ 'cl-collection-design-bundle.css' | asset_url | stylesheet_tag }}

{%- if cdb_mode != 'collection_design' -%}
  <div class="cl-cdb__notice">This product is not configured as a collection design bundle.</div>
{%- elsif cdb_collection == blank or cdb_components == blank -%}
  <div class="cl-cdb__notice">Bundle configuration is incomplete.</div>
{%- else -%}
  <div class="cl-cdb">
    <div class="cl-cdb__layout">
      <div class="cl-cdb__main">
        {% render 'cl-collection-design-bundle-designs', cdb_embedded: true %}
        {% render 'cl-collection-design-bundle-personalization', cdb_embedded: true %}
      </div>
      {% render 'cl-collection-design-bundle-summary', cdb_embedded: true, cdb_include_preview: true %}
    </div>
  </div>

  <script src="{{ 'cl-collection-design-bundle.js' | asset_url }}" defer></script>
{%- endif -%}
