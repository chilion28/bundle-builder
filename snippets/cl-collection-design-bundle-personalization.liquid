<section class="{% unless cdb_embedded %}cl-cdb cl-cdb-component {% if show_heading == false %}cl-cdb-component--headerless {% endif %}{% endunless %}cl-cdb__panel"
         data-cl-cdb-product="{{ product.id }}"
         data-cl-cdb-fields-panel
         hidden
         {% if show_heading == false %}aria-label="Add your custom text"{% else %}aria-labelledby="cl-cdb-fields-heading-{{ product.id }}"{% endif %}>
  {%- unless show_heading == false -%}
    <div class="cl-cdb__step">2</div>
  {%- endunless -%}
  <div class="cl-cdb__panel-body">
    {%- unless show_heading == false -%}
      <h2 id="cl-cdb-fields-heading-{{ product.id }}">Add your custom text</h2>
      <p>Enter the personalization exactly as you want it submitted.</p>
    {%- endunless -%}
    <div class="cl-cdb__fields" data-cl-cdb-fields></div>
  </div>
</section>
