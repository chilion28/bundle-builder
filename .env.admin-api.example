# Copy this file to .env.admin-api and fill in one authentication method.
# The real .env.admin-api file is ignored by Git.

SHOPIFY_STORE=citylocs.myshopify.com

# Recommended for an app owned by the same Shopify organization as the store.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Alternative for an existing app that already provides an Admin API token.
# SHOPIFY_ADMIN_ACCESS_TOKEN=

