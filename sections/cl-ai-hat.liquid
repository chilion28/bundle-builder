{%- comment -%}
  Create Your AI Hat — guided 4-step customizer (native section).
  Structure mirrors [[fixed-bundle-cart-transform]]:
    · This section = branded shell (hero, Step 1 prompt, inspiration, badges).
    · The interactive builder (Steps 2–4: upload, options, quality check, ATC)
      lives in the reusable snippet `cl-ai-hat-builder` so it can also be dropped
      into a GemPages custom-code block.
    · Styling  → assets/cl-ai-hat.css
    · Behaviour → assets/cl-ai-hat.js  (Cloudinary config block at top of file)
{%- endcomment -%}

{{ 'cl-ai-hat.css' | asset_url | stylesheet_tag }}

{%- assign price_display = product.price | default: 3499 -%}
{%- assign accent = section.settings.accent_color | default: '#00a0ea' -%}

{%- comment -%}
  Typography roles → selectors. Each role only emits CSS when its
  "<role>_enable" checkbox is on, so the default design is untouched.
  Settings ids follow: <role>_size / _ls / _lh / _tt / _ta / _color / _mb / _pad
  (and the same with a _m suffix for mobile).
{%- endcomment -%}
{%- capture cl_ai_role_map -%}
h1~.cl-ai__hero-title
tag~.cl-ai__hero-tagline
sub~.cl-ai__hero-sub
h2~.cl-ai__step-title, .cl-ai .cl-ai__inspo-head h2
body~.cl-ai-b__label, .cl-ai .cl-ai__prompt-hint, .cl-ai .cl-ai__inspo-label
{%- endcapture -%}
{%- assign cl_ai_roles = cl_ai_role_map | strip | newline_to_br | strip_newlines | split: '<br />' -%}

{%- comment -%} NOTE: Liquid does NOT allow filters inside [] — each key must be
  assigned to a variable first, otherwise the lookup silently returns nil. {%- endcomment -%}
<style>
{%- for line in cl_ai_roles -%}
  {%- assign parts = line | strip | split: '~' -%}
  {%- assign p = parts[0] -%}
  {%- assign sel = parts[1] -%}
  {%- assign k_on = p | append: '_enable' -%}
  {%- if section.settings[k_on] -%}
    {%- assign k_fon = p | append: '_font_enable' -%}
    {%- assign k_font = p | append: '_font' -%}
    {%- assign k_size = p | append: '_size' -%}
    {%- assign k_ls = p | append: '_ls' -%}
    {%- assign k_lh = p | append: '_lh' -%}
    {%- assign k_tt = p | append: '_tt' -%}
    {%- assign k_ta = p | append: '_ta' -%}
    {%- assign k_col = p | append: '_color' -%}
    {%- assign k_mb = p | append: '_mb' -%}
    {%- assign k_pad = p | append: '_pad' -%}
    {%- assign use_font = section.settings[k_fon] -%}
    {%- assign fnt = section.settings[k_font] -%}
    {%- if use_font and fnt %}{{ fnt | font_face: font_display: 'swap' }}{% endif -%}
    .cl-ai {{ sel }}{
      {%- if use_font and fnt %}font-family:{{ fnt.family }},{{ fnt.fallback_families }};{% endif -%}
      font-size:{{ section.settings[k_size] }}px;
      letter-spacing:{{ section.settings[k_ls] | divided_by: 10.0 }}px;
      line-height:{{ section.settings[k_lh] | divided_by: 100.0 }};
      text-transform:{{ section.settings[k_tt] }};
      text-align:{{ section.settings[k_ta] }};
      color:{{ section.settings[k_col] }};
      margin-bottom:{{ section.settings[k_mb] }}px;
      padding:{{ section.settings[k_pad] }}px;
    }
  {%- endif -%}
{%- endfor -%}
@media (max-width:749px){
{%- for line in cl_ai_roles -%}
  {%- assign parts = line | strip | split: '~' -%}
  {%- assign p = parts[0] -%}
  {%- assign sel = parts[1] -%}
  {%- assign k_on = p | append: '_enable' -%}
  {%- if section.settings[k_on] -%}
    {%- assign k_size = p | append: '_size_m' -%}
    {%- assign k_ls = p | append: '_ls_m' -%}
    {%- assign k_lh = p | append: '_lh_m' -%}
    {%- assign k_tt = p | append: '_tt_m' -%}
    {%- assign k_ta = p | append: '_ta_m' -%}
    {%- assign k_col = p | append: '_color_m' -%}
    {%- assign k_mb = p | append: '_mb_m' -%}
    {%- assign k_pad = p | append: '_pad_m' -%}
    .cl-ai {{ sel }}{
      font-size:{{ section.settings[k_size] }}px;
      letter-spacing:{{ section.settings[k_ls] | divided_by: 10.0 }}px;
      line-height:{{ section.settings[k_lh] | divided_by: 100.0 }};
      text-transform:{{ section.settings[k_tt] }};
      text-align:{{ section.settings[k_ta] }};
      color:{{ section.settings[k_col] }};
      margin-bottom:{{ section.settings[k_mb] }}px;
      padding:{{ section.settings[k_pad] }}px;
    }
  {%- endif -%}
{%- endfor -%}
}
</style>

<section class="cl-ai" data-cl-ai-hat data-product-id="{{ product.id }}"
  style="--green:{{ accent }};--green-dk:color-mix(in srgb, {{ accent }}, #000 14%);">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <div class="cl-ai__hero">
    <div class="cl-ai__hero-copy">
      {%- if section.settings.hero_badge != blank -%}
        <span class="cl-ai__hero-badge">{{ section.settings.hero_badge }}</span>
      {%- endif -%}
      <h1 class="cl-ai__hero-title">
        {{ section.settings.hero_title | default: 'CREATE YOUR' }}
        <span class="cl-ai__hero-accent">{{ section.settings.hero_accent | default: 'AI HAT' }}</span>
      </h1>
      <p class="cl-ai__hero-tagline">{{ section.settings.hero_tagline | default: 'Turn your imagination into wearable art.' }}</p>
      <p class="cl-ai__hero-sub">{{ section.settings.hero_sub | default: "Generate your artwork in ChatGPT in minutes—then we'll professionally print it on a premium patch." }}</p>

      <div class="cl-ai__hero-reviews">
        <span class="cl-ai__stars" aria-hidden="true">★★★★★</span>
        <span>{{ section.settings.reviews_text | default: '2,500+ Verified Reviews' }}</span>
      </div>

      <ul class="cl-ai__hero-usps" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'usp' -%}
            <li {{ block.shopify_attributes }}>
              <span class="cl-ai__usp-icon">{{ block.settings.icon | default: '✔' }}</span>
              <strong>{{ block.settings.title }}</strong>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="cl-ai__hero-media">
      {%- if product.images.size > 0 -%}
        <div class="cl-ai__gallery" data-cl-ai-gallery>
          <img class="cl-ai__gallery-main" data-cl-ai-gallery-main
               src="{{ product.featured_image | image_url: width: 900 }}"
               alt="{{ product.title | escape }}" width="900" height="900">
          {%- if product.images.size > 1 -%}
            <ul class="cl-ai__gallery-thumbs" role="list">
              {%- for img in product.images limit: 5 -%}
                <li>
                  <button type="button" class="cl-ai__thumb{% if forloop.first %} is-active{% endif %}"
                          data-cl-ai-thumb data-full="{{ img | image_url: width: 900 }}"
                          aria-label="View image {{ forloop.index }}">
                    <img src="{{ img | image_url: width: 160 }}" alt="" width="160" height="160" loading="lazy">
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="cl-ai__gallery cl-ai__gallery--placeholder" data-cl-ai-gallery>
          <div class="cl-ai__gallery-main cl-ai__gallery-main--empty" data-cl-ai-gallery-main>
            Hat preview
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---------- STEPS 1–4 — interactive builder (owns the 2-col layout) ---------- {%- endcomment -%}
  {% render 'cl-ai-hat-builder',
     cta_label: section.settings.cta_label,
     price_display: price_display,
     step1_title: section.settings.step1_title,
     prompt_text: section.settings.prompt_text,
     prompt_hint: section.settings.prompt_hint,
     prompt_example: section.settings.prompt_example,
     upload_title: section.settings.upload_title,
     upload_note: section.settings.upload_note,
     qc_title: section.settings.qc_title,
     preview_title: section.settings.preview_title,
     customize_title: section.settings.customize_title %}

  {%- comment -%} ---------- INSPIRATION GALLERY ---------- {%- endcomment -%}
  {%- assign has_gallery = false -%}
  {%- for block in section.blocks -%}{%- if block.type == 'inspiration' -%}{%- assign has_gallery = true -%}{%- endif -%}{%- endfor -%}
  {%- if has_gallery -%}
    <div class="cl-ai__inspo">
      <div class="cl-ai__inspo-head">
        <h2>{{ section.settings.inspo_title | default: 'AI ART INSPIRATION' }}</h2>
        {%- if section.settings.gallery_url != blank -%}
          <a href="{{ section.settings.gallery_url }}" class="cl-ai__inspo-link">VIEW ALL GALLERY →</a>
        {%- endif -%}
      </div>
      <ul class="cl-ai__inspo-grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'inspiration' -%}
            <li {{ block.shopify_attributes }}>
              {%- comment -%} Fixed-ratio wrapper so the thumb stays landscape
                regardless of the theme's global img rules. {%- endcomment -%}
              <div class="cl-ai__inspo-media">
                {%- if block.settings.image -%}
                  <img src="{{ block.settings.image | image_url: width: 480 }}"
                       alt="{{ block.settings.label | escape }}" loading="lazy">
                {%- else -%}
                  <span class="cl-ai__inspo-empty">{{ block.settings.label }}</span>
                {%- endif -%}
              </div>
              <span class="cl-ai__inspo-label">{{ block.settings.label }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- FOOTER VALUE PROPS ---------- {%- endcomment -%}
  <ul class="cl-ai__valueprops" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'valueprop' -%}
        <li {{ block.shopify_attributes }}>
          <span class="cl-ai__vp-icon" aria-hidden="true">{{ block.settings.icon | default: '◈' }}</span>
          <div>
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.text }}</span>
          </div>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

</section>

