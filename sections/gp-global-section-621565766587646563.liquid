    <style>
  .cl-view-more-btn {
    position: relative;
  }

  .cl-view-more-btn.is-loading {
    pointer-events: none;
    opacity: 0.75;
  }

  .cl-view-more-btn.is-loading .button-text,
  .cl-view-more-btn.is-loading span {
    visibility: hidden;
  }

  .cl-view-more-btn.is-loading::after {
    content: "";

    width: 18px;
    height: 18px;

    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;

    position: absolute;
    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);

    animation: clSpin 0.7s linear infinite;
  }

  @keyframes clSpin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
</style>
<script>
document.addEventListener('DOMContentLoaded', async function () {
  const grid = document.querySelector('[items-repeat="true"][data-id="gRCALrkf0q"]');
  const button = document.querySelector('.cl-view-more-btn');

  if (!grid || !button) return;

  const collectionHandle = 'us-metal-plates-copy';

  let allProducts = [];
  let visibleCount = 8;
  const perLoad = 8;

  // Fetch ALL products from Shopify
  async function fetchProducts() {
    try {
      const response = await fetch(
        `/collections/${collectionHandle}/products.json?limit=250`
      );

      const data = await response.json();

      allProducts = data.products || [];

      // SORT A-Z
      allProducts.sort((a, b) =>
        a.title.localeCompare(b.title)
      );

      renderProducts();

    } catch (err) {
      console.error('Failed loading products:', err);
    }
  }

  // Render products
  function renderProducts() {

    const productsToShow = allProducts.slice(0, visibleCount);

    grid.innerHTML = '';

    productsToShow.forEach(product => {

      const image =
        product.images?.[0]?.src ||
        '';

      const price =
        parseFloat(product.variants?.[0]?.price || 0);

      const card = `
        <a href="/products/${product.handle}" class="cl-product-card">

          <div class="cl-product-card__image">
            <img
              src="${image}"
              alt="${product.title}"
              loading="lazy"
            >
          </div>

          <div class="cl-product-card__content">
            <h3>${product.title}</h3>
            <p>$${price.toFixed(2)}</p>
          </div>

        </a>
      `;

      grid.insertAdjacentHTML('beforeend', card);

    });

    // Hide button if all products loaded
    if (visibleCount >= allProducts.length) {
      button.style.display = 'none';
    }
  }

  // View more click
  button.addEventListener('click', function () {

    visibleCount += perLoad;

    renderProducts();

  });

  fetchProducts();

});
</script>
