  }

  .cl-summary-row strong {
    font-size: 15px;
  }

  .cl-summary-row:last-child {
    border-bottom: 0;
  }

  .cl-savings-row strong {
    color: #d71920;
  }

  .cl-subtotal-row {
    margin-top: 4px;
