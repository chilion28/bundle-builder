<style>
  .cl-builder {
    --cl-border: #dedede;
    --cl-soft-bg: #f7f7f7;
    --cl-summary-bg: #eaf1f4;
    --cl-dark: #151515;
    --cl-muted: #666;
    --cl-radius: 16px;

    font-family: inherit;
    margin-top: 0;
  }

  .cl-step-title {
    font-size: 20px;
    line-height: 1.2;
    font-weight: 800;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }

  .cl-style-list {
    border: 1px solid var(--cl-border);
    border-radius: var(--cl-radius);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    background: #fff;
    overflow: hidden;
    padding-top: 0.75em;
  }

  .cl-style-item {
    background: #fff;
    border-bottom: 1px solid var(--cl-border);
  }

  .cl-style-item:last-child {
    border-bottom: 0;
  }

  .cl-style-card {
    width: 100%;
    min-height: 92px;
    border: 0;
    background: transparent;
    padding: 12px 16px !important;
    display: grid;
    grid-template-columns: 68px 1fr 32px;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    text-align: left;
    transition: background .2s ease;
  }

  .cl-style-card:hover {
    background: #ebebeb;
  }

  .cl-style-card img {
    width: 68px;
    height: 68px;
    object-fit: contain;
    border: 1px solid #e2e2e2;
    border-radius: 12px;
    background: #fff;
  }

  .cl-style-name {
    font-size: 19px;
    line-height: 1.15;
    font-weight: 800;
    color: var(--cl-dark);
    letter-spacing: -0.01em;
  }

  .cl-style-count,
  .cl-style-selected-count {
    display: block;
    font-size: 13px;
    line-height: 1.35;
  }

  .cl-style-count {
    color: var(--cl-muted);
    margin-top: 3px;
  }

  .cl-style-selected-count {
    color: var(--cl-dark);
    font-weight: 800;
    margin-top: 2px;
  }

  .cl-style-arrow {
    font-family: 'Inter';
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #f2f2f2;
    font-size: 24px;
    line-height: 0 !important;
    transition: transform .2s ease;
    padding-bottom: 2px;
    padding-left: 2px;
  }

  .cl-style-item.is-open .cl-style-arrow {
    transform: rotate(90deg);
  }

  .cl-style-item .cl-inline-panel {
    display: none !important;
  }

  .cl-style-item.is-open .cl-inline-panel {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    padding: 14px;
    background: var(--cl-soft-bg);
  }

  .cl-color-row {
    display: flex !important;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 230px;
    padding: 18px 14px !important;
    border: 1px solid #ddd;
    border-radius: 16px;
    background: #fff;
  }

  .cl-color-row img {
    width: 86px;
    height: 86px;
    object-fit: contain;
    margin-bottom: 12px;
    border-radius: 10px;
    background: #fff;
  }

  .cl-color-title {
    font-size: 16px;
    line-height: 1.2;
    font-weight: 800;
    color: var(--cl-dark);
  }

  .cl-color-price {
    font-size: 13px;
    color: var(--cl-muted);
    margin-top: 4px;
    margin-bottom: 12px;
  }

  .cl-qty {
    display: flex;
    height: 36px;
    border: 1px solid #cfcfcf;
    border-radius: 999px;
    overflow: hidden;
    background: #fff;
  }

  .cl-qty button {
    width: 36px;
    height: 36px;
    border: 0;
    background: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .cl-qty input {
    width: 42px;
    height: 36px;
    border: 0;
    border-left: 1px solid #cfcfcf;
    border-right: 1px solid #cfcfcf;
    text-align: center;
    font-size: 16px;
    font-weight: 800;
    background: #fff;
  }

  .cl-summary-card {
    margin-top: 16px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
  }

  .cl-summary-toggle {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 16px 18px !important;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    text-align: left;
    font-size: 17px;
  }

  .cl-summary-toggle strong,
  #cl-summary-mini {
    font-weight: 900;
  }

  .cl-summary-toggle > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .cl-summary-arrow {
    display: block;
    width: 20px;
    height: 20px;
    padding: 6px;
    line-height: 0;
    /* border: 1px solid; */
