    font-family: 'Inter';
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 300;
    color: #151515;
    letter-spacing: .01em;
    text-transform: none;
   
  }

  .cl-progress {
    width: 100%;
    height: 9px;
    background: #f5f5f5;
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 14px;
  }

  .cl-progress span {
    display: block;
    height: 100%;
    width: 0%;
    background: #00a0ea;
    border-radius: 99px;
    transition: width .2s ease;
  }

  .cl-progress-meta {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-top: -6px;
    margin-bottom: 12px;
    color: #4d6668;
  }

  .cl-summary-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(0,0,0,.12);
