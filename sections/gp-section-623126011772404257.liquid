<script>
(function () {
  const product = window.CL_PRODUCT;
  if (!product || !product.variants) return;

  const money = cents => '$' + (cents / 100).toFixed(2);
  const qtyMap = {};

  const styleList = document.getElementById('cl-style-list');

  
  const summaryMini = document.getElementById('cl-summary-mini');
  const discountMessage = document.getElementById('cl-discount-message');
  const progressBar = document.getElementById('cl-progress-bar');
  const totalQtyEl = document.getElementById('cl-total-qty');
  const unitPriceEl = document.getElementById('cl-unit-price');
  const totalSavingsEl = document.getElementById('cl-total-savings');
  const subtotalEl = document.getElementById('cl-subtotal');
  const selectionList = document.getElementById('cl-selection-list');

  const sheet = document.getElementById('cl-mobile-sheet');
  const sheetBackdrop = document.getElementById('cl-mobile-backdrop');
  const sheetTitle = document.getElementById('cl-sheet-title');
  const sheetSubtitle = document.getElementById('cl-sheet-subtitle');
  const sheetBody = document.getElementById('cl-sheet-body');
  const sheetTotal = document.getElementById('cl-sheet-total');
  const sheetPrice = document.getElementById('cl-sheet-price');

  const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
  
  const summaryCard = document.getElementById('cl-summary-card');
  const summaryToggle = document.getElementById('cl-summary-toggle');
  const progressCurrent = document.getElementById('cl-progress-current');
  const progressTarget = document.getElementById('cl-progress-target');
  
  const customSummary1 = document.getElementById('cl-summary-custom-1');
  const customSummary2 = document.getElementById('cl-summary-custom-2');
  
  const addToCartBtn = document.getElementById('cl-add-to-cart');
  const builderError = document.getElementById('cl-builder-error');
  
  const confirmBackdrop = document.getElementById('cl-confirm-backdrop');
  const confirmModal = document.getElementById('cl-confirm-modal');
  const confirmCustom1 = document.getElementById('cl-confirm-custom-1');
  const confirmCustom2 = document.getElementById('cl-confirm-custom-2');
  const confirmWarning = document.getElementById('cl-confirm-warning');
  const confirmEdit = document.getElementById('cl-confirm-edit');
  const confirmAdd = document.getElementById('cl-confirm-add');
  
  //const cartContextCount = document.getElementById('cl-cart-context-count');
  const currentContextCount = document.getElementById('cl-current-context-count');

  let cartItemCount = 0;
  let qualifyingHatCount = 0;

  let lastAddedPersonalizationKey = '';
  let pendingAddToCartItems = null;

  function getStyle(variant) {
    return variant.option1 || 'Default';
  }

  function getColor(variant) {
    return variant.option2 || variant.title.replace(getStyle(variant) + ' / ', '');
  }

  function getImage(variant) {
    if (variant.featured_image && variant.featured_image.src) return variant.featured_image.src;
    if (variant.featured_media && variant.featured_media.preview_image) return variant.featured_media.preview_image.src;
    return product.featured_image || '';
  }

  function groupedStyles() {
    return product.variants.reduce((acc, variant) => {
      const style = getStyle(variant);
      if (!acc[style]) acc[style] = [];
      acc[style].push(variant);
      return acc;
    }, {});
  }

  function totalQty() {
    return Object.values(qtyMap).reduce((sum, qty) => sum + qty, 0);
  }

  function subtotal() {
    return product.variants.reduce((sum, variant) => {
      return sum + ((qtyMap[variant.id] || 0) * variant.price);
    }, 0);
  }

  let discountQtys = [1];
let discountAmounts = [0];
let discountName = "ITEM";



function getDiscountIndex(qty) {
  let idx = 0;

  for (let i = 0; i < discountQtys.length; i++) {
    if (qty >= discountQtys[i]) {
      idx = i;
    }
  }

  return idx;
}

function getPricing() {
  const qty = totalQty();
  const baseUnit = product.price / 100;
  const originalTotal = qty * baseUnit;

  if (qty === 0) {
    return {
      qty,
      unitPrice: 0,
      subtotal: 0,
      savings: 0,
      discountPerItem: 0,
      nextQty: discountQtys[1] || null
    };
  }

  const idx = getDiscountIndex(qty);
  const discountPerItem = qty > 1 ? (discountAmounts[idx] || 0) : 0;
  const unitPrice = Math.max(baseUnit - discountPerItem, 0);
  const subtotal = qty * unitPrice;
  const savings = originalTotal - subtotal;

  return {
    qty,
    unitPrice,
    subtotal,
    savings,
    discountPerItem,
    idx,
    nextQty: discountQtys[idx + 1] || null,
    nextDiscountAmount: discountAmounts[idx + 1] || null
  };
}

function updateDiscountMessage(pricing) {
  const currentQty = pricing.qty;
  const existingQty = qualifyingHatCount || 0;
  const combinedQty = existingQty + currentQty;

  if (existingQty > 0) {
    discountMessage.textContent =
      'Your existing hats and current selection combine toward volume discounts.';

    progressCurrent.textContent = 'Current progress';
    progressTarget.textContent = 'Next discount tier';

    const combinedPricing = getPricingForQty(combinedQty);

    if (!combinedPricing.nextQty) {
      progressBar.style.width = '100%';
      return;
    }

    const progress = combinedPricing.nextQty > 0
  ? (combinedQty / combinedPricing.nextQty) * 100
  : 100;

    progressBar.style.width = Math.max(0, Math.min(progress, 100)) + '%';
    return;
  }

  if (currentQty === 0) {
    discountMessage.textContent = 'Order more than 1 hat for discounted pricing.';
    progressBar.style.width = '0%';
    progressCurrent.textContent = '0 selected';
    progressTarget.textContent = 'Next discount';
    return;
  }

  if (!pricing.nextQty) {
    discountMessage.textContent = `✓ Best volume pricing unlocked at ${money(pricing.unitPrice * 100)} each.`;
    progressBar.style.width = '100%';
    progressCurrent.textContent = `${currentQty} selected`;
    progressTarget.textContent = 'Best price unlocked';
    return;
  }

  const remaining = pricing.nextQty - currentQty;
  const nextUnit = (product.price / 100) - pricing.nextDiscountAmount;

  discountMessage.textContent =
    `Add ${remaining} more hat${remaining === 1 ? '' : 's'} to unlock ${money(nextUnit * 100)} pricing.`;

  progressCurrent.textContent = `${currentQty} selected`;
  progressTarget.textContent = `${pricing.nextQty} needed`;

  const progress = pricing.nextQty > 0
  ? (currentQty / pricing.nextQty) * 100
  : 100;

  progressBar.style.width = Math.max(0, Math.min(progress, 100)) + '%';
}

function selectedQtyForStyle(style) {
  return product.variants.reduce((sum, variant) => {
    if (getStyle(variant) !== style) return sum;
    return sum + (qtyMap[variant.id] || 0);
  }, 0);
}

function getStylePriceHtml() {
  const pricing = getPricing();
  const basePrice = product.price / 100;

  if (pricing.qty > 1 && pricing.unitPrice < basePrice) {
    return `<span class="cl-style-price"><del>${money(product.price)}</del> ${money(pricing.unitPrice * 100)}</span>`;
  }

  return `<span class="cl-style-price">${money(product.price)}</span>`;
}

function updateStyleSelectedCounts() {
  document.querySelectorAll('[data-style-count]').forEach(el => {
    const style = el.dataset.styleCount;

    const styleQty = product.variants.reduce((sum, variant) => {
      if (getStyle(variant) !== style) return sum;
      return sum + (qtyMap[variant.id] || 0);
    }, 0);

    const pricing = getPricing();
    const styleSubtotal = styleQty * pricing.unitPrice;

    el.textContent = styleQty > 0
      ? `${styleQty} selected • ${money(styleSubtotal * 100)}`
      : '0 selected';
  });
}

function getPersonalizationValues() {
  const custom1 =
    document.querySelector('[name="properties[Custom Text]"]') ||
    document.querySelector('input[placeholder="A"]');

  const custom2 =
    document.querySelector('[name="properties[Custom Text Two]"]') ||
    document.querySelector('input[placeholder="CUSTOM"]');

  return {
    custom1: custom1 ? custom1.value.trim() : '',
    custom2: custom2 ? custom2.value.trim() : ''
  };
}

function updatePersonalizationSummary() {
  const values = getPersonalizationValues();

  customSummary1.textContent = values.custom1 || '—';
  customSummary2.textContent = values.custom2 || '—';
}

function renderSelectionSummary() {

  const selected = product.variants.filter(
    variant => (qtyMap[variant.id] || 0) > 0
  );

  if (!selected.length) {
    selectionList.innerHTML = '';
    return;
  }

  selectionList.innerHTML = `
    <div class="cl-selection-header">
  <div class="cl-selection-title">
    Your Selection
  </div>

  <button
    type="button"
    class="cl-clear-all"
    id="cl-clear-all"
  >
    Clear All
  </button>
</div>

    ${selected.map(variant => `
      <div class="cl-selection-row">
        <span>${getStyle(variant)} ${getColor(variant)}</span>
        <strong>×${qtyMap[variant.id]}</strong>
      </div>
    `).join('')}
  `;
}

function getPricingForQty(qty) {
  const baseUnit = product.price / 100;

  if (qty <= 0) {
    return {
      qty,
      unitPrice: 0,
      discountPerItem: 0,
      idx: 0,
      nextQty: discountQtys[1] || null
    };
  }

  let idx = 0;

  for (let i = 0; i < discountQtys.length; i++) {
    if (qty >= discountQtys[i]) idx = i;
  }

  const discountPerItem = qty > 1 ? (discountAmounts[idx] || 0) : 0;
  const unitPrice = Math.max(baseUnit - discountPerItem, 0);

  return {
    qty,
    unitPrice,
    discountPerItem,
    idx,
    nextQty: discountQtys[idx + 1] || null,
    nextDiscountAmount: discountAmounts[idx + 1] || null
  };
}

function updateFinalTierNote() {
  const note = document.getElementById('cl-final-tier-note');
  if (!note) return;

  const currentQty = totalQty();
  const existingQty = qualifyingHatCount || 0;
  const combinedQty = existingQty + currentQty;

  if (!existingQty) {
    note.innerHTML = '';
    note.classList.remove('is-visible');
    return;
  }

  const combinedPricing = getPricingForQty(combinedQty);

  let nextMessage = '';

  if (combinedPricing.nextQty) {
    const remaining = combinedPricing.nextQty - combinedQty;
    const nextUnit = (product.price / 100) - combinedPricing.nextDiscountAmount;

    nextMessage = `
      <div class="cl-final-next">
        Add ${remaining} more hat${remaining === 1 ? '' : 's'} to unlock ${money(nextUnit * 100)} pricing.
      </div>
    `;
  } else {
    nextMessage = `
      <div class="cl-final-next">
        ✓ Best volume pricing unlocked.
      </div>
    `;
  }

  note.classList.add('is-visible');

  note.innerHTML = `
    <strong>Hat Discount Status</strong>

    <div class="cl-final-total-main">
      ${combinedQty} qualifying hat${combinedQty === 1 ? '' : 's'} • ${money(combinedPricing.unitPrice * 100)} each
    </div>

    <div class="cl-final-total-breakdown">
      <span>Existing hats: ${existingQty}</span>
      <span>Current selection: ${currentQty}</span>
    </div>

    ${nextMessage}
  `;
}

function updateSummary() {
  const pricing = getPricing();
  const qtyLabel = `${pricing.qty} Hat${pricing.qty === 1 ? '' : 's'}`;
  
  if (currentContextCount) {
  currentContextCount.textContent = qtyLabel.toLowerCase();
}

  summaryMini.textContent = `${qtyLabel} • ${money(pricing.subtotal * 100)}`;
  totalQtyEl.textContent = qtyLabel;
  unitPriceEl.textContent = `${money(pricing.unitPrice * 100)} each`;
  totalSavingsEl.textContent = money(pricing.savings * 100);
  subtotalEl.textContent = money(pricing.subtotal * 100);

  sheetTotal.textContent = qtyLabel;
  sheetPrice.textContent = `${money(pricing.subtotal * 100)} subtotal`;
  
  renderSelectionSummary();
  updateFinalTierNote();
  updateDiscountMessage(pricing);
  updateStyleSelectedCounts();
  
  document.querySelectorAll('[data-style-price]').forEach(el => {
  el.innerHTML = getStylePriceHtml();
});

  updatePersonalizationSummary();
  
  addToCartBtn.disabled = pricing.qty === 0;

  document.querySelectorAll('.cl-color-row').forEach(row => {
    const id = row.dataset.variantId;
    const input = row.querySelector('input');
    if (input) input.value = qtyMap[id] || 0;
  });
}

function updateHeaderCartCount(cart) {
  cartItemCount = cart.item_count || 0;

  qualifyingHatCount = (cart.items || []).reduce((sum, item) => {
  return item.product_id === product.id ? sum + item.quantity : sum;
}, 0);

  document.querySelectorAll('[data-header-cart-count]').forEach(el => {
    const count = cart.item_count > 0 ? cart.item_count : '';
    el.setAttribute('data-header-cart-count', count);
    el.classList.toggle('visible', cart.item_count > 0);
  });

  updateSummary();
}

function syncBuilderFromCart() {
  fetch('/cart.js')
    .then(r => r.json())
    .then(cart => {
      product.variants.forEach(variant => {
        qtyMap[variant.id] = 0;
      });

      cart.items.forEach(item => {
        const variantId = String(item.variant_id || item.id);
        const isThisProduct = item.product_id === product.id;

        if (isThisProduct) {
          qtyMap[variantId] = (qtyMap[variantId] || 0) + item.quantity;
        }
      });

      updateHeaderCartCount(cart);
      updateSummary();
      renderStyles();
      updateSummary();
    
    });
}

  function colorRowsMarkup(variants) {
    return variants.map(variant => {
      const img = getImage(variant);
      const color = getColor(variant);
      const qty = qtyMap[variant.id] || 0;

      return `
        <div class="cl-color-row ${qty > 0 ? 'is-selected' : ''}" data-variant-id="${variant.id}">
          <img src="${img}" alt="${color}">
          <div>
            <div class="cl-color-title">${color}</div>
            <span class="cl-selected-badge">✓ Selected</span>
            <div class="cl-color-price">${money(variant.price)} each</div>
          </div>
          <div class="cl-qty">
            <button type="button" data-action="minus">−</button>
            <input type="text" value="${qty}" readonly>
            <button type="button" data-action="plus">+</button>
          </div>
        </div>
      `;
    }).join('');
  }
  
  
  function getSelectedItems() {
  const personalization = getPersonalizationValues();
  const batchKey = Date.now().toString();

  return product.variants
    .filter(variant => (qtyMap[variant.id] || 0) > 0)
    .map(variant => ({
      id: variant.id,
      quantity: qtyMap[variant.id],
      properties: {
        'Custom Text': personalization.custom1,
        'Custom Text Two': personalization.custom2,
        '_Personalization Batch': batchKey
      }
    }));
}

function validateBuilder() {
  const personalization = getPersonalizationValues();

  if (!personalization.custom1) {
    return 'Please enter your custom initial.';
  }

  if (!personalization.custom2) {
    return 'Please enter your custom text.';
  }

  if (totalQty() < 1) {
    return 'Please select at least 1 hat.';
  }

  return '';
}

function openCartDrawerFallback() {
  const triggers = [
    '[data-cart-mini-toggle]',
    '[data-header-cart-trigger]',
    '[data-cart-drawer-trigger]',
    '[data-cart-toggle]',
    '.site-header-cart--button',
    '.site-header-cart a',
    'a[href="/cart"]'
  ];

  if (window.AMP_API && typeof window.AMP_API.OPEN_CART === 'function') {
    window.AMP_API.OPEN_CART();
    return true;
  }

  for (const selector of triggers) {
    const trigger = document.querySelector(selector);

    if (trigger) {
      trigger.click();
      return true;
    }
  }

  return false;
}

function showMobileCartSuccess() {
  let toast = document.getElementById('cl-cart-success-toast');

  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'cl-cart-success-toast';
    toast.innerHTML = `
      <strong>Added to cart</strong>
      <button type="button">View Cart</button>
    `;
    document.body.appendChild(toast);

    toast.querySelector('button').addEventListener('click', function () {
      window.location.href = '/cart';
    });
  }

  toast.classList.add('is-visible');

  setTimeout(() => {
    toast.classList.remove('is-visible');
  }, 5000);
}

function refreshCartSections() {
  fetch('/cart.js')
    .then(r => r.json())
    .then(cart => {

      updateHeaderCartCount(cart);

      document.dispatchEvent(
        new CustomEvent('cart:refresh', { detail: { cart } })
      );

      document.dispatchEvent(
        new CustomEvent('cart:updated', { detail: { cart } })
      );

      document.dispatchEvent(
        new CustomEvent('ajaxCart:refresh', { detail: { cart } })
      );
    });
}

function resetBuilderSelections() {
  Object.keys(qtyMap).forEach(id => {
    qtyMap[id] = 0;
  });

  document.querySelectorAll('.cl-color-row').forEach(row => {
    row.classList.remove('is-selected');

    const input = row.querySelector('input');
    if (input) input.value = 0;
  });

  updateSummary();
}

  function renderStyles() {
    const styles = groupedStyles();

    styleList.innerHTML = Object.keys(styles).map(style => {
      const variants = styles[style];
      const firstVariant = variants[0];
      const img = getImage(firstVariant);
      const count = variants.length;

      return `
        <div class="cl-style-item" data-style="${style}">
          <button type="button" class="cl-style-card">
            <img src="${img}" alt="${style}" data-style-thumb="${style}">
            <span>
              <span class="cl-style-name">${style}</span>
              <span class="cl-style-count">
  ${count} color${count === 1 ? '' : 's'} available • <span data-style-price>${money(product.price)}</span>
</span>
              <span class="cl-style-selected-count" data-style-count="${style}">0 selected</span>
            </span>
            <span class="cl-style-arrow"> ›</span>
          </button>
          <div class="cl-inline-panel">
            ${colorRowsMarkup(variants)}
          </div>
        </div>
      `;
    }).join('');
  }
  
  

  let clScrollY = 0;

function openMobileSheet(style) {
  const styles = groupedStyles();
  const variants = styles[style] || [];

  sheetTitle.textContent = style;
  sheetSubtitle.textContent = `${variants.length} color${variants.length === 1 ? '' : 's'} available`;
  sheetBody.innerHTML = colorRowsMarkup(variants);

  clScrollY = window.scrollY || document.documentElement.scrollTop;

  document.body.classList.add('cl-sheet-open');
  document.body.style.top = `-${clScrollY}px`;

  sheet.classList.add('is-open');
  sheetBackdrop.classList.add('is-open');

  updateSummary();
}

function closeMobileSheet() {
  sheet.classList.remove('is-open');
  sheetBackdrop.classList.remove('is-open');

  document.body.classList.remove('cl-sheet-open');
  document.body.style.top = '';

  window.scrollTo(0, clScrollY);
}

function syncMainImageToVariant(variantId) {
  const variant = product.variants.find(v => String(v.id) === String(variantId));
  if (!variant) return;

  const imgSrc = getImage(variant);
  if (!imgSrc) return;

  const carousel =
    document.querySelector('gp-carousel-v3[type="gp-feature-image-carousel"]') ||
    document.querySelector('gp-carousel-v3[class*="gp-feature-image-carousel"]');

  if (!carousel) return;

  const visibleImg =
    carousel.querySelector('.swiper-slide-active img.featured-image-only') ||
    carousel.querySelector('img.featured-image-only');

  if (!visibleImg) return;

  visibleImg.src = imgSrc;
  visibleImg.setAttribute('src', imgSrc);
  visibleImg.removeAttribute('srcset');
  visibleImg.removeAttribute('data-src');
  visibleImg.removeAttribute('data-srcset');
}

function updateStyleThumbnail(style, variantId) {
  const variant = product.variants.find(v => String(v.id) === String(variantId));
  if (!variant) return;

  const thumb = document.querySelector(`[data-style-thumb="${style}"]`);
  if (!thumb) return;

  thumb.src = getImage(variant);
}

  function handleQtyClick(e) {
    const btn = e.target.closest('button[data-action]');
    if (!btn) return;
    
    e.preventDefault();
    e.stopPropagation();

    const row = btn.closest('.cl-color-row');
    const id = row.dataset.variantId;

    let qty = qtyMap[id] || 0;

    if (btn.dataset.action === 'plus') qty += 1;
    if (btn.dataset.action === 'minus') qty = Math.max(0, qty - 1);

    qtyMap[id] = qty;
    
    syncMainImageToVariant(id);
    
    const variant = product.variants.find(v => String(v.id) === String(id));
    if (variant) updateStyleThumbnail(getStyle(variant), id);

    row.classList.toggle('is-selected', qty > 0);
    
    const input = row.querySelector('input');
    if (input) input.value = qty;
    
    updateSummary();
  }

  styleList.addEventListener('click', function(e) {

  if (
    e.target.closest('.cl-qty') ||
    e.target.closest('.cl-color-row')
  ) {
    return;
  }

  const card = e.target.closest('.cl-style-card');
  if (!card) return;

  const item = card.closest('.cl-style-item');

  item.classList.toggle('is-open');
});

  styleList.addEventListener('click', handleQtyClick);
  sheetBody.addEventListener('click', handleQtyClick);

  document.getElementById('cl-sheet-close').addEventListener('click', closeMobileSheet);
  document.getElementById('cl-sheet-done').addEventListener('click', closeMobileSheet);
  sheetBackdrop.addEventListener('click', closeMobileSheet);

  window.addEventListener('resize', function() {
    if (!isMobile()) closeMobileSheet();
  });
  
  summaryToggle.addEventListener('click', function () {
  summaryCard.classList.toggle('is-collapsed');
  });
  
  document.addEventListener('input', function(e) {
  if (
    e.target.matches('[name="properties[Custom Text]"]') ||
    e.target.matches('[name="properties[Custom Text Two]"]') ||
    e.target.matches('input[placeholder="A"]') ||
    e.target.matches('input[placeholder="CUSTOM"]')
  ) {
    updateSummary();
  }
});

function getPersonalizationKey() {
  const p = getPersonalizationValues();
  return `${p.custom1}|||${p.custom2}`;
}

function openConfirmModal(items) {
  const p = getPersonalizationValues();
  const currentKey = getPersonalizationKey();

  pendingAddToCartItems = items;

  confirmCustom1.textContent = p.custom1;
  confirmCustom2.textContent = p.custom2;

  if (lastAddedPersonalizationKey && lastAddedPersonalizationKey === currentKey) {
    confirmWarning.textContent = 'Heads up: this is the same personalization used in your previous add-to-cart batch.';
    confirmWarning.classList.add('is-visible');
  } else {
    confirmWarning.textContent = '';
    confirmWarning.classList.remove('is-visible');
  }

  confirmBackdrop.classList.add('is-open');
  confirmModal.classList.add('is-open');
}

function closeConfirmModal() {
  confirmBackdrop.classList.remove('is-open');
  confirmModal.classList.remove('is-open');
}

function submitAddToCart(items) {
  addToCartBtn.classList.add('is-loading');
  addToCartBtn.textContent = 'Adding...';

  fetch('/cart/add.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({ items })
  })
    .then(res => {
      if (!res.ok) return res.json().then(err => Promise.reject(err));
      return res.json();
    })
    .then(() => {
      lastAddedPersonalizationKey = getPersonalizationKey();
      pendingAddToCartItems = null;
    
      refreshCartSections();
      resetBuilderSelections();
        
        setTimeout(function () {
          const opened = openCartDrawerFallback();
        
          if (isMobile() || !opened) {
            showMobileCartSuccess();
          }
        }, 350);
        
        setTimeout(syncHeaderCountFromShopifyCart, 900);
    })
    .catch(err => {
      console.log('CityLocs Builder Add To Cart Error:', err);
      builderError.textContent = 'Something went wrong adding this to cart. Please try again.';
    })
    .finally(() => {
      addToCartBtn.classList.remove('is-loading');
      addToCartBtn.textContent = 'Add to Cart';
    });
}

confirmEdit.addEventListener('click', function () {
  closeConfirmModal();

  const section =
    document.getElementById('gOENTmFFLs');

  const customTextField =
    document.querySelector('[name="properties[Custom Text]"]') ||
    document.querySelector('input[placeholder="A"]');

  if (section) {
    section.scrollIntoView({
      behavior: 'smooth',
      block: 'start'
    });
  }

  setTimeout(() => {
    if (customTextField) customTextField.focus();
  }, 500);
});

confirmBackdrop.addEventListener('click', function () {
  closeConfirmModal();
});

confirmAdd.addEventListener('click', function () {
  if (!pendingAddToCartItems) return;

  closeConfirmModal();
  submitAddToCart(pendingAddToCartItems);
});

addToCartBtn.addEventListener('click', function () {
  builderError.textContent = '';

  const error = validateBuilder();

  if (error) {
    builderError.textContent = error;
    return;
  }

  openConfirmModal(getSelectedItems());
});
  
function syncHeaderCountFromDrawerTitle() {
  const drawerText = document.body.innerText.match(/Cart\s+(\d+)/i);
  if (!drawerText) return;

  const count = Number(drawerText[1]);

  document.querySelectorAll('[data-header-cart-count]').forEach(el => {
    const value = count > 0 ? String(count) : '';
    el.setAttribute('data-header-cart-count', value);
    el.textContent = '';
    el.classList.toggle('visible', count > 0);
  });
}

function syncHeaderCountFromShopifyCart() {
  fetch('/cart.js')
    .then(r => r.json())
    .then(cart => {
      updateHeaderCartCount(cart);
      updateSummary();
    })
    .catch(err => console.warn('Cart count sync failed:', err));
}

document.addEventListener('click', function(e) {
  const img = e.target.closest('.cl-color-row img');
  if (!img) return;

  // Do not trigger when clicking qty controls
  if (e.target.closest('.cl-qty')) return;

  e.preventDefault();
  e.stopPropagation();

  const fullImg = img.getAttribute('src');

  if (window.Fancybox && fullImg) {
  Fancybox.show(
    [
      {
        src: fullImg,
        type: 'image'
      }
    ],
    {
      Images: {
        zoom: false
      },
      dragToClose: true,

      on: {
        done: function () {

          const closeOnImageClick = function(e) {
            e.preventDefault();
            e.stopPropagation();

            if (window.Fancybox) {
              Fancybox.close();
            }
          };

          document
            .querySelectorAll('.fancybox__image, .fancybox__content img')
            .forEach(function(img) {

              img.removeEventListener('click', closeOnImageClick);

              img.addEventListener(
                'click',
                closeOnImageClick,
                true
              );
            });
        }
      }
    }
  );
}
});

document.addEventListener('click', function(e) {
  if (!e.target.closest('#cl-clear-all')) return;

  if (!confirm('Remove all selected hats?')) return;

  resetBuilderSelections();
});

document.addEventListener('click', function(e) {
  if (
    e.target.closest('.amp-cart__items, .amp-cart-drawer, .cart-drawer, [data-cart-drawer], .cart-sidebar, .ajax-cart')
  ) {
    setTimeout(syncHeaderCountFromShopifyCart, 500);
    setTimeout(syncHeaderCountFromShopifyCart, 1200);
    setTimeout(syncHeaderCountFromShopifyCart, 2200);
  }
});
  
  renderStyles();
  updateSummary();
  syncHeaderCountFromShopifyCart();
  
  fetch(`/apps/citylocs/discount-info?tags=${encodeURIComponent(JSON.stringify(product.tags || []))}`)
  .then(res => res.json())
  .then(data => {
    console.log('CityLocs Discount Response:', data);

    if (data.discountBreak && data.discountAmount) {
      discountQtys = [1, ...data.discountBreak.map(Number)];
      discountAmounts = [0, ...data.discountAmount.map(Number)];
      discountName = (data.discountMessage || 'ITEM').toUpperCase();
    }

    updateSummary();
  })
  .catch(err => {
    console.log('CityLocs Discount Error:', err);
    updateSummary();
  });

  
})();
