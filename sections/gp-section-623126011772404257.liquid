    transition: transform .2s ease;
  }

  .cl-summary-card.is-collapsed .cl-summary-arrow {
    transform: rotate(-90deg);
  }

  .cl-summary-content {
    display: block;
    padding: 16px 18px 18px !important;
    border-top: 1px solid #cad7dc;
  }

  .cl-summary-card.is-collapsed .cl-summary-content {
    display: none;
  }

  .cl-summary-content h3 {
