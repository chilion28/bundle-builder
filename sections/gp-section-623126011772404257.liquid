    font-size: 21px;
  }

  .cl-personalization-summary {
    margin-top: 16px;
    padding: 12px;
    background: rgba(255,255,255,.45);
    border-radius: 12px;
    font-size: 14px;
  }
  
  .cl-personalization-summary span {
      text-transform: uppercase;
  }

  .cl-personalization-summary strong {
    display: block;
    margin-bottom: 6px;
    font-size: 15px;
  }

  .cl-add-to-cart {
    width: 100%;
    min-height: 56px;
    margin-top: 14px !important;
    padding: 18px 22px !important;
    border: 0;
    border-radius: 0;
    background: #00a0ea !important;
    color: #fff !important;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: .01em;
    cursor: pointer;
    transition: opacity .2s ease, transform .2s ease;
  }

  .cl-add-to-cart:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .cl-add-to-cart:disabled,
  .cl-add-to-cart.is-loading {
    opacity: .45;
    cursor: not-allowed;
    pointer-events: none;
  }

