  ];

  const wrap = document.querySelector('.state-search-wrap');
  const box = document.querySelector('.state-search-box');
  const input = document.getElementById('stateSearch');
  const list = document.getElementById('stateList');
  const arrow = box.querySelector('.state-arrow');

  let activeIndex = 0;

  function escapeRegExp(text) {
    return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function highlightMatch(name, query) {
    if (!query) return name;

    const regex = new RegExp(`(${escapeRegExp(query)})`, 'ig');
    return name.replace(regex, '<mark>$1</mark>');
  }

  function renderStates(filter = '') {
    const filtered = states.filter(state =>
      state.name.toLowerCase().includes(filter.toLowerCase())
    );

    list.innerHTML = filtered.length
      ? filtered.map((state, index) =>
          `<li class="${index === 0 ? 'is-highlighted' : ''}" data-url="${state.url}">${highlightMatch(state.name, filter)}</li>`
        ).join('')
      : `<li class="state-empty">No states found</li>`;

    activeIndex = 0;
    list.classList.add('is-open');
  }

  function openList() {
    wrap.classList.add('is-active');
    renderStates(input.value);
    list.classList.add('is-open');
  }

  function closeList() {
    wrap.classList.remove('is-active');
    list.classList.remove('is-open');
  }

  function toggleList() {
    if (list.classList.contains('is-open')) {
      closeList();
    } else {
      openList();
    }
  }

  function selectItem(item) {
    if (!item || item.classList.contains('state-empty')) return;

    input.value = item.textContent;
    closeList();
    window.location.href = item.dataset.url;
  }

  box.addEventListener('click', function (e) {
    if (e.target === input || e.target === arrow) return;

    input.focus();

    if (!list.classList.contains('is-open')) {
      openList();
    }
  });

  arrow.addEventListener('click', function (e) {
    e.stopPropagation();
    input.focus();
    toggleList();
  });

  input.addEventListener('focus', openList);

  input.addEventListener('input', function () {
    openList();
  });

  input.addEventListener('keydown', function (e) {
    const items = list.querySelectorAll('li:not(.state-empty)');
    if (!items.length) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, items.length - 1);
    }

    if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
    }

    if (e.key === 'Enter') {
      e.preventDefault();
      selectItem(items[activeIndex]);
      return;
    }

    items.forEach(item => item.classList.remove('is-highlighted'));

    if (items[activeIndex]) {
      items[activeIndex].classList.add('is-highlighted');
      items[activeIndex].scrollIntoView({
        block: 'nearest'
      });
    }
  });

  list.addEventListener('click', function (e) {
    const item = e.target.closest('li');
    selectItem(item);
  });

  document.addEventListener('click', function (e) {
    if (!wrap.contains(e.target)) {
      closeList();
    }
  });
});
