<script>
(function () {
  const CL = {
    selectors: {
      form: 'form[action*="/cart/add"]',
      productData: 'gp-product-images-v3[gp-data]',
      styleSelect: 'select[option-data="Style"]',
      sizeSelect: 'select[option-data="Size"]',
      colorSwatch: '[option-data="Color"][option-value]',
      colorLabel: '[option-name="Color"] legend.variant-display span',
      productButton: 'gp-product-button'
    },

    styleMeta: {
      'Snapback': {
        desc: 'Flat brim, classic fit',
        badge: '★ Most Popular',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/Snapback_liner.svg?v=1777580563'
      },
      'Trucker': {
        desc: 'Mesh back, breathable',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/trucker_lineart.svg?v=1778615583'
      },
      'Pro Five A Frame': {
        desc: 'Higher crown, structured',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/a-frame-lineart.svg?v=1779899012'
      },
      'Flex Fit': {
        desc: 'Stretch fit, one size',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/Flexfit.svg?v=1778615663'
      },
      'Signature Series': {
        desc: 'Premium specialty styles',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/Snapback_liner.svg?v=1777580563'
      }
    },

    displayColor(color) {
      return String(color || '').replace(/\s*FF$/i, '').trim();
    },

    getVariants() {
      const el = document.querySelector(CL.selectors.productData);
      if (!el) return [];

      try {
        return JSON.parse(el.getAttribute('gp-data'))?.product?.variants || [];
      } catch (e) {
        console.warn('[CL] Could not parse product variants', e);
        return [];
      }
    },

    getVariantImage(variant) {
      let src =
        variant?.featured_image?.src ||
        variant?.featured_media?.preview_image?.src ||
        variant?.image?.src ||
        '';

      if (!src) return '';
      if (src.startsWith('//')) src = 'https:' + src;

      return src;
    },

    updateVariantInputs(variantId) {
      document.querySelectorAll(CL.selectors.form).forEach(function (form) {
        const input = form.querySelector('input[name="id"]');
        if (!input) return;

        input.value = variantId;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    },

    updateProductButton(variantId) {
      document.querySelectorAll(CL.selectors.productButton).forEach(function (wrap) {
        wrap.setAttribute('variant-id', String(variantId));

        const buttons = wrap.querySelectorAll('button, [role="button"], .button-primary');

        buttons.forEach(function (button) {
          button.disabled = false;
          button.removeAttribute('disabled');
          button.removeAttribute('aria-disabled');
          button.classList.remove('disabled', 'is-disabled', 'sold-out', 'out-of-stock');

          if (/out of stock|sold out|unavailable/i.test(button.textContent)) {
            button.textContent = 'Add to cart';
          }
        });
      });
    },

    updateUrl(variantId) {
      const url = new URL(window.location.href);
      url.searchParams.set('variant', variantId);
      window.history.replaceState({}, '', url.toString());
    },

    updateColorLabel(color) {
      const label = document.querySelector(CL.selectors.colorLabel);
      if (label) label.textContent = CL.displayColor(color);
    },

    buildGallery() {
      const oldGallery =
        document.querySelector('gp-product-images-v3[data-id="gNHe7PZ2o4"]') ||
        document.querySelector('gp-product-images-v3') ||
        document.querySelector('.gckYyx4CKX');

      if (!oldGallery || document.querySelector('.cl-custom-product-gallery')) return;

      const gallery = document.createElement('div');
      gallery.className = 'cl-custom-product-gallery';
      gallery.innerHTML = '<img class="cl-custom-product-gallery__img" alt="">';

      oldGallery.insertAdjacentElement('beforebegin', gallery);
      oldGallery.style.display = 'none';
    },

    updateGallery(variant) {
      const src = CL.getVariantImage(variant);
      const img = document.querySelector('.cl-custom-product-gallery__img');

      if (!src || !img) return;

      img.src = src;
      img.srcset = src;
    }
  };

  let isApplying = false;

  function ready(callback) {
    let attempts = 0;

    const timer = setInterval(function () {
      attempts++;

      const form = document.querySelector(CL.selectors.form);
      const productData = document.querySelector(CL.selectors.productData);
      const styleSelect = document.querySelector(CL.selectors.styleSelect);

      if (form && productData && styleSelect) {
        clearInterval(timer);
        callback();
      }

      if (attempts > 80) clearInterval(timer);
    }, 250);
  }

  function findFirstVariantForStyle(style) {
  const variants = CL.getVariants().filter(function (variant) {
    return variant.option1 === style;
  });

  if (!variants.length) return null;

  return (
    variants.find(function (variant) {
      return variant.available === true;
    }) ||
    variants.find(function (variant) {
      return variant.id && variant.option2 && variant.option3;
    }) ||
    variants[0]
  );
}

  function findVariant(style, size, color) {
    return CL.getVariants().find(function (variant) {
      return (
        variant.option1 === style &&
        (!size || variant.option2 === size) &&
        String(variant.option3 || '').trim() === String(color || '').trim()
      );
    }) || CL.getVariants().find(function (variant) {
      return (
        variant.option1 === style &&
        (!size || variant.option2 === size) &&
        CL.displayColor(variant.option3) === CL.displayColor(color)
      );
    });
  }

  function updateStyleCards(style) {
    document.querySelectorAll('.cl-style-card').forEach(function (card) {
      card.classList.toggle('is-active', card.dataset.styleValue === style);
    });
  }

  function updateSizeSelect(variant) {
    const sizeSelect = document.querySelector(CL.selectors.sizeSelect);
    if (!sizeSelect || !variant.option2) return;

    [...sizeSelect.options].forEach(function (option) {
      option.selected = option.value === variant.option2;
    });

    sizeSelect.value = variant.option2;
    sizeSelect.dispatchEvent(new Event('input', { bubbles: true }));
  }

  function updateColorOptions(variant) {
    const style = variant.option1;
    const size = variant.option2;

    const colorsForStyle = CL.getVariants()
      .filter(function (v) {
        return (
          v.option1 === style &&
          (!size || v.option2 === size)
        );
      })
      .map(function (v) {
        return CL.displayColor(v.option3);
      });

    document.querySelectorAll(CL.selectors.colorSwatch).forEach(function (colorEl) {
      const swatchColor = CL.displayColor(colorEl.getAttribute('option-value'));
      const label = colorEl.closest('label.option-item') || colorEl.closest('label');
      const show = colorsForStyle.includes(swatchColor);

      colorEl.disabled = !show;
      colorEl.toggleAttribute('data-disabled', !show);
      colorEl.setAttribute('data-gp-option-available', show ? 'true' : 'false');

      if (label) {
        label.style.display = show ? '' : 'none';
        label.classList.toggle('cl-color-hidden', !show);
        label.classList.remove('selected', 'active', 'is-active');
        label.setAttribute('aria-checked', 'false');
      }

      colorEl.checked = false;
      colorEl.removeAttribute('checked');
    });
  }

  function selectColor(color) {
    const exactColor = String(color || '').trim();
    const displayColor = CL.displayColor(color);

    const colorEl = [...document.querySelectorAll(CL.selectors.colorSwatch)].find(function (el) {
      return String(el.getAttribute('option-value') || '').trim() === exactColor;
    }) || [...document.querySelectorAll(CL.selectors.colorSwatch)].find(function (el) {
      return CL.displayColor(el.getAttribute('option-value')) === displayColor;
    });

    if (!colorEl) return;

    const label = colorEl.closest('label.option-item') || colorEl.closest('label');

    colorEl.disabled = false;
    colorEl.removeAttribute('disabled');
    colorEl.removeAttribute('data-disabled');
    colorEl.setAttribute('data-gp-option-available', 'true');
    colorEl.checked = true;
    colorEl.setAttribute('checked', 'checked');

    if (label) {
      label.style.display = '';
      label.classList.add('selected', 'active', 'is-active');
      label.setAttribute('aria-checked', 'true');
    }

    colorEl.dispatchEvent(new Event('input', { bubbles: true }));
    colorEl.dispatchEvent(new Event('change', { bubbles: true }));
  }

  function applyVariant(variant) {
    if (!variant || isApplying) return;

    isApplying = true;

    const styleSelect = document.querySelector(CL.selectors.styleSelect);

    if (styleSelect) {
      styleSelect.value = variant.option1;
    }

    const finalVariant =
  findVariant(variant.option1, variant.option2, variant.option3) ||
  findFirstVariantForStyle(variant.option1) ||
  variant;

updateSizeSelect(finalVariant);
updateColorOptions(finalVariant);
selectColor(finalVariant.option3);

    CL.updateVariantInputs(finalVariant.id);
CL.updateProductButton(finalVariant.id);
CL.updateUrl(finalVariant.id);
CL.updateColorLabel(finalVariant.option3);
CL.updateGallery(finalVariant);
updateStyleCards(finalVariant.option1);

    setTimeout(function () {
  CL.updateVariantInputs(finalVariant.id);
  CL.updateProductButton(finalVariant.id);
}, 150);

    setTimeout(function () {
      isApplying = false;
    }, 250);
  }

  function buildStyleCards() {
    const styleSelect = document.querySelector(CL.selectors.styleSelect);
    if (!styleSelect) return;

    const styleBlock =
      styleSelect.closest('[option-name="Style"]') ||
      styleSelect.parentElement;

    if (!styleBlock) return;

    document.querySelectorAll('.cl-style-slider-wrap').forEach(function (el) {
      el.remove();
    });

    styleBlock.classList.add('cl-hide-original-style');

    const wrapper = document.createElement('div');
    wrapper.className = 'cl-style-slider-wrap';

    wrapper.innerHTML = `
      <h3 class="cl-style-slider-title">Choose Your Hat Style</h3>
      <div class="cl-style-slider"></div>
    `;

    const slider = wrapper.querySelector('.cl-style-slider');

    [...styleSelect.options].forEach(function (option) {
      if (!option.value) return;

      const value = option.value;
      const meta = CL.styleMeta[value] || {};

      const card = document.createElement('button');
      card.type = 'button';
      card.className = 'cl-style-card';
      card.dataset.styleValue = value;

      card.innerHTML = `
        ${meta.badge ? `<div class="cl-style-card__badge">${meta.badge}</div>` : ''}
        ${meta.img ? `<img class="cl-style-card__image" src="${meta.img}" alt="${value}">` : ''}
        <div class="cl-style-card__title">${value}</div>
        <div class="cl-style-card__desc">${meta.desc || ''}</div>
      `;

      card.addEventListener('click', function () {
        const variant = findFirstVariantForStyle(value);
        applyVariant(variant);
      });

      slider.appendChild(card);
    });

    styleBlock.insertAdjacentElement('beforebegin', wrapper);
  }

  function bindColorClicks() {
    document.addEventListener('click', function (event) {
      const swatch = event.target.closest(CL.selectors.colorSwatch);
      if (!swatch || isApplying) return;

      setTimeout(function () {
        const styleSelect = document.querySelector(CL.selectors.styleSelect);
        const sizeSelect = document.querySelector(CL.selectors.sizeSelect);

        if (!styleSelect) return;

        const variant = findVariant(
          styleSelect.value,
          sizeSelect ? sizeSelect.value : null,
          swatch.getAttribute('option-value')
        );

        if (variant) applyVariant(variant);
      }, 80);
    }, true);
  }

  ready(function () {
    CL.buildGallery();
    buildStyleCards();
    bindColorClicks();

    const styleSelect = document.querySelector(CL.selectors.styleSelect);

    const urlVariantId = new URLSearchParams(window.location.search).get('variant');

    const initialVariant =
      CL.getVariants().find(function (v) {
        return String(v.id) === String(urlVariantId);
      }) ||
      findFirstVariantForStyle(styleSelect.value);

    applyVariant(initialVariant);
  });
})();
</script>

<script>
(function () {
  function buildStyleCardsOnly() {
    const styleSelect = document.querySelector('select[option-data="Style"]');
    if (!styleSelect) return;

    const styleBlock =
      styleSelect.closest('[option-name="Style"]') ||
      styleSelect.parentElement;

    if (!styleBlock) return;

    document.querySelectorAll('.cl-style-slider-wrap').forEach(el => el.remove());

    styleBlock.classList.add('cl-hide-original-style');

    const styleMeta = {
      'Snapback': {
        desc: 'Flat brim, classic fit',
        badge: '★ Most Popular',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/Snapback_liner.svg?v=1777580563'
      },
      'Trucker': {
        desc: 'Mesh back, breathable',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/trucker_lineart.svg?v=1778615583'
      },
      'Pro Five A Frame': {
