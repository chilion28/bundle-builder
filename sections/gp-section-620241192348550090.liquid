    <div
      
      style="--d:block;--d-tablet:block;--d-mobile:block;--bs:none;--bw:1px 1px 1px 1px;--bc:var(--g-c-line-3, line-3);--bblr:0px;--bbrr:0px;--btlr:0px;--btrr:0px;--op:100%;--ta:left;--bgc:transparent;--bgi:url();--bgp:50% 50%;--bgs:cover;--bgr:no-repeat;--bga:scroll"
      data-keep-class="true"
      class="gbFJryXoJ2 gp-custom-code">
      <div>
    <script>
(function () {
  if (window.__clAmpUpsellPersonalizationV2) return;
  window.__clAmpUpsellPersonalizationV2 = true;

  function getPersonalization() {
    const t1 = document.querySelector('[name*="Custom Text"]:not([name*="Two"])');
    const t2 = document.querySelector('[name*="Custom Text Two"]');

    return {
      "Custom Text": t1?.value?.trim() || "",
      "Custom Text Two": t2?.value?.trim() || ""
    };
  }

  function gidToVariantId(gid) {
    return String(gid || '').split('/').pop();
  }

  function showAmpToast(message) {
    let toast = document.querySelector('.cl-amp-toast');

    if (!toast) {
      toast = document.createElement('div');
      toast.className = 'cl-amp-toast';
      document.body.appendChild(toast);
    }

    toast.textContent = message;
    toast.classList.add('is-visible');

    setTimeout(() => {
      toast.classList.remove('is-visible');
    }, 2600);
  }

  function getSelectedAmpItems() {
    return [...document.querySelectorAll('.amp-embedded-product-upsells__upsell-item')]
      .filter(item => item.querySelector('.amp-embedded-product-upsells__upsell-item-checkbox')?.checked)
      .map(item => {
        const selector = item.querySelector('.amp-embedded-product-upsells__upsell-item-variant-selector');
        const id = gidToVariantId(selector?.value);

        return id ? {
          id: Number(id),
          quantity: 1,
          properties: getPersonalization()
        } : null;
      })
      .filter(Boolean);
  }

  async function refreshCartDrawer() {
    document.dispatchEvent(new CustomEvent('cart:refresh'));
    document.dispatchEvent(new CustomEvent('cart:open'));

    const cartToggle = document.querySelector(
      '[data-cart-drawer-toggle], [data-cart-toggle], .site-header-cart, .header-cart, a[href="/cart"]'
    );

    if (cartToggle) {
      setTimeout(() => cartToggle.click(), 250);
    }
  }

  async function addUpsells(button) {
    const items = getSelectedAmpItems();

    if (!items.length) {
      showAmpToast('Please select an upsell first.');
      return;
    }

    const originalText = button.textContent;
    button.disabled = true;
    button.textContent = 'Adding...';
    button.classList.add('is-loading');

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ items })
      });

      if (!response.ok) throw new Error('Cart add failed');

      button.textContent = 'Added ✓';
      showAmpToast('Upsell added to cart ✓');

      await fetch('/cart.js', { cache: 'no-store' });

      setTimeout(refreshCartDrawer, 300);

      document
        .querySelectorAll('.amp-embedded-product-upsells__upsell-item-checkbox')
        .forEach(cb => cb.checked = false);

      setTimeout(() => {
        button.disabled = false;
        button.textContent = originalText || 'Add';
        button.classList.remove('is-loading');
      }, 1200);

    } catch (error) {
      button.disabled = false;
      button.textContent = originalText || 'Add';
      button.classList.remove('is-loading');
      showAmpToast('Sorry, the upsell could not be added.');
    }
  }

  document.addEventListener('click', function (event) {
    const button = event.target.closest('.amp-embedded-product-upsells__upsell-item-button');
    if (!button) return;

    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();

    addUpsells(button);
    return false;
  }, true);
})();
</script>

