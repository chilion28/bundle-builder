      },
      'Signature Series': {
        desc: 'Premium specialty styles',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/Snapback_liner.svg?v=1777580563'
      }
    };

    const wrapper = document.createElement('div');
    wrapper.className = 'cl-style-slider-wrap';

    wrapper.innerHTML = `
      <h3 class="cl-style-slider-title">Choose Your Hat Style</h3>
      <div class="cl-style-slider"></div>
    `;

    const slider = wrapper.querySelector('.cl-style-slider');

    [...styleSelect.options].forEach(option => {
      if (!option.value) return;

      const value = option.value;
      const meta = styleMeta[value] || {};

      const card = document.createElement('button');
      card.type = 'button';
      card.className = 'cl-style-card';
      card.dataset.styleValue = value;

      card.innerHTML = `
        ${meta.badge ? `<div class="cl-style-card__badge">${meta.badge}</div>` : ''}
        ${meta.img ? `<img class="cl-style-card__image" src="${meta.img}" alt="${value}">` : ''}
        <div class="cl-style-card__title">${value}</div>
        <div class="cl-style-card__desc">${meta.desc || ''}</div>
      `;

      card.addEventListener('click', function () {
        styleSelect.value = value;

        styleSelect.dispatchEvent(new Event('input', { bubbles: true }));
        styleSelect.dispatchEvent(new Event('change', { bubbles: true }));

        document.querySelectorAll('.cl-style-card').forEach(c => {
          c.classList.toggle('is-active', c.dataset.styleValue === value);
        });
      });

      slider.appendChild(card);
    });

    styleBlock.insertAdjacentElement('beforebegin', wrapper);

    document.querySelectorAll('.cl-style-card').forEach(card => {
      card.classList.toggle(
        'is-active',
        card.dataset.styleValue === styleSelect.value
      );
    });
  }

  let attempts = 0;

  const timer = setInterval(function () {
    attempts++;

    if (document.querySelector('select[option-data="Style"]')) {
      clearInterval(timer);
      buildStyleCardsOnly();
    }

    if (attempts > 60) clearInterval(timer);
  }, 250);
})();
</script>

<script>
(function () {
  if (window.__CL_MOBILE_ATC_ZEPTO_FIX_V1) return;
  window.__CL_MOBILE_ATC_ZEPTO_FIX_V1 = true;

  const CL_FIX = {
    zeptoSrc: '//cdn-zeptoapps.com/product-personalizer/canvas-script.php?shop=citylocs.myshopify.com&prid=8770875719768&kkr=tomato',
    zeptoRetryCount: 0,
    maxZeptoRetries: 5,

    selectors: {
      form: 'form[action*="/cart/add"]',
      atcButton: 'gp-product-button button[name="add"], button[name="add"]',
      gpProductButton: 'gp-product-button',
      zeptoReady: '.product-personalizer, #pplr_html, #pplr, .pplr-wrapper, .pplr_text, .pplr_check_order'
    },

    isZeptoReady() {
      return !!document.querySelector(this.selectors.zeptoReady);
    },

    setButtonState(label, disabled) {
      document.querySelectorAll(this.selectors.atcButton).forEach(button => {
        button.disabled = !!disabled;
        button.dataset.clOriginalText = button.dataset.clOriginalText || button.textContent.trim();
        button.textContent = label || button.dataset.clOriginalText || 'Add to cart';
      });
    },

    restoreButtonState() {
      document.querySelectorAll(this.selectors.atcButton).forEach(button => {
        button.disabled = false;
        button.textContent = button.dataset.clOriginalText || 'Add to cart';
      });
    },

    reloadZepto() {
      if (this.isZeptoReady()) return;
      if (this.zeptoRetryCount >= this.maxZeptoRetries) {
        this.setButtonState('Personalizer failed to load. Refresh page.', true);
        return;
      }

      this.zeptoRetryCount += 1;

      const oldScript = [...document.querySelectorAll('script[src*="canvas-script.php"]')]
        .find(script => script.src.includes('product-personalizer'));

      if (oldScript) oldScript.remove();

      const script = document.createElement('script');
      script.type = 'text/javascript';
      script.defer = true;
      script.src = this.zeptoSrc + '&cl_reload=' + Date.now();

      document.body.appendChild(script);
    },

    startZeptoWatchdog() {
      let checks = 0;

      const timer = setInterval(() => {
        checks += 1;

        if (this.isZeptoReady()) {
          clearInterval(timer);
          this.restoreButtonState();
          return;
        }

        this.setButtonState('Loading personalization...', true);

        if ([8, 16, 28, 42, 58].includes(checks)) {
          this.reloadZepto();
        }

        if (checks >= 80) {
          clearInterval(timer);

          if (!this.isZeptoReady()) {
            this.setButtonState('Personalizer failed to load. Refresh page.', true);
          }
        }
      }, 500);
    },

    getVariantId(form) {
      const gpButton = document.querySelector(this.selectors.gpProductButton);
      const gpVariantId = gpButton?.getAttribute('variant-id');

      const inputVariantId =
        form?.querySelector('[name="id"]')?.value ||
        form?.querySelector('input[name="id"]')?.value;

      return gpVariantId || inputVariantId;
    },

    getQuantity(form) {
      return (
        form?.querySelector('[name="quantity"]')?.value ||
        document.querySelector('[name="quantity"]')?.value ||
        1
      );
    },

    buildFormData(form) {
      const formData = new FormData(form);
      const variantId = this.getVariantId(form);

      if (variantId) formData.set('id', variantId);
      if (!formData.get('quantity')) formData.set('quantity', this.getQuantity(form));

      return formData;
    },

    async refreshCart() {
      const cart = await fetch('/cart.js', { cache: 'no-store' }).then(r => r.json());
      const count = cart.item_count || 0;
    
      document.querySelectorAll('.site-header-cart--count[data-header-cart-count]').forEach(el => {
      el.textContent = '';
      el.setAttribute('data-header-cart-count', count);
      el.classList.toggle('visible', count > 0);
    });
    
      document.dispatchEvent(new CustomEvent('cart:refresh', { detail: { cart } }));
      document.dispatchEvent(new CustomEvent('cart:open', { detail: { cart } }));
      window.dispatchEvent(new CustomEvent('cart:refresh', { detail: { cart } }));
      window.dispatchEvent(new CustomEvent('cart:open', { detail: { cart } }));
    
      const cartButton = document.querySelector('.site-header-cart--button');
    
      if (cartButton) {
        cartButton.dispatchEvent(new MouseEvent('click', {
          bubbles: true,
          cancelable: true,
          view: window
        }));
      }
    
      setTimeout(() => {
        const ampCart = document.querySelector('.amp-cart');
        const ampDrawer = document.querySelector('.amp-cart-drawer');
        const ampInner = document.querySelector('.amp-cart-drawer__inner');
    
        if (ampCart) {
          ampCart.classList.remove('false');
          ampCart.classList.add('true', 'is-open', 'active');
        }
    
        if (ampDrawer) {
          ampDrawer.classList.add('is-open', 'active', 'open');
          ampDrawer.style.display = 'block';
        }
    
        if (ampInner) {
          ampInner.focus();
        }
      }, 250);
    
      setTimeout(() => {
        document.querySelector('.site-header-cart--button')?.click();
      }, 700);
    },

    async addToCart(button) {
      const form = document.querySelector(this.selectors.form);

      if (!form) {
        window.location.href = '/cart';
        return;
      }

      if (!this.isZeptoReady()) {
        this.setButtonState('Loading personalization...', true);
        this.reloadZepto();

        setTimeout(() => {
          if (this.isZeptoReady()) this.restoreButtonState();
        }, 1200);

        return;
      }

      if (typeof form.reportValidity === 'function' && !form.reportValidity()) {
        return;
      }

      const originalText = button.textContent.trim();

      button.disabled = true;
      button.textContent = 'Adding...';

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            Accept: 'application/json'
          },
          body: this.buildFormData(form)
        });

        if (!response.ok) throw new Error('Cart add failed');

        button.textContent = 'Added ✓';

        await this.refreshCart();

        setTimeout(() => {
          button.disabled = false;
          button.textContent = originalText || 'Add to cart';
        }, 900);

      } catch (error) {
        button.disabled = false;
        button.textContent = originalText || 'Add to cart';
        console.error('[CL] Add to cart failed:', error);
        alert('Sorry, this item could not be added. Please try again.');
      }
    },

    bindAddToCart() {
      document.addEventListener('click', event => {
        const button = event.target.closest(this.selectors.atcButton);
        if (!button) return;

        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();

        this.addToCart(button);

        return false;
      }, true);
    },

    init() {
      this.startZeptoWatchdog();
      this.bindAddToCart();
    }
  };

  function CLUpdateCartBadge() {
    fetch('/cart.js', { cache: 'no-store' })
      .then(res => res.json())
      .then(cart => {
        const count = cart.item_count || 0;

        document.querySelectorAll('.site-header-cart--count[data-header-cart-count]').forEach(el => {
          el.textContent = '';
          el.setAttribute('data-header-cart-count', count);
          el.classList.toggle('visible', count > 0);
        });
      });
  }

  document.addEventListener('click', function (event) {
  const removeBtn = event.target.closest(
    `
    .amp-cart__item-remove,
    .amp-cart__item-remove-button,
    .amp-cart__line-item-remove,
    .amp-cart-remove,
    .cart-item__remove,
    [data-cart-remove],
    [data-line-item-remove],
    [data-amp-cart-remove],
    button[name="remove"],
    a[href*="/cart/change"],
    a[href*="quantity=0"]
    `
  );

  if (!removeBtn) return;

  setTimeout(CLUpdateCartBadge, 300);
  setTimeout(CLUpdateCartBadge, 700);
  setTimeout(CLUpdateCartBadge, 1200);
  setTimeout(CLUpdateCartBadge, 2000);
}, true);

['cart:refresh', 'cart:updated', 'cart:change', 'cart:remove', 'ajaxCart:updated'].forEach(function (eventName) {
  document.addEventListener(eventName, CLUpdateCartBadge);
  window.addEventListener(eventName, CLUpdateCartBadge);
});


function CLUpdateCartBadge() {
  fetch('/cart.js', { cache: 'no-store' })
    .then(res => res.json())
    .then(cart => {
      const count = cart.item_count || 0;

      document.querySelectorAll('.site-header-cart--count[data-header-cart-count]').forEach(el => {
        el.textContent = '';
        el.setAttribute('data-header-cart-count', count);
        el.classList.toggle('visible', count > 0);
      });
    });
}

(function CLWatchCartRequests() {
  const shouldUpdate = url =>
    typeof url === 'string' &&
    (
      url.includes('/cart/add') ||
      url.includes('/cart/change') ||
      url.includes('/cart/update') ||
      url.includes('/cart/clear')
    );

  const originalFetch = window.fetch;

  window.fetch = function () {
    const url = arguments[0]?.url || arguments[0];

    return originalFetch.apply(this, arguments).then(response => {
      if (shouldUpdate(String(url))) {
        setTimeout(CLUpdateCartBadge, 300);
        setTimeout(CLUpdateCartBadge, 800);
        setTimeout(CLUpdateCartBadge, 1500);
      }

      return response;
    });
  };

  const originalOpen = XMLHttpRequest.prototype.open;

  XMLHttpRequest.prototype.open = function (method, url) {
    this.addEventListener('loadend', function () {
      if (shouldUpdate(String(url))) {
        setTimeout(CLUpdateCartBadge, 300);
        setTimeout(CLUpdateCartBadge, 800);
        setTimeout(CLUpdateCartBadge, 1500);
      }
    });

    return originalOpen.apply(this, arguments);
  };
})();

  CL_FIX.init();

})();
</script>
