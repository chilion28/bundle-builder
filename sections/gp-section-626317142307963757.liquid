      const finalQty = Math.max(0, newQty);

      if (finalQty > 0) {
        selected.set(data.key, refreshItemDiscountRule({ ...data, qty: finalQty }));
        cardControls.set(data.key, { setQty() { updateCardUI(); } });
      } else {
