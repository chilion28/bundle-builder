      let qty = 0;
      selected.forEach(item => {
        if (item.handle !== handle) return;
        const parts = String(item.variant || '').split(' / ');
        if (parts.includes(value)) qty += item.qty || 0;
      });
      let badge = btn.querySelector('.cl-swatch-badge');
      if (qty > 0) {
