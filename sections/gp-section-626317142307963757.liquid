    function commitPersonalizedItem() {
      if (!modalActiveConfig) return;
      const data = activeModalCard ? getCardData(activeModalCard) : modalEditingData;
      if (!data) return;
      const clean = cleanPersonalization(modalActiveConfig, modalPersonalization);
      const key = makeItemKey(data.variantId, clean);

      let qty;
      if (modalEditingKey) {
        // Editing an existing line — PRESERVE its quantity.
        const editingItem = selected.get(modalEditingKey);
        const prevQty = editingItem ? editingItem.qty : 1;
        if (modalEditingKey === key) {
          qty = prevQty; // unchanged key: update in place, keep qty
        } else {
          // Text/variant changed → new key. Remove the old line and merge into
          // an existing identical line if one exists (else carry the qty over).
          selected.delete(modalEditingKey);
          const target = selected.get(key);
          qty = prevQty + (target ? target.qty : 0);
        }
      } else {
        // Adding a fresh personalized line (or another of an identical one).
        const existing = selected.get(key);
        qty = existing ? existing.qty + 1 : 1;
      }
      selected.set(key, refreshItemDiscountRule({ ...data, key, qty, personalization: clean }));
      modalEditingKey = null;
      modalEditingData = null;
      renderSummary();
      closeProductModal();
