</style>

<script>
  // Dynamic hero heading (collection metafield → JS swaps the GemPages H1).
  // Falls back to the default when the metafield is empty/unset.
  window.CL_HERO_TEXT = {{ collection.metafields.custom.custom_hero_text.value | default: 'The More You Bundle, The More You Save' | json }};

  window.CL_BUILDER_CONFIG = {
    title: {{ collection.metafields.custom.builder_title | json }},
    itemSingular: {{ collection.metafields.custom.builder_item_singular | json }},
    itemPlural: {{ collection.metafields.custom.builder_item_plural | json }},
    addButtonText: {{ collection.metafields.custom.builder_add_button_text | json }},
    milestones: {{ collection.metafields.custom.builder_milestones.value | json }},
    milestoneStyle: {{ collection.metafields.custom.builder_milestone_style | json }},
    giftTiers: [
  {% for tier in collection.metafields.custom.gift_tiers.value %}
    {
      minQty: {{ tier.minimum_quantity.value | json }},
      variants: [
        {% for variant in tier.gift_variants.value %}
          {
            id: {{ variant.id | json }},
            title: {{ variant.product.title | json }},
            variantTitle: {{ variant.title | json }},
            {%- assign _gimg = variant.image | default: variant.product.featured_image -%}
            image: {% if _gimg %}{{ _gimg | image_url: width: 160 | json }}{% else %}null{% endif %},
            price: {{ variant.price | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
],
    freeGiftProducts: [
  {% for variant in collection.metafields.custom.builder_free_gift_variants.value %}
    {
      id: {{ variant.id | json }},
      title: {{ variant.product.title | json }},
      variantTitle: {{ variant.title | json }},
      {%- assign _fgimg = variant.image | default: variant.product.featured_image -%}
      image: {% if _fgimg %}{{ _fgimg | image_url: width: 160 | json }}{% else %}null{% endif %},
      price: {{ variant.price | json }},
      tags: {{ variant.product.tags | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
],
    freeGiftVariants: {{ collection.metafields.custom.builder_free_gift_variants.value | map: 'id' | json }},
    freeGiftPackSize: {{ collection.metafields.custom.builder_free_gift_pack_size | json }},
        freeGiftDiscountCode: {{ collection.metafields.custom.builder_free_gift_discount_code | json }},
    freeGiftLabel: {{ collection.metafields.custom.builder_free_gift_label | json }}
  };

  // Per-product personalization field lists (labels mirror Zepto exactly). Empty/absent => not personalized.
  window.CL_PRODUCT_PERSONALIZATION = {
    {%- for product in collection.products -%}
      {%- assign cl_pf = product.metafields.custom.personalization_fields.value -%}
      {%- if cl_pf and cl_pf.size > 0 %}
    {{ product.handle | json }}: { productType: {{ product.type | json }}, fields: {{ cl_pf | json }} },
      {%- endif -%}
    {%- endfor %}
  };
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const selected = new Map();
    const unlockedGiftTierKeys = new Set();
    const cardControls = new Map();
    const cardSyncers = [];


    let activeModalCard = null;
    let clCheckoutInProgress = false;

    function normalizeConfigValue(value, fallback) {
    if (value && typeof value === 'object' && 'value' in value) return value.value || fallback;
    return value || fallback;
  }



    function normalizeMilestones(value) {
  const fallback = [3, 12, 24];

  let raw = value;

  if (raw && typeof raw === 'object' && 'value' in raw) {
    raw = raw.value;
  }

  if (Array.isArray(raw)) {
    return raw.map(Number).filter(qty => qty > 0);
  }

  if (typeof raw === 'string') {
    try {
      const parsed = JSON.parse(raw);

      if (Array.isArray(parsed)) {
        return parsed.map(Number).filter(qty => qty > 0);
      }
    } catch (e) {
      return raw
        .replace(/[\[\]]/g, '')
        .split(',')
        .map(item => Number(item.trim()))
        .filter(qty => qty > 0);
    }
  }

  return fallback;
}

    function capitalize(text) {
  return String(text || '').replace(/\b\w/g, char => char.toUpperCase());
}

    const builderConfig = {
    title: normalizeConfigValue(window.CL_BUILDER_CONFIG?.title, 'Build Your Pack'),
    itemSingular: normalizeConfigValue(window.CL_BUILDER_CONFIG?.itemSingular, 'item'),
    itemPlural: normalizeConfigValue(window.CL_BUILDER_CONFIG?.itemPlural, 'items'),
    addButtonText: normalizeConfigValue(window.CL_BUILDER_CONFIG?.addButtonText, 'Add Selected Items to Cart'),
    addToBundleText: 'Add to Bundle',
    milestones: normalizeMilestones(window.CL_BUILDER_CONFIG?.milestones),
    milestoneStyle: normalizeConfigValue(window.CL_BUILDER_CONFIG?.milestoneStyle, 'dots'),
    giftTiers: Array.isArray(window.CL_BUILDER_CONFIG?.giftTiers)
  ? window.CL_BUILDER_CONFIG.giftTiers
      .map(tier => ({
        minQty: Number(tier.minQty) || 0,
        variants: (Array.isArray(tier.variants) ? tier.variants : [])
          .map(v => ({ ...v, id: Number(v.id), price: Number(v.price) }))
      }))
      .filter(tier => tier.minQty > 0 && tier.variants.length)
      .sort((a, b) => a.minQty - b.minQty)
  : [],
    freeGiftVariants: Array.isArray(window.CL_BUILDER_CONFIG?.freeGiftVariants)
  ? window.CL_BUILDER_CONFIG.freeGiftVariants.map(Number).filter(Boolean)
  : [],
  freeGiftProducts: Array.isArray(window.CL_BUILDER_CONFIG?.freeGiftProducts)
  ? window.CL_BUILDER_CONFIG.freeGiftProducts
  : [],
    freeGiftPackSize: Number(normalizeConfigValue(window.CL_BUILDER_CONFIG?.freeGiftPackSize, 0)) || 0,
    freeGiftDiscountCode: normalizeConfigValue(window.CL_BUILDER_CONFIG?.freeGiftDiscountCode, ''),
    freeGiftLabel: normalizeConfigValue(window.CL_BUILDER_CONFIG?.freeGiftLabel, 'Free gift')
      };



    const packSizes = [...new Set(
      builderConfig.milestones.map(Number).filter(qty => qty > 0)
    )].sort((a, b) => a - b);

    // Pack is now the full milestone range; rewards unlock at each milestone.
    let selectedPackSize = packSizes[packSizes.length - 1] || 3;
    let lastSyncedQty = 0;

    let selectedMilestones = [0, ...packSizes];

    
        const maxPackSize = Math.max(...packSizes);

    // ---- Personalization (custom text) ----
    const PERSONALIZATION = window.CL_PRODUCT_PERSONALIZATION || {};

    // Per-label input defaults. Keys mirror Zepto labels exactly.
    const PERSONALIZATION_FIELD_DEFAULTS = {
      'Month':          { type: 'text', maxLength: 3,  placeholder: 'MONTH' },
      'Year':           { type: 'text', maxLength: 4,  placeholder: 'YEAR' },
      'Custom Text':    { type: 'text', maxLength: 20, placeholder: 'CUSTOM' },
      'Custom Text One':{ type: 'text', maxLength: 20, placeholder: '' },
      // Custom Text Two is the optional second line — never required to save,
      // mirroring the inline card's OPTIONAL_FIELDS (cl-pack-grid.js).
      'Custom Text Two':{ type: 'text', maxLength: 26, placeholder: '', optional: true }
    };

    let modalActiveConfig = null;   // personalization config for the open modal (or null)
    let modalPersonalization = {};  // current values in the open modal
    let modalEditingKey = null;     // key of the line being edited (or null)
    let modalEditingData = null;    // item data when editing without a card
    let modalProductTitle = '';
    let modalProductHandle = '';

    function escapeHtml(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function getPersonalizationConfig(handle) {
      const entry = PERSONALIZATION[handle];
      if (!entry || !Array.isArray(entry.fields) || !entry.fields.length) return null;
      return {
        productType: entry.productType || '',
        fields: entry.fields.map(label => ({
          label,
          ...(PERSONALIZATION_FIELD_DEFAULTS[label] || { type: 'text', maxLength: 30, placeholder: '' })
        }))
      };
    }

    function personalizationHash(p) {
      if (!p) return '';
      const keys = Object.keys(p).filter(k => p[k] !== '' && p[k] != null).sort();
      return keys.map(k => `${k}=${p[k]}`).join('|');
    }
    function makeItemKey(variantId, p) {
      const h = personalizationHash(p);
      return h ? `${variantId}::${h}` : String(variantId);
    }
    function cleanPersonalization(config, values) {
      const clean = {};
      config.fields.forEach(f => {
        const v = (values[f.label] || '').trim();
        if (v) clean[f.label] = v;   // omit empties, mirroring Zepto
      });
      return clean;
    }
    function personalizationValid(config, values) {
      // require every listed field (set optional:true in defaults to relax)
      return config.fields.every(f => f.optional || (values[f.label] || '').trim().length > 0);
    }

    function renderPersonalizationForm(config, values) {
      const formEl = document.querySelector('[data-cl-modal-personalization]');
      if (!formEl) return;
      formEl.innerHTML = config.fields.map(f => {
        const val = values[f.label] || '';
        const max = f.maxLength || 30;
        return `
          <label class="cl-perso-field">
            <span class="cl-perso-field-head">
              <span class="cl-perso-label">${escapeHtml(f.label)}</span>
              <span class="cl-perso-count" data-cl-perso-count="${escapeHtml(f.label)}">${max - val.length}/${max}</span>
            </span>
            <input type="text" class="cl-perso-input"
              data-cl-perso-input="${escapeHtml(f.label)}"
              maxlength="${max}" placeholder="${escapeHtml(f.placeholder || '')}"
              value="${escapeHtml(val)}">
          </label>`;
      }).join('');
    }

    function renderPersonalizationPreview(config, values) {
      const box = document.querySelector('[data-cl-modal-preview]');
      if (!box) return;
      // Prefer the shared config-driven Zepto preview (real plate image + fonts),
      // exposed by cl-pack-grid.js. Falls back to the flat plate if unavailable.
      if (window.CLPlatePreview && modalProductHandle &&
          window.CLPlatePreview(box, modalProductHandle, values)) {
        return;
      }
      const get = label => (values[label] || '').toString();
      if (/plate/i.test(config.productType || '')) {
        const state = (modalProductTitle || '').trim().split(/\s+/)[0] || 'CUSTOM';
        box.innerHTML = `
          <div class="cl-plate">
            <div class="cl-plate-top">
              <span class="cl-plate-mini">${escapeHtml(get('Month') || 'MO')}</span>
              <span class="cl-plate-state">${escapeHtml(state.toUpperCase())}</span>
              <span class="cl-plate-mini">${escapeHtml(get('Year') || 'YR')}</span>
            </div>
            <div class="cl-plate-main">${escapeHtml(get('Custom Text') || 'CUSTOM')}</div>
            <div class="cl-plate-sub">${escapeHtml(get('Custom Text Two'))}</div>
          </div>
          <div class="cl-plate-note">This is just a preview. Text will be adjusted to look its best.</div>`;
      } else {
        const lines = config.fields.map(f => get(f.label)).filter(Boolean);
        box.innerHTML = `<div class="cl-perso-generic">${
          lines.length ? lines.map(l => `<div>${escapeHtml(l)}</div>`).join('')
                       : '<div class="cl-perso-empty">Your text preview</div>'
        }</div>`;
      }
    }

    function setupModalPersonalization(data, values) {
      const formEl = document.querySelector('[data-cl-modal-personalization]');
      const previewEl = document.querySelector('[data-cl-modal-preview]');
      modalActiveConfig = data.personalizationConfig || null;
      modalPersonalization = { ...values };
      modalProductTitle = data.title || '';
      modalProductHandle = data.handle || '';
      if (!modalActiveConfig) {
        if (formEl) { formEl.hidden = true; formEl.innerHTML = ''; }
        if (previewEl) { previewEl.hidden = true; previewEl.innerHTML = ''; }
        return;
      }
      if (formEl) formEl.hidden = false;
      if (previewEl) previewEl.hidden = false;
