/*TEMPLATE STYLES*/

/* ===== CityLocs Pack Builder — design restyle (Stage 1) ===== */
body.template-collection {
  --cl-accent: #00a0ea;
  --cl-ink: #141312;
  --cl-muted: #6f6e6a;
  --cl-faint: #a3a29e;
  --cl-dark: #0a0a0a;
  --cl-card: #ffffff;
  --cl-border: #e7e6e2;
  --cl-page: #f4f3f0;
}

/* Title block */
[data-cl-page-title] {
  font-family: 'Archivo', sans-serif !important;
  font-weight: 900 !important;
  font-size: 46px !important;
  line-height: 1.02 !important;
  letter-spacing: -0.02em !important;
  color: var(--cl-ink) !important;
}
[data-cl-page-subtitle] {
  font-family: 'Barlow', sans-serif !important;
  font-size: 16px !important;
  line-height: 1.5 !important;
  color: var(--cl-muted) !important;
}

/* Summary panel shell */
.cl-golf-summary {
  background: var(--cl-card);
  border: 1.5px solid var(--cl-border) !important;
  border-radius: 18px !important;
  box-shadow: 0 14px 40px rgba(0,0,0,.06);
  padding: 22px !important;
}
.cl-golf-summary h3 {
  font-family: 'Archivo', sans-serif !important;
  font-weight: 800 !important;
  font-size: 19px !important;
  text-align: left !important;
  margin-bottom: 14px !important;
}

/* Progress / slots bar — single accent fill on a soft track */
.cl-golf-milestones.cl-style-slots .cl-slot { background: #dadada; }
.cl-golf-milestones.cl-style-slots .cl-slot.is-filled { background: var(--cl-accent); }
.cl-golf-progress-fill { background: var(--cl-accent); }
[data-cl-current-discount] {
  font-family: 'Barlow', sans-serif !important;
  font-weight: 600;
  color: var(--cl-muted);
}

/* Line-item groups */
.cl-golf-summary-group { border-top: 1px solid #efeeea; }
.cl-golf-summary-group-head {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 13.5px;
}
.cl-golf-summary-group-count { color: var(--cl-accent); }
.cl-golf-summary-save-badge {
  background: #e4f6ff;
  color: var(--cl-accent);
}

/* Qty stepper */
.cl-golf-summary-qty {
  border: 1px solid #e2e1dd !important;
  border-radius: 9px;
  overflow: hidden;
}
.cl-golf-summary-qty button { background: #f6f5f2; }

/* Totals + CTA */
.cl-golf-summary-footer { border-top: 1px solid #efeeea; }
[data-cl-estimated-total] {
  font-family: 'Archivo', sans-serif;
  font-weight: 900;
  font-size: 24px;
}
.cl-golf-checkout {
  border-radius: 13px !important;
  padding: 15px !important;
  font-family: 'Archivo', sans-serif !important;
  font-weight: 800 !important;
  font-size: 15px !important;
  background: var(--cl-dark) !important;
  transition: background .15s ease, color .15s ease;
}
.cl-golf-checkout:not(:disabled):hover {
  background: var(--cl-accent) !important;
  color: #04212d !important;
}
.cl-golf-checkout:disabled { background: #edece9 !important; color: var(--cl-faint) !important; }

/* Product card + add-to-bundle button */
gp-product article,
gp-product .gp-product-inner {
  border-radius: 16px;
}
.cl-add-to-bundle {
  border-radius: 11px !important;
  font-family: 'Archivo', sans-serif !important;
  font-weight: 700 !important;
