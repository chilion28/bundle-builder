    }
  });
}



        // Wires one custom cl-pack-grid card (snippets/cl-pack-grid.liquid).
        // The snippet owns variant resolution + inline personalization inputs;
        // this owns pack membership, button state and badges.
        function initGridCard(card) {
    if (card.__clWired) return;
    card.__clWired = true;

    const addBtn = card.querySelector('[data-cl-add]');
    if (!addBtn) return;

    const cardHandle = card.getAttribute('data-cl-handle') || '';
    const isPersonalizedCard = card.hasAttribute('data-cl-personalized');

    function getProductTotal() {
      let total = 0;
      selected.forEach(item => {
        if (item.handle && item.handle === cardHandle) total += item.qty || 0;
      });
      return total;
    }

    function getActiveQty() {
      const item = selected.get(getCardData(card).key);
      return item ? item.qty : 0;
    }

    function updateCheckBadge(inPack) {
      card.classList.toggle('cl-in-pack', inPack);
      let check = card.querySelector('.cl-pack-check');
      if (inPack && !check) {
        check = document.createElement('span');
        check.className = 'cl-pack-check';
        check.textContent = '✓';
        card.appendChild(check);
      } else if (!inPack && check) {
        check.remove();
      }
    }

    function updateCardUI() {
      const full = isPackFull();
      const total = getProductTotal();

      if (isPersonalizedCard) {
        addBtn.classList.remove('is-added');
        addBtn.classList.toggle('is-pack-full', full && total === 0);
        addBtn.disabled = full;
        addBtn.textContent = full
          ? 'Your pack is full'
          : (total > 0 ? `Add Another (${total})` : `Add this ${String(builderConfig.itemSingular || 'item').toLowerCase()}`);
        addBtn.classList.toggle('is-invalid', !full && !(card.__clPerso && card.__clPerso.valid));
      } else {
        const activeQty = getActiveQty();
        if (activeQty > 0) {
          addBtn.disabled = false;
          addBtn.classList.add('is-added');
          addBtn.classList.remove('is-pack-full');
          addBtn.textContent = '✓ Added — tap to remove';
        } else if (full) {
          addBtn.disabled = true;
          addBtn.classList.remove('is-added');
          addBtn.classList.add('is-pack-full');
          addBtn.textContent = 'Your pack is full';
        } else {
          addBtn.disabled = false;
          addBtn.classList.remove('is-added', 'is-pack-full');
          addBtn.textContent = 'Add to Pack';
        }
      }
      // Sold out: the currently selected variant is unavailable → block adding.
      if (card.getAttribute('data-cl-available') === 'false') {
        addBtn.disabled = true;
        addBtn.classList.remove('is-added', 'is-invalid');
        addBtn.classList.add('is-pack-full');
        addBtn.textContent = 'Sold out';
      }

      updateCheckBadge(total > 0);
      updateSwatchBadges(card, getCardData(card).title);
    }

    function setActiveQty(newQty) {
      const data = getCardData(card);
      const finalQty = Math.max(0, newQty);

      if (finalQty > 0) {
        selected.set(data.key, refreshItemDiscountRule({ ...data, qty: finalQty }));
        cardControls.set(data.key, { setQty() { updateCardUI(); } });
      } else {
        selected.delete(data.key);
      }

      renderSummary();
    }

    function commitInlinePersonalized() {
      if (card.getAttribute('data-cl-available') === 'false') return; // sold out
      const perso = card.__clPerso;
      if (!perso) return;
      if (!perso.valid) {
        // Open the accordion, focus the first empty required field, and show an
        // inline notice (handles both the collapsed and open states).
        if (typeof perso.promptMissing === 'function') {
          perso.promptMissing();
        } else {
          const empty = Array.from(card.querySelectorAll('[data-cl-perso-input]'))
            .find(input => !input.value.trim());
          if (empty) empty.focus();
        }
        addBtn.classList.add('is-invalid');
        return;
      }
      const data = getCardData(card);
      if (!data.variantId) return;
      const clean = perso.values;
      const key = makeItemKey(data.variantId, clean);
      const existing = selected.get(key);
      const qty = existing ? existing.qty + 1 : 1;
      selected.set(key, refreshItemDiscountRule({ ...data, key, qty, personalization: clean }));
      cardControls.set(key, { setQty() { updateCardUI(); } });
      perso.reset();
      renderSummary();
    }

    addBtn.addEventListener('click', () => {
      if (card.getAttribute('data-cl-available') === 'false') return; // sold out
      if (isPersonalizedCard) {
        if (!isPackFull()) commitInlinePersonalized();
        return;
      }
      if (getActiveQty() > 0) {
        setActiveQty(0);
      } else if (!isPackFull()) {
        setActiveQty(1);
      }
    });

    card.addEventListener('cl:variant-change', updateCardUI);
    card.addEventListener('cl:perso-change', updateCardUI);

    cardSyncers.push(updateCardUI);
    updateCardUI();
  }

        function initCards() {
