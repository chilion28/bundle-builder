      <script id="custom-js-gP5QXP--wf">
        try {
          (function() {
  // Configuration: Add any option names that should trigger the preview
  // Matches option-name attributes that contain "color" (case-insensitive)
  const COLOR_OPTION_SELECTOR = '[option-name*="olor" i], [option-name*="Color"]';

  // Track which images have been initialized to avoid duplicate listeners
  const initializedImages = new WeakSet();
  // Cache for preloaded images
  const preloadedImages = new Map();

  const tooltip = document.getElementById("variantPreviewTooltip");
  const previewImg = document.getElementById("variantPreviewImg");
  const previewName = document.getElementById("variantPreviewName");
  const tooltipInner = tooltip ? tooltip.querySelector('.variant-preview-inner') : null;

  const mobileOverlay = document.getElementById("mobileVariantPreview");
  const mobileImg = document.getElementById("mobileVariantImg");
  const mobileName = document.getElementById("mobileVariantName");
  const mobileInner = mobileOverlay ? mobileOverlay.querySelector('.mobile-variant-inner') : null;

  const isTouch = "ontouchstart" in window || navigator.maxTouchPoints > 0;

  // Move tooltip to body once for proper fixed positioning
  if (tooltip && tooltip.parentElement !== document.body) {
    document.body.appendChild(tooltip);
    tooltip.style.position = 'fixed';
  }

  // Preload a single image and cache it
  function preloadImage(src) {
    if (!src || preloadedImages.has(src)) return;

    const img = new Image();
    img.src = src;
    preloadedImages.set(src, img);
  }

  // Preload all variant images in the background
  function preloadAllSwatchImages() {
    const colorOptions = document.querySelectorAll(COLOR_OPTION_SELECTOR);
    colorOptions.forEach(function(optionEl) {
      const images = optionEl.querySelectorAll('img');
      images.forEach(function(img) {
        const largeSrc = getSrc(img);
        if (largeSrc) {
          preloadImage(largeSrc);
        }
      });
    });
  }

  function getSrc(imgEl) {
    let src = imgEl.currentSrc || imgEl.src || "";
    if (!src) return "";

    // Handle Shopify CDN URLs - replace size suffix with larger version
    // Matches patterns like _200x.png, _200x200.jpg, etc.
    src = src.replace(/_(\d+x\d*|\d*x\d+)(\.[a-z]+)/i, '_800x$2');

    // Also try without the underscore pattern (some URLs use different format)
    if (!src.includes('_800x')) {
      src = src.replace(/(\.[a-z]+)(\?|$)/i, '_800x$1$2');
    }

    return src;
  }

  function getName(imgEl) {
    // Try multiple ways to get the option name
    // 1. Look for option-name-value on parent with option-name attribute
    const optionEl = imgEl.closest('[option-name]');
    if (optionEl) {
      const nameValue = optionEl.getAttribute('option-name-value');
      if (nameValue) return nameValue;
    }

    // 2. Look for option-value attribute on wrapper
    const wrapper = imgEl.closest('[option-value]');
    if (wrapper) {
      const value = wrapper.getAttribute('option-value');
      if (value) return value;
    }

    // 3. Check label for text
    const label = imgEl.closest('label');
    if (label) {
      const srOnly = label.querySelector('.gp-sr-only');
      if (srOnly && srOnly.textContent) return srOnly.textContent.trim();
    }

    // 4. Fallback to alt text
    return imgEl.alt || "";
  }

  function showTooltip(imgEl) {
    if (!tooltip || !previewImg || !previewName || !tooltipInner) return;

    const src = getSrc(imgEl);
    if (!src) return;

    previewName.textContent = getName(imgEl);

    // Check if image is already preloaded
    const cached = preloadedImages.get(src);
    const isLoaded = cached && cached.complete && cached.naturalWidth > 0;

    if (isLoaded) {
      previewImg.src = src;
      tooltipInner.classList.remove('is-loading');
      previewImg.classList.remove('loading');
    } else {
      // Show loading state
      tooltipInner.classList.add('is-loading');
      previewImg.classList.add('loading');
      previewImg.src = src;

      previewImg.onload = function() {
        tooltipInner.classList.remove('is-loading');
        previewImg.classList.remove('loading');
        preloadedImages.set(src, previewImg);
      };
    }

    // Get swatch position
    const rect = imgEl.getBoundingClientRect();
    const tooltipWidth = 244; // 220px img + 24px padding
    const tooltipHeight = 300; // approximate height with text
    const padding = 15;

    // Calculate centered position above the swatch
    let left = rect.left + (rect.width / 2) - (tooltipWidth / 2);
    let top = rect.top - tooltipHeight - padding;

    // Keep within horizontal bounds
    if (left < padding) {
      left = padding;
    } else if (left + tooltipWidth > window.innerWidth - padding) {
      left = window.innerWidth - tooltipWidth - padding;
    }

    // If would go above viewport, show below instead
    if (top < padding) {
      top = rect.bottom + padding;
    }

    tooltip.style.left = left + "px";
    tooltip.style.top = top + "px";
    tooltip.classList.add("is-active");
  }

  function hideTooltip() {
    if (tooltip) {
      tooltip.classList.remove("is-active");
    }
  }

  function openMobile(imgEl) {
    if (!mobileOverlay || !mobileImg || !mobileName || !mobileInner) return;

    const src = getSrc(imgEl);
    if (!src) return;

    mobileName.textContent = getName(imgEl);

    // Check if image is already preloaded
    const cached = preloadedImages.get(src);
    const isLoaded = cached && cached.complete && cached.naturalWidth > 0;

    if (isLoaded) {
      mobileImg.src = src;
      mobileInner.classList.remove('is-loading');
      mobileImg.classList.remove('loading');
    } else {
      // Show loading state
      mobileInner.classList.add('is-loading');
      mobileImg.classList.add('loading');
      mobileImg.src = src;

      mobileImg.onload = function() {
        mobileInner.classList.remove('is-loading');
        mobileImg.classList.remove('loading');
        preloadedImages.set(src, mobileImg);
      };
    }

    mobileOverlay.classList.add("is-active");
  }

  function initializeSwatchImage(img) {
    // Skip if already initialized
    if (initializedImages.has(img)) return;
    initializedImages.add(img);

    if (!isTouch) {
      // Desktop: hover tooltip
      img.addEventListener("mouseenter", function() {
        showTooltip(img);
      });
      img.addEventListener("mouseleave", function() {
        hideTooltip();
      });
    } else {
      // Mobile: tap to show popup AND allow variant selection to proceed
      img.addEventListener("click", function() {
        openMobile(img);
        // Don't prevent default - let the click bubble up to select the variant
      });
    }
  }

  function findAndInitializeSwatches(root) {
    // Find all color option containers and their images
    const colorOptions = root.querySelectorAll(COLOR_OPTION_SELECTOR);

    colorOptions.forEach(function(optionEl) {
      const images = optionEl.querySelectorAll('img');
      images.forEach(initializeSwatchImage);
    });

    // Also look for images directly inside variant containers
    const variantContainers = root.querySelectorAll('gp-product-variants, .variant-swap-zoom, [class*="variant"]');
    variantContainers.forEach(function(container) {
      const colorOpts = container.querySelectorAll(COLOR_OPTION_SELECTOR);
      colorOpts.forEach(function(optionEl) {
        const images = optionEl.querySelectorAll('img');
        images.forEach(initializeSwatchImage);
      });
    });
  }

  // Initialize mobile overlay close on tap (background or image)
  if (mobileOverlay) {
    mobileOverlay.addEventListener("click", function() {
      // Close when tapping anywhere on the overlay (background or image)
      mobileOverlay.classList.remove("is-active");
    });
  }

  // Initial scan for swatches
  function init() {
    findAndInitializeSwatches(document);
    // Start preloading larger images in background after a short delay
    setTimeout(preloadAllSwatchImages, 100);
  }

  // Use MutationObserver to catch dynamically loaded content
  const observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      // Check added nodes for swatch images
      mutation.addedNodes.forEach(function(node) {
        if (node.nodeType === Node.ELEMENT_NODE) {
          findAndInitializeSwatches(node);

          // Also check if the node itself is a color option
          if (node.matches && node.matches(COLOR_OPTION_SELECTOR)) {
            const images = node.querySelectorAll('img');
            images.forEach(initializeSwatchImage);
          }
        }
      });
    });
  });

  // Start observing
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Also re-scan after a short delay to catch late-loading content
  setTimeout(init, 500);
  setTimeout(init, 1500);
})();

        } catch(err){}
      </script>
    
