      <style id="custom-css-gP5QXP--wf">
        /* ============================
   DESKTOP: HOVER TOOLTIP
   ============================ */

/* Swatch container as positioning context */
.variant-swap-zoom {
  position: relative;
}

/* Tooltip wrapper (positioned by JS over swatch) */
.variant-preview-tooltip {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 9999;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
}

/* Show when active */
.variant-preview-tooltip.is-active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

/* Card styling */
.variant-preview-inner {
  background: #ffffff;
  border-radius: 10px;
  padding: 10px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  border: 2px solid #000;
}

/* Image inside the tooltip */
.variant-preview-inner img {
  display: block;
  width: 220px;
  height: 220px;
  object-fit: contain;
  border-radius: 6px;
  background: #f5f5f5;
  transition: opacity 0.15s ease;
}

.variant-preview-inner img.loading {
  opacity: 0.5;
}

/* Loading spinner */
.variant-preview-inner {
  position: relative;
}

.variant-preview-inner::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24px;
  height: 24px;
  margin: -12px 0 0 -12px;
  border: 3px solid #ddd;
  border-top-color: #333;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.15s;
  pointer-events: none;
}

.variant-preview-inner.is-loading::after {
  opacity: 1;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Variant name text */
.variant-preview-name {
  margin-top: 6px;
  font-size: 14px;
  font-weight: 600;
  text-align: center;
  color: #000;
}

/* Cursor hint on swatch images (desktop) */
[option-name="Color"] img {
  cursor: pointer;
}

/* ============================
   MOBILE: CENTERED PREVIEW POPUP
   ============================ */

.mobile-variant-preview {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  z-index: 99999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s;
}

.mobile-variant-preview.is-active {
  opacity: 1;
  visibility: visible;
}

.mobile-variant-inner {
  background: #ffffff;
  padding: 12px;
  border-radius: 12px;
  width: 80vw;
  max-width: 400px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4);
  text-align: center;
}

.mobile-variant-inner {
  position: relative;
}

.mobile-variant-inner img {
  width: 100%;
  height: auto;
  min-height: 200px;
  object-fit: contain;
  border-radius: 8px;
  margin-bottom: 8px;
  background: #f5f5f5;
  transition: opacity 0.15s ease;
}

.mobile-variant-inner img.loading {
  opacity: 0.5;
}

.mobile-variant-inner::after {
  content: '';
  position: absolute;
  top: calc(50% - 20px);
  left: 50%;
  width: 32px;
  height: 32px;
  margin: -16px 0 0 -16px;
  border: 3px solid #ddd;
  border-top-color: #333;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.15s;
  pointer-events: none;
}

.mobile-variant-inner.is-loading::after {
  opacity: 1;
  animation: spin 0.8s linear infinite;
}

.mobile-variant-name {
  font-size: 16px;
  font-weight: 600;
  color: #000;
}

@media (min-width: 769px) {
  .mobile-variant-preview {
    display: none !important;
  }
}

