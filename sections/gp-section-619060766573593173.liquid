      <script id="custom-js-gB66KHQqhd">
        try {
          document.addEventListener('click', function(e) {
  const toggle = e.target.closest('.cl-cart-toggle');
  if (!toggle) return;

  const cart = document.querySelector('#gKMYbHu6Oj.cl-sticky-cart');
  if (!cart) return;

  cart.classList.toggle('is-minimized');
  toggle.textContent = cart.classList.contains('is-minimized') ? '+' : '−';
});

document.addEventListener('DOMContentLoaded', function () {
  function val(selector, fallback) {
    const el = document.querySelector(selector);
    return el && el.value.trim() ? el.value.trim().toUpperCase() : fallback;
  }

  function updateCartPersonalization() {
    const month = val('input[name="properties[Month]"]', '—');
    const year = val('input[name="properties[Year]"]', '—');
    const customText = val('input[name="properties[Custom Text]"]', 'CUSTOM');
    const lineTwo = val('input[name="properties[Custom Text Two]"]', '—');

    const monthTarget = document.querySelector('#cl-cart-month');
    const yearTarget = document.querySelector('#cl-cart-year');
    const textTarget = document.querySelector('#cl-cart-custom-text');
    const lineTwoTarget = document.querySelector('#cl-cart-line-two');
    const lineTwoWrap = document.querySelector('#cl-cart-line-two-wrap');

    if (monthTarget) monthTarget.textContent = month;
    if (yearTarget) yearTarget.textContent = year;
    if (textTarget) textTarget.textContent = customText;
    if (lineTwoTarget) lineTwoTarget.textContent = lineTwo;

    if (lineTwoWrap) {
      lineTwoWrap.style.display = lineTwo !== '—' ? 'inline' : 'none';
    }
  }

  document.addEventListener('input', function (e) {
    if (e.target.matches('.pplr_text, input[name^="properties["]')) {
      updateCartPersonalization();
    }
  });

  document.addEventListener('change', function (e) {
    if (e.target.matches('.pplrcheckbox, input[name^="properties["]')) {
      setTimeout(updateCartPersonalization, 100);
    }
  });

  updateCartPersonalization();
});

document.addEventListener('DOMContentLoaded', function () {
  const cart = document.querySelector('#gKMYbHu6Oj.cl-sticky-cart');
  const toggle = document.querySelector('.cl-cart-toggle');

  if (!cart) return;

  if (window.matchMedia('(max-width: 767px)').matches) {
    cart.classList.add('is-minimized');
    if (toggle) toggle.textContent = '+';
  }
});

        } catch(err){}
