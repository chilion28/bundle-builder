// find the groups for discounts
function discountDeduct(discounts, productDiscounts) {
    let discountPrice = {}

    // const discs = discounts.filter(e => e.idTag == foundDiscount.id);
    Object.keys(productDiscounts).forEach((discTag, idx) => {
      // if(idx != 0 && Object.keys(discountPrice).length > 0) { return }
      discounts.every((discount, index) => {
        if( productDiscounts[discTag] == discount.quantity || productDiscounts[discTag] < discount.quantity) {
          discountPrice[discTag] = {
            'current': index == 0 ? '' : discounts[index - 1],
            'next': discount
          };
          return false;
        } else {
          return true;
        }
      })
    })
  return discountPrice;
}

