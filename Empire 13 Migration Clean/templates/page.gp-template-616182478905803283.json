        "checksum": "71eee91a6dd26b284c8c0d52a77c26a3537a12a44d731eae83ee0669d7a117e7_1_1_1_0__1",
        "ggV6JC1YgrP_text": "&nbsp;Frequently asked questions",
        "ggzYEQVkl6l_text": "Have more questions? Find answers in ouR <a href=\"https://citylocs.com/pages/faq\"><span style=\"color:#3976A3;\"><u>help center</u></span></a>.",
        "ggD4BPLc0Dm_childItem_0": "<p>&nbsp;How long does it take to receive my order?</p>",
        "ggD4BPLc0Dm_childItem_1": "<p>Where is my order made?</p>",
        "ggD4BPLc0Dm_childItem_2": "<p>Can I order just 1 hat?</p>",
        "ggD4BPLc0Dm_childItem_3": "<p>Do you offer discounts on large orders?</p>",
        "ggwKrAs_PqV_text": "<p><span style=\"background-color:rgba(255, 255, 255, 0);color:rgb(29,29,29);\">When considering production and shipping time, most orders arrive within eight business days. This excludes weekends and holidays. If your order does not require production, because it isn't being customized, it should arrive sooner than eight business days.&nbsp;</span></p>",
        "ggOSRTFQu9Z_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(29,29,29);\">All CityLocs hats are designed and produced in the United States. Each custom hat is made to order, allowing us to ensure quality and attention to detail before it ships to you.&nbsp;</span></p>",
        "ggJZslADCQD_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(29,29,29);\">Yes, absolutely. There is no minimum order requirement — you can order as little as one hat or as many as you’d like.</span></p>",
        "ggyo8HZuMnx_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(29,29,29);\">Yes, we offer discounted pricing for larger quantities. The more hats you order, the lower the price per piece. Bulk pricing is automatically applied on eligible products, or you can contact us for custom orders.</span></p>",
        "gg4ASsyzJTO_label": "<p>view more</p>"
      }
    },
