        "checksum": "6806c61c61ca8b146e3358c278f173bcf8bbc041d1c1d334c6184d363bed1dfb_1_1_1_0__1",
        "ggLsiZ-zRPZ_text": "Custom Hats Made Simple",
        "ggfGEd7Prs1_text": "<p>Pick your state. Type your text. Preview instantly. Done.</p>",
        "ggG_ewFTTQk_childItem_0": "<p>How to Customize</p>",
        "ggG_ewFTTQk_childItem_1": "<p>Hat Styles</p>",
        "gg0E4e013xz_childItem_0": "<p>Snapback</p>",
        "gg0E4e013xz_childItem_1": "<p>Trucker</p>",
        "gg0E4e013xz_childItem_2": "<p>Flexfit</p>",
        "gg0E4e013xz_childItem_3": "<p>A-Frame</p>",
        "gg0E4e013xz_childItem_4": "<p>6-Panel</p>",
        "ggRTHyczHWU_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/image_demo.jpg",
        "ggRTHyczHWU_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0519/6401/files/Snapback_liner.svg",
