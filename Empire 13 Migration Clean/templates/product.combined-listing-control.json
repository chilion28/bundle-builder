/*
 * Standard-product control view for Combined Listing A/B testing.
 *
 * Open a Combined Listing parent with ?view=combined-listing-control
 * to use this template without changing the product's assigned template.
 */
{
  "sections": {
    "main": {
      "type": "static-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "vendor": {
          "type": "vendor",
          "settings": {}
        },
        "rating": {
          "type": "rating",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "loox-rating": {
          "type": "shopify://apps/loox-reviews/blocks/loox-rating/5c3b337f-fd14-4df5-b1d6-80ec13e6e28e",
          "settings": {
            "contentSize": 16,
            "pattern": "",
            "hideText": false,
            "alignment": "",
            "layout": "",
            "textColor": "",
            "starColor": "",
            "showAllReviews": false,
            "looxOpenFloatingWidget": false,
            "emptyRatingWidget": false
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "form": {
          "type": "form",
          "settings": {
            "enable_local_pickup": false
          }
        }
      },
      "block_order": [
        "title",
        "vendor",
        "rating",
        "price",
        "loox-rating",
        "description",
        "form"
      ],
      "settings": {
        "gallery_aspect_ratio": "natural",
        "gallery_image_crop": false,
        "gallery_thumbnail_position": "below",
        "gallery_video_autoplay": true,
        "gallery_video_looping": true,
        "gallery_hover_zoom": "disabled",
        "gallery_click_to_zoom": "always"
      }
    },
    "recommendations": {
      "type": "static-product-recommendations",
      "settings": {
        "show_product_recommendations": true,
        "product_recommendations_heading": "You may also like"
      }
    },
    "recently-viewed": {
      "type": "static-recently-viewed",
      "settings": {
        "enable_recently_viewed_products": true
      }
    },
    "loox-product-reviews-app-section": {
      "type": "apps",
      "blocks": {
        "loox-product-reviews": {
          "type": "shopify://apps/loox-reviews/blocks/loox-dynamic-section/5c3b337f-fd14-4df5-b1d6-80ec13e6e28e",
          "settings": {
            "only_photos": false,
            "aggregated": false,
            "limit": 20,
            "hide_thumbnails": false,
            "maxwidth": 1080,
            "is_sample": false
          }
        }
      },
      "block_order": [
        "loox-product-reviews"
      ],
      "settings": {
        "include_padding": true
      }
    }
  },
  "order": [
    "main",
    "recommendations",
    "recently-viewed",
    "loox-product-reviews-app-section"
  ]
}
