        "ggQxRgrVxwX_text": "Exclusive father's day hat",
        "ggg5unz0sN5_text": "<p>You'll receive a CityLocs hat to keep.</p>",
        "ggXVI1rCB08_text": "Photos to keep",
        "ggXsL6Xkwr-_text": "<p>High-quality photos you'll own forever.</p>",
