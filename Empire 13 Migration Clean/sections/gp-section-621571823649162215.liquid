    <style>
  /* Bundle card wrappers */
  .gnb4qrJspA,
  .gstIm8LFPn,
  .gr79jIsYbA {
    cursor: pointer;
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease,
      filter 220ms ease;
    will-change: transform;
  }

  .gnb4qrJspA:hover,
  .gstIm8LFPn:hover,
  .gr79jIsYbA:hover {
    transform: translateY(-8px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
    border-color: rgba(255,255,255,0) !important;
    border:none;
  }

  /* Slight product image zoom */
  .gnb4qrJspA img,
  .gstIm8LFPn img,
  .gr79jIsYbA img {
    transition: transform 260ms ease;
  }

  .gnb4qrJspA:hover img,
  .gstIm8LFPn:hover img,
  .gr79jIsYbA:hover img {
    transform: scale(1.035);
  }

  /* Button micro animation */
  .gnb4qrJspA:hover .gp-button-base,
  .gstIm8LFPn:hover .gp-button-base,
  .gr79jIsYbA:hover .gp-button-base {
    transform: scale(1.02);
  }

  .gp-button-base {
    transition:
      transform 220ms ease,
      background-color 220ms ease,
      color 220ms ease;
  }

  @media (max-width: 767px) {
    .gnb4qrJspA:hover,
    .gstIm8LFPn:hover,
    .gr79jIsYbA:hover {
      transform: none;
      box-shadow: none;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const bundleCards = [
    {
      selector: '.gnb4qrJspA',
      url: 'https://citylocs.com/products/dope-dad-bundle'
    },
    {
      selector: '.gstIm8LFPn',
      url: 'https://citylocs.com/products/cool-dad-bundle'
    },
    {
      selector: '.gr79jIsYbA',
      url: 'https://citylocs.com/products/dad-life-bundle'
    }
  ];

  bundleCards.forEach(function (item) {
    const card = document.querySelector(item.selector);
    if (!card) return;

    card.setAttribute('role', 'link');
    card.setAttribute('tabindex', '0');

    card.addEventListener('click', function (event) {
      if (event.target.closest('a, button')) return;
      window.location.href = item.url;
    });

    card.addEventListener('keydown', function (event) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        window.location.href = item.url;
      }
    });
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const marquee = document.querySelector('#g5B1JlYHIZ');
  if (!marquee) return;

  const isMobile = window.matchMedia('(max-width: 767px)').matches;

  if (!isMobile) {
    marquee.querySelectorAll('[data-marquee-clone="true"]').forEach(function (clone) {
      clone.remove();
    });
    marquee.dataset.marqueeCloned = 'false';
    return;
  }

  if (marquee.dataset.marqueeCloned === 'true') return;

  const items = Array.from(marquee.children);

  items.forEach(function (item) {
    const clone = item.cloneNode(true);
    clone.setAttribute('aria-hidden', 'true');
    clone.setAttribute('data-marquee-clone', 'true');
    marquee.appendChild(clone);
  });

  marquee.dataset.marqueeCloned = 'true';
});
</script>
