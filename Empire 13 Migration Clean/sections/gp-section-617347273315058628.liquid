<style>
.review-carousel {
  position: relative;
  max-width: 720px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Slides */
.review-track {
  position: relative;
}

.review-slide {
  display: none;
}

.review-slide.active {
  display: block;
}

/* Card */
.review-card {
  background: #f7f7f7;
  border: 1px solid #5F6773;
  border-radius: 14px;
  padding: 60px 50px;
  text-align: center;
}

/* Stars */
.stars {
  color: #ffb800;
  font-size: 24px;
  letter-spacing: 6px;
  margin-bottom: 24px;
}

/* Title */
.review-card h3 {
  font-family: "Inter";
  font-size: 48px;
  font-weight: 900;
  margin-bottom: 20px;
}

/* Body */
.review-card p {
  font-family: "Inter";
  font-size: 26px;
  line-height: 1.3;
  margin-bottom: 30px;
}

/* Name */
.review-card h4 {
  font-family: "Inter";
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 16px;
}

/* Verified */
.verified {
  color: #10c779;
  font-size: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
}

.check {
  background: #10c779;
  color: #fff;
  border-radius: 50%;
  width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}

/* Arrows */
.review-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-200%);
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: rgba(220,220,220,0.9);
  border: none;
  font-size: 40px;
  cursor: pointer;
  z-index: 2;
}

button.review-arrow {
    display: flex;
    justify-content: center;
    align-content: center;
    align-items: center;
    background: rgba(182,190,196,0.6);
    backdrop-filter: blur(2px);
}

.review-arrow.prev { left: 0; }
.review-arrow.next { right: 0; }

/* Dots */
.review-dots {
  margin-top: 25px;
  display: flex;
  justify-content: center;
  gap: 10px;
}

.review-dot {
  width: 12px;
  height: 12px;
  background: #d3d3d3 !important;
  border-radius: 50%;
  cursor: pointer;
}

.review-dot.active {
  background: #9aa3ab !important;
}

.review-track {
  position: relative;
  transition: height 0.3s ease;
}

.review-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.35s ease, visibility 0.35s ease;
}

.review-slide.active {
  position: relative;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

/* Mobile */
@media (max-width: 767px) {
  .review-card {
    padding: 40px 24px;
  }

  .review-card h3 {
    font-size: 32px;
  }

  .review-card p {
    font-size: 20px;
  }

  .review-card h4 {
    font-size: 22px;
  }

  .review-arrow {
    width: 45px;
    height: 45px;
    font-size: 30px;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".review-carousel").forEach(function (carousel) {
    const track = carousel.querySelector(".review-track");
    const slides = carousel.querySelectorAll(".review-slide");
    const prev = carousel.querySelector(".prev");
    const next = carousel.querySelector(".next");
    const dotsWrap = carousel.querySelector(".review-dots");

    let current = 0;
    let autoplayTimer;
    let startX = 0;
    let endX = 0;
    const autoplayDelay = 5000;

    slides.forEach((_, i) => {
      const dot = document.createElement("button");
      dot.className = "review-dot";
      dot.type = "button";
      dot.setAttribute("aria-label", "Go to review " + (i + 1));
      dot.addEventListener("click", () => goTo(i, true));
      dotsWrap.appendChild(dot);
    });

    const dots = carousel.querySelectorAll(".review-dot");

    function setHeight() {
      const activeSlide = slides[current];
      track.style.height = activeSlide.offsetHeight + "px";
    }

    function goTo(index, resetAutoplay) {
      slides[current].classList.remove("active");
      dots[current].classList.remove("active");

      current = (index + slides.length) % slides.length;

      slides[current].classList.add("active");
      dots[current].classList.add("active");

      setHeight();

      if (resetAutoplay) restartAutoplay();
    }

    function nextSlide() {
      goTo(current + 1, false);
    }

    function restartAutoplay() {
      clearInterval(autoplayTimer);
      autoplayTimer = setInterval(nextSlide, autoplayDelay);
    }

    prev.addEventListener("click", () => goTo(current - 1, true));
    next.addEventListener("click", () => goTo(current + 1, true));

    carousel.addEventListener("mouseenter", () => clearInterval(autoplayTimer));
    carousel.addEventListener("mouseleave", restartAutoplay);

    carousel.addEventListener("touchstart", function (e) {
      startX = e.touches[0].clientX;
    });

    carousel.addEventListener("touchend", function (e) {
      endX = e.changedTouches[0].clientX;
      const diff = startX - endX;

      if (Math.abs(diff) > 50) {
        if (diff > 0) {
          goTo(current + 1, true);
        } else {
          goTo(current - 1, true);
        }
      }
    });

    slides[0].classList.add("active");
    dots[0].classList.add("active");

    setHeight();
    restartAutoplay();

    window.addEventListener("resize", setHeight);
  });
});
</script>
