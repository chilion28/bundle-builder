<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="dynamic-rich-text"
>
</script>

<script type="application/pxs-animation-mapping+json">
  {
    "blocks": [".rich-text"],
    "elements": [".rich-text__block"]
  }
</script>

<section
  class="
    rich-text
    rich-text--{{ section.settings.width }}
    rich-text--alignment-{{ section.settings.content_alignment }}
  "
>
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        <div
          class="rich-text__block"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.title != blank -%}
            <h2
              class="
                rich-text__heading
                rich-text__heading--{{ block.settings.heading_size }}
              "
            >
              {{- block.settings.title | escape -}}
            </h2>
          {%- endif -%}
        </div>

      {%- when 'text' -%}
        <div
          class="rich-text__block"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.text != blank -%}
            <div class="rich-text__rte rte" data-rte>
              {{- block.settings.text -}}
            </div>
          {%- endif -%}
        </div>

      {%- when 'button' -%}
        {%- if block.settings.label != blank or block.settings.link != blank -%}
          <div
            class="rich-text__block"
            {{ block.shopify_attributes }}
          >
            <div class="rich-text__button">
              <a
                class="button-{{ block.settings.style }}"
                href="{{ block.settings.link | default: "#" }}"
                {% if block.settings.link == blank %}
                  style="pointer-events: none;"
                {% endif %}
              >
                {{- block.settings.label | escape -}}
              </a>
            </div>
          </div>
        {%- endif -%}

      {%- when 'image' -%}
        <div
          class="rich-text__block"
          {{ block.shopify_attributes }}
        >
          <div
            class="rich-text__image"
            style="
              --rich-text-image-max-width: {{ block.settings.image_width }}%;
              --rich-text-image-max-width-mobile: {{ block.settings.image_width_mobile }}%;
            "
          >
            {%- if block.settings.image != blank -%}
              {%
                render 'rimg',
                img: block.settings.image,
                class: 'rich-text__image-img',
                size: '1024x',
                lazy: true,
                canvas: true,
                focal_point: block.settings.image.presentation.focal_point,
              %}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder--image rich-text__image-img' }}
            {%- endif -%}
          </div>
        </div>

      {%- when 'icon' -%}
        <div
          class="rich-text__block"
          style="
            --rich-text-icon-width: {{ block.settings.icon_width }}px;
            --rich-text-icon-width-mobile: {{ block.settings.icon_width_mobile }}px;
          "
          {{ block.shopify_attributes }}
        >
          <div class="rich-text__icon">
            {%- render 'icon-library', id: block.settings.icon -%}
          </div>
        </div>
    {%- endcase -%}
  {%- endfor -%}
</section>

