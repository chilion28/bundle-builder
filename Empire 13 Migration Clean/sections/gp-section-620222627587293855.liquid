<script>
(function () {
  if (window.__clRequiredTextValidation) return;
  window.__clRequiredTextValidation = true;

  function findField(labelText) {
    const direct = document.querySelector(
      `input[name="properties[${labelText}]"], textarea[name="properties[${labelText}]"]`
    );
    if (direct) return direct;

    const labels = [...document.querySelectorAll('label, div, p, span')];

    const label = labels.find(el =>
      el.textContent.trim().toLowerCase() === labelText.toLowerCase()
    );

    if (!label) return null;

    const wrapper = label.closest('div');
    return wrapper?.querySelector('input, textarea') ||
           wrapper?.parentElement?.querySelector('input, textarea');
  }

  function clearErrors() {
    document.querySelectorAll('.cl-field-error').forEach(el => el.remove());
    document.querySelectorAll('.cl-input-error').forEach(el => {
      el.classList.remove('cl-input-error');
    });
  }

  function showError(field, message) {
    field.classList.add('cl-input-error');

    const error = document.createElement('div');
    error.className = 'cl-field-error';
    error.textContent = message;

    field.insertAdjacentElement('afterend', error);

    field.scrollIntoView({
      behavior: 'smooth',
      block: 'center'
    });

    setTimeout(() => field.focus(), 300);
  }

  function validatePersonalization() {
    clearErrors();

    const customTextOne = findField('Custom Text');
    const customTextTwo = findField('Custom Text Two');

    if (customTextOne && !customTextOne.value.trim()) {
      showError(customTextOne, 'Please enter Custom Text.');
      return false;
    }

    if (customTextTwo && !customTextTwo.value.trim()) {
      showError(customTextTwo, 'Please enter Custom Text Two.');
      return false;
    }

    return true;
  }

  document.addEventListener('click', function (event) {
    const addBtn = event.target.closest(
      'gp-product-button button[name="add"], .gp-button-atc, button[name="add"], #product-cl-add-cart'
    );

    if (!addBtn) return;

    if (!validatePersonalization()) {
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();
      return false;
    }
  }, true);

  document.addEventListener('submit', function (event) {
    const form = event.target.closest('form[action="/cart/add"]');
    if (!form) return;

    if (!validatePersonalization()) {
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();
      return false;
    }
  }, true);

  document.addEventListener('input', function (event) {
    if (!event.target.matches('input, textarea')) return;
    if (event.target.value.trim()) {
      event.target.classList.remove('cl-input-error');
      event.target.nextElementSibling?.classList.contains('cl-field-error') &&
        event.target.nextElementSibling.remove();
    }
  });
})();
</script>


