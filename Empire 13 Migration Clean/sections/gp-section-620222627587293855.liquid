    <script>
(function () {
  function optimizeProductImages() {
    const images = document.querySelectorAll('img');

    images.forEach((img, index) => {
      img.loading = index < 2 ? 'eager' : 'lazy';
      img.decoding = 'async';

      if (index > 2) {
        img.setAttribute('fetchpriority', 'low');
      } else {
        img.setAttribute('fetchpriority', 'high');
      }
    });
  }

  function refreshSliders() {
    window.dispatchEvent(new Event('resize'));

    if (window.GemPages) {
      window.dispatchEvent(new Event('gp:refresh'));
    }

    document.querySelectorAll('.swiper, .slick-slider, .glide').forEach((slider) => {
      slider.style.opacity = '1';
    });
  }

  window.addEventListener('load', function () {
    optimizeProductImages();

    setTimeout(refreshSliders, 300);
    setTimeout(refreshSliders, 900);
    setTimeout(refreshSliders, 1800);
  });
})();
</script>

<style>
@media screen and (max-width: 767px) {
  .swiper,
  .slick-slider,
  .glide,
  .product-gallery,
  .product__media-list {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  body .swiper.swiper-initialized,
  body .slick-initialized,
  body .glide--swipeable {
    opacity: 1;
  }
}
</style>

<script>
(function () {
  function refreshZepto() {
    window.dispatchEvent(new Event('resize'));
    document.dispatchEvent(new Event('change'));

    const productForm = document.querySelector('form[action*="/cart/add"]');
    if (productForm) {
      productForm.dispatchEvent(new Event('change', { bubbles: true }));
    }

    if (window.ZeptoProductPersonalizer) {
      console.log('Zepto detected');
    }
  }

  window.addEventListener('load', function () {
    setTimeout(refreshZepto, 500);
    setTimeout(refreshZepto, 1500);
    setTimeout(refreshZepto, 3000);
  });
})();
</script>

