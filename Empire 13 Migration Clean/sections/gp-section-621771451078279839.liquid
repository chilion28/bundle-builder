   .cl-color-swatch {
  position: relative;
}

/* Tooltip bubble */
.cl-color-swatch:hover::after {
  content: attr(data-tooltip);

  position: absolute;
  bottom: calc(100% + 10px);
  left: 50%;
  transform: translateX(-50%);

  background: #111;
  color: #fff;

  padding: 6px 10px;
  border-radius: 6px;

  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;

  z-index: 9999;

  box-shadow: 0 4px 12px rgba(0,0,0,.2);
}

/* Tooltip arrow */
.cl-color-swatch:hover::before {
  content: "";

  position: absolute;
  bottom: calc(100% + 4px);
  left: 50%;
