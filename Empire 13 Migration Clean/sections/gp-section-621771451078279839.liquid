<script>
(function () {
  if (window.__CL_CONFIGURATOR_FINAL_V1) return;
  window.__CL_CONFIGURATOR_FINAL_V1 = true;

  const CL = {
    selectors: {
      form: 'form[action*="/cart/add"]',
      productData: 'gp-product-images-v3[gp-data]',
      styleSelect: 'select[option-data="Style"]',
      colorInput: '[option-data="Color"][option-value]',
      productButton: 'gp-product-button'
    },

    styleMeta: {
      'Snapback': {
        desc: 'Flat brim, classic fit',
        badge: '★ Most Popular',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/Snapback_liner.svg?v=1777580563'
      },
      'Trucker': {
        desc: 'Mesh back, breathable',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/trucker_lineart.svg?v=1778615583'
      },
      'Pro Five A Frame': {
        desc: 'Higher crown, structured',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/a-frame-lineart.svg?v=1779899012'
      },
      'Flex Fit': {
        desc: 'Stretch fit, one size',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/Flexfit.svg?v=1778615663'
      },
      'Signature Series': {
        desc: 'Premium specialty styles',
        img: 'https://cdn.shopify.com/s/files/1/0519/6401/files/Snapback_liner.svg?v=1777580563'
      }
    },

    defaults: {
      'Snapback': 'Black',
      'Trucker': 'Black TR'
    },

    clean(value) {
      return String(value || '').trim();
    },

    variants() {
      const el = document.querySelector(this.selectors.productData);
      if (!el) return [];

      try {
        return JSON.parse(el.getAttribute('gp-data')).product.variants || [];
      } catch (e) {
        console.warn('[CL] Variant JSON failed', e);
        return [];
      }
    },

    color(variant) {
      return this.clean(variant.option2);
    },

    image(variant) {
  let src =
    variant?.featured_image?.src ||
    variant?.featured_media?.preview_image?.src ||
    variant?.image?.src ||
    variant?.image ||
    '';

  src = String(src || '').trim();

  if (!src || src === 'null' || src === 'undefined') return '';

  src = src.replace(/&amp;/g, '&');

  if (src.startsWith('//')) src = 'https:' + src;
  if (src.startsWith('/cdn/')) src = 'https://citylocs.com' + src;

  return src;
}
  };

  let currentVariant = null;
  let swatchMap = {};

  function trigger(el) {
    if (!el) return;
    el.dispatchEvent(new Event('input', { bubbles: true }));
    el.dispatchEvent(new Event('change', { bubbles: true }));
  }

  function variantsByStyle(style) {
    return CL.variants().filter(v => v.option1 === style);
  }

  function findVariant(style, color) {
    return variantsByStyle(style).find(v => CL.color(v) === CL.clean(color));
  }

  function firstVariant(style) {
    const preferred = CL.defaults[style];

    if (preferred) {
      const found = findVariant(style, preferred);
      if (found) return found;
    }

    const list = variantsByStyle(style);
    return list.find(v => v.available !== false) || list[0] || null;
  }

  function captureSwatches() {
    document.querySelectorAll(CL.selectors.colorInput).forEach(input => {
      const color = CL.clean(input.getAttribute('option-value'));
      const label = input.closest('label.option-item') || input.closest('label');
      const img = input.querySelector('img')?.src || label?.querySelector('img')?.src || '';

      if (color && img) swatchMap[color] = img;
    });
  }

function buildGallery() {
  let gallery = document.querySelector('.cl-custom-product-gallery');

  if (!gallery) {
    const target =
      document.querySelector('gp-product-images-v3') ||
      document.querySelector('.gckYyx4CKX') ||
      document.querySelector('.gT8QUGgXcO');

    if (!target) return;

    gallery = document.createElement('div');
    gallery.className = 'cl-custom-product-gallery';

    const img = document.createElement('img');
    img.className = 'cl-custom-product-gallery__img';
    img.alt = 'Selected hat variant';
    img.loading = 'eager';
    img.decoding = 'async';
    img.setAttribute('fetchpriority', 'high');

    gallery.appendChild(img);
    target.insertAdjacentElement('beforebegin', gallery);

    const oldGallery = document.querySelector('gp-product-images-v3');
    if (oldGallery) oldGallery.style.display = 'none';
  }

  if (!gallery.querySelector('.cl-custom-product-gallery__img')) {
    const img = document.createElement('img');
    img.className = 'cl-custom-product-gallery__img';
    img.alt = 'Selected hat variant';
    gallery.appendChild(img);
  }
}

function updateGallery(variant) {
  buildGallery();

  const img = document.querySelector('.cl-custom-product-gallery__img');
  if (!img || !variant) return;

  let src = CL.image(variant);

  if (!src) {
    src = document.querySelector('meta[property="og:image"]')?.content || '';
  }

  src = String(src || '').trim();

  if (!src || src === 'null' || src === 'undefined') return;

  if (src.startsWith('//')) src = 'https:' + src;

  img.removeAttribute('srcset');
  img.src = src;
  img.alt = variant.public_title || variant.title || 'Selected hat variant';
  img.style.display = 'block';

  img.onerror = function () {
    console.warn('[CL] Broken gallery image:', src, variant);
    this.src = document.querySelector('meta[property="og:image"]')?.content || '';
  };
}

  function buildCards() {
    const styleSelect = document.querySelector(CL.selectors.styleSelect);
    if (!styleSelect) return;

    const styleBlock = styleSelect.closest('[option-name="Style"]') || styleSelect.parentElement;
    if (!styleBlock) return;

    document.querySelectorAll('.cl-style-slider-wrap').forEach(el => el.remove());

    const wrapper = document.createElement('div');
    wrapper.className = 'cl-style-slider-wrap';
    wrapper.innerHTML = `
      <h3 class="cl-style-slider-title">Choose Your Hat Style</h3>
      <div class="cl-style-slider"></div>
    `;

    const slider = wrapper.querySelector('.cl-style-slider');

    [...styleSelect.options].forEach(option => {
      if (!option.value) return;

      const style = option.value;
      const meta = CL.styleMeta[style] || {};

      const card = document.createElement('button');
      card.type = 'button';
      card.className = 'cl-style-card';
      card.dataset.styleValue = style;

      card.innerHTML = `
        ${meta.badge ? `<div class="cl-style-card__badge">${meta.badge}</div>` : ''}
        ${meta.img ? `<img class="cl-style-card__image" src="${meta.img}" alt="${style}">` : ''}
        <div class="cl-style-card__title">${style}</div>
        <div class="cl-style-card__desc">${meta.desc || ''}</div>
      `;

      card.addEventListener('click', function () {
        applyVariant(firstVariant(style));
      });

      slider.appendChild(card);
    });

    styleBlock.insertAdjacentElement('beforebegin', wrapper);
  }

  function buildColorPicker() {
    document.querySelectorAll('.cl-color-picker').forEach(el => el.remove());

    const styleWrap = document.querySelector('.cl-style-slider-wrap');
    const buttonWrap = document.querySelector(CL.selectors.productButton);

    const picker = document.createElement('div');
    picker.className = 'cl-color-picker';
    picker.innerHTML = `
      <div class="cl-color-picker__label">Color: <span data-cl-color-label></span></div>
      <div class="cl-color-picker__swatches"></div>
    `;

    if (styleWrap) {
      styleWrap.insertAdjacentElement('afterend', picker);
    } else if (buttonWrap) {
      buttonWrap.insertAdjacentElement('beforebegin', picker);
    }
  }

  function renderColors(variant) {
    const wrap = document.querySelector('.cl-color-picker__swatches');
    const label = document.querySelector('[data-cl-color-label]');
    if (!wrap || !variant) return;

    wrap.innerHTML = '';

    const activeColor = CL.color(variant);
    const seen = new Set();

    variantsByStyle(variant.option1).forEach(v => {
      const color = CL.color(v);
      if (!color || seen.has(color)) return;

      seen.add(color);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cl-color-swatch';
      btn.removeAttribute('title');
      btn.setAttribute('aria-label', `${variant.option1} / ${color}`);
      btn.setAttribute('data-tooltip', `${variant.option1} / ${color}`);

      const img = swatchMap[color] || CL.image(v);
      if (img) btn.style.backgroundImage = `url("${img}")`;

      if (color === activeColor) btn.classList.add('is-active');

      btn.addEventListener('click', function () {
        applyVariant(findVariant(variant.option1, color));
      });

      wrap.appendChild(btn);
    });

    if (label) label.textContent = activeColor;
  }

  function setVariantId(variant) {
  const styleSelect = document.querySelector(CL.selectors.styleSelect);

  if (styleSelect) {
    styleSelect.value = variant.option1;
    /* Do NOT trigger styleSelect change. GemPages disables ATC again. */
  }

  document.querySelectorAll(CL.selectors.form).forEach(form => {
    const input = form.querySelector('input[name="id"]');
    if (!input) return;

    input.value = variant.id;
    trigger(input);
  });

  forceEnableATC(variant);

  [150, 400, 800, 1300].forEach(delay => {
    setTimeout(() => {
      forceEnableATC(variant);
    }, delay);
  });

  const url = new URL(window.location.href);
  url.searchParams.set('variant', variant.id);
  window.history.replaceState({}, '', url.toString());
}

function forceEnableATC(variant) {
  document.querySelectorAll(CL.selectors.productButton).forEach(wrap => {
  wrap.setAttribute('variant-id', String(variant.id));

  wrap.querySelectorAll('button, [role="button"], .button-primary').forEach(btn => {
    btn.disabled = false;
    btn.removeAttribute('disabled');
    btn.removeAttribute('aria-disabled');
    btn.removeAttribute('data-disabled');

    btn.classList.remove(
      'disabled',
      'is-disabled',
      'sold-out',
      'out-of-stock',
      'gp-opacity-30',
      'gp-cursor-not-allowed',
      'gp-pointer-events-none',
      'gp-text-g-text-3'
    );

    btn.classList.add('gp-opacity-100');
    btn.style.opacity = '1';
    btn.style.pointerEvents = 'auto';
    btn.style.cursor = 'pointer';

    if (/out of stock|sold out|unavailable/i.test(btn.textContent)) {
      btn.textContent = 'Add to cart';
    }
  });
});
}

  function updateCards(style) {
    document.querySelectorAll('.cl-style-card').forEach(card => {
      card.classList.toggle('is-active', card.dataset.styleValue === style);
    });
  }

  function applyVariant(variant) {
    if (!variant) return;

    currentVariant = variant;

    renderColors(variant);
    setVariantId(variant);
    updateGallery(variant);
    updateCards(variant.option1);

    setTimeout(function () {
      if (!currentVariant) return;
      setVariantId(currentVariant);
    }, 250);
  }

  function ready(callback) {
    let tries = 0;

    const timer = setInterval(function () {
      tries++;

      if (
        document.querySelector(CL.selectors.productData) &&
        document.querySelector(CL.selectors.styleSelect) &&
        document.querySelector(CL.selectors.form)
      ) {
        clearInterval(timer);
        callback();
      }

      if (tries > 80) clearInterval(timer);
    }, 250);
  }

  ready(function () {
    captureSwatches();
    buildGallery();
    buildCards();
    buildColorPicker();

    applyVariant(
      findVariant('Snapback', 'Black') ||
      firstVariant('Snapback')
    );
    
    [500, 1200, 2200, 3500].forEach(function (delay) {
  setTimeout(function () {
