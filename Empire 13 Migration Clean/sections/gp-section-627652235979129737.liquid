      <script id="custom-js-ggoCYFrWYO">
        try {
          document.addEventListener('DOMContentLoaded', function () {
  const states = [
    { name: 'Alabama', url: '/collections/alabama-plate-hat' },
    { name: 'Alaska', url: '/collections/alaska-plate-hat' },
    { name: 'Arizona', url: '/collections/arizona-plate-hat' },
    { name: 'Arkansas', url: '/collections/arkansas-plate-hat' },
    { name: 'California', url: '/collections/california-plate-hat' },
    { name: 'Colorado', url: '/collections/colorado-plate-hat' },
    { name: 'Connecticut', url: '/collections/connecticut-plate-hat' },
    { name: 'Delaware', url: '/collections/delaware-plate-hat' },
    { name: 'Florida', url: '/collections/florida-plate-hat' },
    { name: 'Georgia', url: '/collections/georgia-plate-hat' },
    { name: 'Hawaii', url: '/collections/hawaii-plate-hat' },
    { name: 'Idaho', url: '/collections/idaho-plate-hat' },
    { name: 'Illinois', url: '/collections/illinois-plate-hat' },
    { name: 'Indiana', url: '/collections/indiana-plate-hat' },
    { name: 'Iowa', url: '/collections/iowa-plate-hat' },
    { name: 'Kansas', url: '/collections/kansas-plate-hat' },
    { name: 'Kentucky', url: '/collections/kentucky-plate-hat' },
    { name: 'Louisiana', url: '/collections/louisiana-plate-hat' },
    { name: 'Maine', url: '/collections/maine-plate-hat' },
    { name: 'Maryland', url: '/collections/maryland-plate-hat' },
    { name: 'Massachusetts', url: '/collections/massachusetts-plate-hat' },
    { name: 'Michigan', url: '/collections/michigan-plate-hat' },
    { name: 'Minnesota', url: '/collections/minnesota-plate-hat' },
    { name: 'Mississippi', url: '/collections/mississippi-plate-hat' },
    { name: 'Missouri', url: '/collections/missouri-plate-hat' },
    { name: 'Montana', url: '/collections/montana-plate-hat' },
    { name: 'Nebraska', url: '/collections/nebraska-plate-hat' },
    { name: 'Nevada', url: '/collections/nevada-plate-hat' },
    { name: 'New Hampshire', url: '/collections/new-hampshire-plate-hat' },
    { name: 'New Jersey', url: '/collections/new-jersey-plate-hat' },
    { name: 'New Mexico', url: '/collections/new-mexico-plate-hat' },
    { name: 'New York', url: '/collections/new-york-plate-hat' },
    { name: 'North Carolina', url: '/collections/north-carolina-plate-hat' },
    { name: 'North Dakota', url: '/collections/north-dakota-plate-hat' },
    { name: 'Ohio', url: '/collections/ohio-plate-hat' },
    { name: 'Oklahoma', url: '/collections/oklahoma-plate-hat' },
    { name: 'Oregon', url: '/collections/oregon-plate-hat' },
    { name: 'Pennsylvania', url: '/collections/pennsylvania-plate-hat' },
    { name: 'Rhode Island', url: '/collections/rhode-island-plate-hat' },
    { name: 'South Carolina', url: '/collections/south-carolina-plate-hat' },
    { name: 'South Dakota', url: '/collections/south-dakota-plate-hat' },
    { name: 'Tennessee', url: '/collections/tennessee-plate-hat' },
    { name: 'Texas', url: '/collections/texas-plate-hat' },
    { name: 'Utah', url: '/collections/utah-plate-hat' },
    { name: 'Vermont', url: '/collections/vermont-plate-hat' },
    { name: 'Virginia', url: '/collections/virginia-plate-hat' },
    { name: 'Washington', url: '/collections/washington-plate-hat' },
    { name: 'Washington DC', url: '/collections/washington-dc-plate-hat' },
    { name: 'West Virginia', url: '/collections/west-virginia-plate-hat' },
    { name: 'Wisconsin', url: '/collections/wisconsin-plate-hat' },
    { name: 'Wyoming', url: '/collections/wyoming-plate-hat' }
  ];

   const wrap = document.querySelector('.state-search-wrap');
  const box = document.querySelector('.state-search-box');
  const input = document.getElementById('stateSearch');
  const list = document.getElementById('stateList');

  let activeIndex = 0;

  function escapeRegExp(text) {
    return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function highlightMatch(name, query) {
    if (!query) return name;

    const regex = new RegExp(`(${escapeRegExp(query)})`, 'ig');
    return name.replace(regex, '<mark>$1</mark>');
  }

  function renderStates(filter = '') {

    const filtered = states.filter(state =>
      state.name.toLowerCase().includes(filter.toLowerCase())
    );

    list.innerHTML = filtered.length
      ? filtered.map((state, index) =>
          `<li class="${index === 0 ? 'is-highlighted' : ''}" data-url="${state.url}">
            ${highlightMatch(state.name, filter)}
          </li>`
        ).join('')
      : `<li class="state-empty">No states found</li>`;

    activeIndex = 0;
  }

  function openList() {

    wrap.classList.add('is-active');

    renderStates(input.value);

    list.classList.add('is-open');

    setTimeout(() => {
      wrap.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });
    }, 50);
  }

  function closeList() {

    wrap.classList.remove('is-active');

    list.classList.remove('is-open');
  }

  function selectItem(item) {

    if (!item || item.classList.contains('state-empty')) return;

    input.value = item.textContent;

    closeList();

    window.location.href = item.dataset.url;
  }

  /* ENTIRE BOX CLICKABLE */
  box.addEventListener('click', function () {

    input.focus();

    openList();
  });

  input.addEventListener('input', function () {

    openList();
  });

  input.addEventListener('keydown', function (e) {

    const items = list.querySelectorAll('li:not(.state-empty)');

    if (!items.length) return;

    if (e.key === 'ArrowDown') {

      e.preventDefault();

      activeIndex = Math.min(activeIndex + 1, items.length - 1);
    }

    if (e.key === 'ArrowUp') {

      e.preventDefault();

      activeIndex = Math.max(activeIndex - 1, 0);
    }

    if (e.key === 'Enter') {

      e.preventDefault();

      selectItem(items[activeIndex]);

      return;
    }

    items.forEach(item => item.classList.remove('is-highlighted'));

    if (items[activeIndex]) {

      items[activeIndex].classList.add('is-highlighted');

      items[activeIndex].scrollIntoView({
        block: 'nearest'
      });
    }
  });

  list.addEventListener('click', function (e) {

    const item = e.target.closest('li');

    selectItem(item);
  });

  document.addEventListener('click', function (e) {

    if (!wrap.contains(e.target)) {

      closeList();
    }
  });

});
        } catch(err){}
