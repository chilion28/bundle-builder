  flex-shrink: 0;
  background-image: url("data:image/svg+xml,%3Csvg width='16' height='10' viewBox='0 0 20 12' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 2L10 10L18 2' stroke='%23000' stroke-width='2'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  transition: transform 0.25s ease;
}

.state-search-wrap.is-active .state-arrow {
  transform: rotate(-90deg);
