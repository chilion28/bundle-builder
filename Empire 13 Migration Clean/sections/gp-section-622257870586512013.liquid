<script>
document.addEventListener('DOMContentLoaded', function () {
  const bundleCards = [
    {
      selector: '.gnb4qrJspA',
      url: 'https://citylocs.com/products/dope-dad-bundle'
    },
    {
      selector: '.gstIm8LFPn',
      url: 'https://citylocs.com/products/cool-dad-bundle'
    },
    {
      selector: '.gr79jIsYbA',
      url: 'https://citylocs.com/products/dad-life-bundle'
    }
  ];

  bundleCards.forEach(function (item) {
    const card = document.querySelector(item.selector);
    if (!card) return;

    card.setAttribute('role', 'link');
    card.setAttribute('tabindex', '0');

    card.addEventListener('click', function (event) {
      if (event.target.closest('a, button')) return;
      window.location.href = item.url;
    });

    card.addEventListener('keydown', function (event) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        window.location.href = item.url;
      }
    });
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const marquee = document.querySelector('#g5B1JlYHIZ');
  if (!marquee) return;

  const isMobile = window.matchMedia('(max-width: 767px)').matches;

  if (!isMobile) {
    marquee.querySelectorAll('[data-marquee-clone="true"]').forEach(function (clone) {
      clone.remove();
    });
    marquee.dataset.marqueeCloned = 'false';
    return;
  }

  if (marquee.dataset.marqueeCloned === 'true') return;

  const items = Array.from(marquee.children);

  items.forEach(function (item) {
    const clone = item.cloneNode(true);
    clone.setAttribute('aria-hidden', 'true');
    clone.setAttribute('data-marquee-clone', 'true');
    marquee.appendChild(clone);
  });

  marquee.dataset.marqueeCloned = 'true';
});
</script>
