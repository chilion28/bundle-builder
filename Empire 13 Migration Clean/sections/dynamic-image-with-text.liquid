{% assign base_name = 'image-with-text' %}
{% assign section_classes = "home-section--content" %}
{% assign section_heading = section.settings.section_heading %}
{% if section_heading == blank %}
  {% assign section_classes = section_classes | append: " no-section-heading" %}
{% endif %}
{% capture section_styles %}--image-with-text-desktop-width: {{ section.settings.desktop_width | default: 50 }}%;{% endcapture %}

<script type="application/pxs-animation-mapping+json">
  {
    "blocks": [".image-with-text"],
    "elements": [".image-with-text__block"]
  }
</script>

{% capture content_image %}
  {% render 'kit.pxu-image-with-text.image',
    base_name: base_name,
    image: section.settings.image
  %}
{% endcapture %}

{% capture content_text %}
  {% for block in section.blocks %}
    {% case block.type %}
      {% when "heading" %}
        <div class="image-with-text__block" {{ block.shopify_attributes }}>
          {% render 'kit.pxu-image-with-text.heading',
            base_name: base_name,
            heading: block.settings.text,
            heading_size: block.settings.heading_size
          %}
        </div>
      {% when "text" %}
        <div class="image-with-text__block" {{ block.shopify_attributes }}>
          {% render 'kit.pxu-image-with-text.text',
            base_name: base_name,
            subheading: block.settings.richtext
          %}
        </div>
      {% when "button" %}
        <div class="image-with-text__block" {{ block.shopify_attributes }}>
          {% render 'kit.pxu-image-with-text.button',
            base_name: base_name,
            button_label: block.settings.button_label,
            button_link: block.settings.button_link,
            button_style: block.settings.button_style
          %}
        </div>
      {% when "icon" %}
        <div class="image-with-text__block" {{ block.shopify_attributes }}>
          <div
            class="image-with-text__icon"
            style="
              --image-with-text-icon-width: {{ block.settings.icon_width | default: 46 }}px;
              --image-with-text-icon-width-mobile: {{ block.settings.icon_width_mobile | default: 36 }}px;
            "
          >
            {%- render 'icon-library', id: block.settings.icon -%}
          </div>
        </div>
    {% endcase %}
  {% endfor %}
{% endcapture %}

{% render 'kit.pxu-image-with-text',
  section: section,
  base_name: base_name,
  section_classes: section_classes,
  section_styles: section_styles,
  section_heading: section_heading,
  desktop_height: section.settings.desktop_height,
  mobile_height: section.settings.mobile_height,
  desktop_image_alignment: section.settings.desktop_image_alignment,
  mobile_image_alignment: section.settings.mobile_image_alignment,
  text_alignment: section.settings.text_alignment,
  content_image: content_image,
  content_text: content_text
%}

