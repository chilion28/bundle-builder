<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="static-announcement">
</script>

{% assign show_everywhere = false %}
{% assign homepage_only = false %}

{% if section.settings.show_announcement and section.settings.homepage_announcement == false %}
  {% assign show_everywhere = true %}
{% endif %}

{% if section.settings.show_announcement and section.settings.homepage_announcement and template == 'index' %}
  {% assign homepage_only = true %}
{% endif %}

{% if show_everywhere or homepage_only %}
  {% if section.settings.announcement_text != blank or section.settings.announcement_text_mobile != blank %}
    <div
      class="
        announcement-bar
        {% if section.settings.announcement_text == blank and section.settings.announcement_text_mobile != blank %}
          only-mobile
        {% endif %}
        {% if section.settings.enable_countdown %}
          announcement-bar--countdown
        {% endif %}
      "
      style="
        color: {{ section.settings.announcement_color }};
        background: {{ section.settings.announcement_background }};
      ">

      {% if section.settings.announcement_link != blank %}
        <a
          class="announcement-bar-link"
          href="{{ section.settings.announcement_link }}"
          aria-label="Announcement link"
        ></a>
      {% endif %}

      <div class="announcement-bar__inner">
        {% if section.settings.announcement_text != blank %}
          <div class="announcement-bar-text">
            {{ section.settings.announcement_text }}
          </div>
        {% endif %}

        <div class="announcement-bar-text-mobile">
          {% if section.settings.announcement_text_mobile != blank %}
            {{ section.settings.announcement_text_mobile }}
          {% else %}
            {{ section.settings.announcement_text }}
          {% endif %}
        </div>

        {% if section.settings.enable_countdown and section.settings.countdown_deadline != blank %}
          <div
            class="cl-announcement-countdown"
            data-cl-announcement-countdown
            data-deadline="{{ section.settings.countdown_deadline | escape }}"
          >
            <div class="cl-countdown-box">
              <strong data-days>00</strong>
              <span>Day</span>
            </div>
            <div class="cl-countdown-box">
              <strong data-hours>00</strong>
              <span>Hour</span>
            </div>
            <div class="cl-countdown-box">
              <strong data-minutes>00</strong>
              <span>Minute</span>
            </div>
            <div class="cl-countdown-box">
              <strong data-seconds>00</strong>
              <span>Second</span>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endif %}

<style>
  .announcement-bar--countdown {
    border-bottom:1px solid #191919;
    position: relative;
    padding:0;
  }

  .announcement-bar--countdown .announcement-bar__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 8px 24px;
     display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin: 0 auto;
  width: fit-content;
  }

  .announcement-bar--countdown .announcement-bar-text {
    font-size: 20px;
    font-weight:600;
    line-height: 1.4;
    flex: 0 0 auto;
    margin: 0;
  }

  .announcement-bar--countdown .announcement-bar-text-mobile {
    display: none;
  }

  .cl-announcement-countdown {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
     flex: 0 0 auto;
  }

  .cl-countdown-box {
    min-width: 58px;
    padding: 6px 8px;
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 8px;
    text-align: center;
    background: rgba(255, 255, 255, 1);
  }

  .cl-countdown-box strong {
    display: block;
    font-size: 16px;
    line-height: 1;
    font-weight: 800;
    margin-bottom: 8px;
    color:#1d1d1d !important;
  }

  .cl-countdown-box span {
    color:#1d1d1d !important;
    display: block;
    font-size: 11px;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .announcement-bar--countdown .announcement-bar__inner {
      padding: 12px 14px;
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }

    .announcement-bar--countdown .announcement-bar-text {
      display: none;
    }

    .announcement-bar--countdown .announcement-bar-text-mobile {
      display: block;
      font-size: 14px;
      line-height: 1.4;
    }

    .cl-announcement-countdown {
      gap: 8px;
    }

    .cl-countdown-box {
      min-width: 62px;
      padding: 8px 6px;
    }

    .cl-countdown-box strong {
      font-size: 16px;
    }

    .cl-countdown-box span {
      font-size: 11px;
    }
  }
</style>

<script>
  (() => {
    const timers = document.querySelectorAll('[data-cl-announcement-countdown]');
    if (!timers.length) return;

    timers.forEach(timer => {
      if (timer.dataset.initialized === 'true') return;
      timer.dataset.initialized = 'true';

      const deadlineRaw = timer.dataset.deadline;
      const deadline = new Date(deadlineRaw).getTime();

      if (Number.isNaN(deadline)) return;

      const daysEl = timer.querySelector('[data-days]');
      const hoursEl = timer.querySelector('[data-hours]');
      const minutesEl = timer.querySelector('[data-minutes]');
      const secondsEl = timer.querySelector('[data-seconds]');

      function pad(num) {
        return String(num).padStart(2, '0');
      }

      function updateCountdown() {
        const now = new Date().getTime();
        const distance = deadline - now;

        if (distance <= 0) {
          daysEl.textContent = '00';
          hoursEl.textContent = '00';
          minutesEl.textContent = '00';
          secondsEl.textContent = '00';
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((distance / (1000 * 60)) % 60);
        const seconds = Math.floor((distance / 1000) % 60);

        daysEl.textContent = pad(days);
        hoursEl.textContent = pad(hours);
        minutesEl.textContent = pad(minutes);
        secondsEl.textContent = pad(seconds);
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);
    });
  })();
</script>

