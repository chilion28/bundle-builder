<script>
  (() => {
    let isManualMenuOpen = false;
    let isBound = false;

    function getEls() {
      return {
        header: document.querySelector('.site-header'),
        toggle: document.querySelector('.site-header-menu-toggle'),
        nav: document.querySelector('.site-navigation-wrapper'),
        bar: document.querySelector('#shopify-section-cl-countdown-announcement .announcement-bar')
      };
    }

    function setStickyHeights() {
      const { header, bar } = getEls();

      document.documentElement.style.setProperty(
        '--cl-countdown-sticky-height',
        `${bar ? Math.round(bar.getBoundingClientRect().height) : 0}px`
      );

      document.documentElement.style.setProperty(
        '--cl-header-sticky-height',
        `${header ? Math.round(header.getBoundingClientRect().height) : 0}px`
      );
    }

    function syncHomeSticky() {
      if (!document.body.classList.contains('template-index')) return;

      const { header, toggle, nav } = getEls();
      if (!header || !nav) return;

      const isActive = window.scrollY > 5;

      if (!isActive) isManualMenuOpen = false;

      document.body.classList.toggle('cl-home-sticky-active', isActive);
      document.body.classList.toggle('cl-home-menu-open', isActive && isManualMenuOpen);
      header.classList.toggle('site-header-sticky--scrolled', isActive);

      if (!isActive) nav.style.display = '';

      if (toggle) {
        toggle.classList.toggle('active', isActive && isManualMenuOpen);
        toggle.setAttribute('aria-expanded', isActive && isManualMenuOpen ? 'true' : 'false');
      }
    }

    function initStickyFix() {
      const { toggle } = getEls();

      setStickyHeights();
      syncHomeSticky();

      if (toggle && !isBound) {
        isBound = true;

        toggle.addEventListener('click', () => {
          if (!document.body.classList.contains('cl-home-sticky-active')) return;

          isManualMenuOpen = !isManualMenuOpen;

          requestAnimationFrame(syncHomeSticky);
          setTimeout(syncHomeSticky, 50);
          setTimeout(syncHomeSticky, 150);
        });
      }
    }

    document.addEventListener('DOMContentLoaded', initStickyFix);
    window.addEventListener('load', initStickyFix);
    window.addEventListener('scroll', syncHomeSticky, { passive: true });
    window.addEventListener('resize', () => {
      setStickyHeights();
      syncHomeSticky();
    });

    setTimeout(initStickyFix, 250);
  })();
</script>

