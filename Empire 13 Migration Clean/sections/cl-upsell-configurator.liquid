    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow text", "default": "The more you stack, the less you pay" },
    { "type": "text", "id": "item_singular", "label": "Item noun (singular)", "default": "hat" },
    { "type": "text", "id": "item_plural", "label": "Item noun (plural)", "default": "hats" },
    { "type": "header", "content": "Product header" },
    { "type": "text", "id": "pills", "label": "Category pills (comma-separated)", "info": "e.g. California Classics, Custom Printed. Falls back to the product type if blank." },
    { "type": "checkbox", "id": "show_rating", "label": "Show Loox rating widget", "default": true },

    { "type": "header", "content": "Description hero" },
    { "type": "checkbox", "id": "desc_dark", "label": "Dark background", "default": true },
    { "type": "text", "id": "desc_eyebrow", "label": "Eyebrow", "default": "Flaunt your state pride" },
    { "type": "text", "id": "desc_heading", "label": "Heading", "default": "Built to turn heads" },
    { "type": "richtext", "id": "desc_body", "label": "Body", "info": "Per-product override: metafield custom.short_description (or custom.plate_description)", "default": "<p>Designed to resemble the most iconic license plates your home state has to offer. Personalized with your nickname, club name, or company name — these are uniquely yours.</p>" },

    { "type": "header", "content": "Customization card" },
    { "type": "checkbox", "id": "show_customization", "label": "Show card", "default": true },
    { "type": "text", "id": "cust_heading", "label": "Heading", "default": "Customization" },
    { "type": "text", "id": "cust1_max", "label": "Custom Text 1 max letters", "info": "Per-product override: metafield custom.custom_text_1_max", "default": "20" },
    { "type": "text", "id": "cust2_max", "label": "Custom Text 2 max letters", "info": "Per-product override: metafield custom.custom_text_2_max", "default": "26" },
    { "type": "text", "id": "cust_tip", "label": "Tip", "default": "Fewer letters = a more authentic plate look." },

    { "type": "header", "content": "The Patch card" },
    { "type": "checkbox", "id": "show_patch", "label": "Show card", "default": true },
    { "type": "text", "id": "patch_heading", "label": "Heading", "default": "The Patch" },
    { "type": "textarea", "id": "patch_lines", "label": "Details (one per line)", "default": "UV ink printed on genuine leather\nPlate patch measures 4 × 2¼\"\nAttached with high-quality rivets" },

    { "type": "header", "content": "Hat specifications (per style)" },
    { "type": "checkbox", "id": "show_specs", "label": "Show specifications", "default": true, "info": "Each column uses the per-style metafield if set, otherwise the default below. First line = intro, following lines = bullets." },
    { "type": "text", "id": "specs_heading", "label": "Heading", "default": "Hat Specifications" },
    { "type": "textarea", "id": "spec_snapback", "label": "Snapback default", "default": "ADJUSTABLE SNAPBACK\nVisor: Flat Bill, Green Bottom\nProfile: High\nCrown: 3 3/4\"\nPanels: 6" },
    { "type": "textarea", "id": "spec_trucker", "label": "Trucker default", "default": "TRUCKER SNAPBACK\nVisor: Curved, Single Color\nProfile: Medium\nCrown: 3 1/2\"\nPanels: 5" },
    { "type": "textarea", "id": "spec_profive", "label": "Pro Five A Frame default", "default": "Pro Five A-Frame\nVisor: Flat Bill, Green Bottom\nProfile: High\nCrown: 3 3/4\"\nPanels: 6" },
    { "type": "textarea", "id": "spec_flexfit", "label": "Flex Fit default", "default": "FLEXFIT (Fitted)\nVisor: Flat Bill, Single Color\nProfile: High\nCrown: 3 3/4\"\nPanels: 6" },
    { "type": "textarea", "id": "spec_signature", "label": "Signature Series default", "default": "Signature Series\nVisor: Flat Bill, Green Bottom\nProfile: High\nCrown: 3 3/4\"\nPanels: 6" },

    { "type": "header", "content": "Full product details" },
    { "type": "checkbox", "id": "show_full_details", "label": "Show collapsible full description", "default": true },
    { "type": "text", "id": "details_label", "label": "Toggle label", "default": "Full product details & specifications" },

    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show Loox reviews widget", "default": true }
  ],
  "presets": [{ "name": "Upsell Configurator" }]
}
