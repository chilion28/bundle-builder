      <script id="custom-js-gBZhtwRF4E">
        try {
          (function () {
  function initVideoFormValidation() {
    const form = document.querySelector('#contact_form_gnEu3sUr2A');
    if (!form || form.dataset.videoValidationReady === 'true') return;

    form.dataset.videoValidationReady = 'true';

    const phone = form.querySelector('input[name="contact[phone]"]');
    const link = form.querySelector('input[name="contact[link]"]');
    const social = form.querySelector('input[name="contact[socials]"]');
    const consent = form.querySelector('input[name="contact[agree]"]');

    if (consent) consent.checked = false;

    form.addEventListener('submit', function (e) {
      const errors = [];

      if (link && link.value.trim()) {
        try {
          const url = new URL(link.value.trim());
          if (!['http:', 'https:'].includes(url.protocol)) throw new Error();
        } catch {
          errors.push('Please enter a valid video link starting with https://');
        }
      }

      if (phone && phone.value.trim() && !/^[0-9+\-().\s]{7,20}$/.test(phone.value.trim())) {
        errors.push('Please enter a valid phone number.');
      }

      if (social && social.value.trim() && !/^@?[A-Za-z0-9._]{2,30}$/.test(social.value.trim())) {
        errors.push('Please enter a valid social media handle.');
      }

      if (consent && !consent.checked) {
        errors.push('Please confirm permission before submitting.');
      }

      if (errors.length) {
        e.preventDefault();
        e.stopImmediatePropagation();
        alert(errors.join('\n'));
      }
    }, true);
  }

  initVideoFormValidation();
  setTimeout(initVideoFormValidation, 500);
  setTimeout(initVideoFormValidation, 1500);
})();
        } catch(err){}
      </script>
