  Copyright © 2025 Archetype Themes LP. All rights reserved.

  Renders the product details and form for the product.

  This component displays the product details and form for the product.
  It includes the product title, vendor, price, installments, variant picker,
  quantity picker, gift recipient, buy buttons, policies, pick up, and description.

  @param {object} product - A product object
  @param {string} [slot_gallery] - The slot for the gallery
  @param {string} [slot_details] - The slot for the details
  @param {string} [slot_description] - The slot for the description
  @param {boolean} [description_in_gallery] - Whether to render the description under the gallery
  @param {string} [color_scheme] - The color scheme to apply to the section
  @param {string} [padding] ('top', 'bottom', 'both', 'none') - The padding to apply to the section

  @example
  {% render 'section.flex-pdp', product: product, color_scheme: 'none', padding: 'both' %}
{% enddoc %}


{%- liquid
  # The high-variant template renders this snippet from a section block, where
  # Shopify exposes the current product as closest.product rather than an
  # explicit render argument.
  assign product = product | default: closest.product
  assign color_scheme = color_scheme | default: section.settings.color_scheme | default: 'none'
  assign padding = padding | default: section.settings.padding | default: 'none'
  assign form_id = 'section.flex-pdp.form-' | append: section.id
  assign description_in_gallery = description_in_gallery | default: false
  assign is_cl_combined_listing = false
  assign has_cl_state = false
  assign has_cl_design = false
  for product_option in product.options_with_values
    assign product_option_name = product_option.name | strip | downcase
    if product_option_name == 'select state'
      assign has_cl_state = true
    elsif product_option_name == 'select design'
      assign has_cl_design = true
    endif
  endfor
  # A state-specific Combined Listing parent has only "Select Design". The
  # original multi-state pilot has both options, so Select Design is the
  # common, intentional marker for CityLocs' custom combined-listing UI.
  if has_cl_design
    assign is_cl_combined_listing = true
  endif

  # Combined listings show the product description under the image slider (left
  # column) instead of the details column — enables the description_in_gallery
  # path below. Combined listings only; other high-variant products unchanged.
  if is_cl_combined_listing
    assign description_in_gallery = true
  endif

  assign cl_max_width = section.settings.max_width | default: 1200
  assign cl_details_gutter = section.settings.details_gutter | default: 40
  assign cl_column_gap = section.settings.column_gap | default: 'xl'
  assign cl_mobile_spacing = section.settings.mobile_spacing | default: 'sm'
  assign cl_details_gap_desktop = section.settings.details_gap_desktop | default: 'md'
  assign cl_details_gap_mobile = section.settings.details_gap_mobile | default: 'sm'
  assign cl_use_mobile_layout = section.settings.use_mobile_layout | default: false
  assign cl_mobile_max_width = section.settings.mobile_max_width | default: 760
  assign cl_mobile_side_padding = section.settings.mobile_side_padding | default: 16
  assign cl_mobile_details_gutter = section.settings.mobile_details_gutter | default: 0
  assign cl_gallery_span = 9
  case section.settings.gallery_width
    when '40'
      assign cl_gallery_span = 8
    when '50'
      assign cl_gallery_span = 10
    when '55'
      assign cl_gallery_span = 11
  endcase
  assign cl_details_span = 20 | minus: cl_gallery_span
-%}

{% if slot_details == blank %}
  {% capture slot_details %}
    {% render 'section.flex-pdp.title', product: product %}
    {% render 'section.flex-pdp.vendor', product: product %}
    {% render 'section.flex-pdp.price', product: product %}
    {% render 'section.flex-pdp.installments', product: product %}
    {% render 'section.flex-pdp.divider' %}
    {% render 'section.flex-pdp.variant-picker', product: product %}
    {% render 'section.flex-pdp.quantity-picker', product: product %}
    {% render 'section.flex-pdp.gift-recipient', product: product %}
    {% render 'section.flex-pdp.buy-buttons', product: product %}
    {% render 'section.flex-pdp.policies', product: product %}
    {% render 'section.flex-pdp.pick-up', product: product %}
    {% unless description_in_gallery %}
      {% render 'section.flex-pdp.description', product: product %}
    {% endunless %}
  {% endcapture %}
{% endif %}

{% if slot_gallery == blank %}
  {% capture slot_gallery %}
    {% render 'section.flex-pdp.media-grid', product: product %}
  {% endcapture %}
{% endif %}

{% if description_in_gallery and slot_description == blank %}
  {% capture slot_description %}
    <details class="cl-combined-desc" open>
      <summary class="cl-combined-desc__summary">
        <span>Product Details</span>
        <svg class="cl-combined-desc__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </summary>
      <div class="cl-combined-desc__body">
        {% render 'section.flex-pdp.description', product: product %}
      </div>
    </details>
    <style>
      .cl-combined-desc {
        border: 1px solid #e0e3e8;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
      }
      .cl-combined-desc__summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 18px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        list-style: none;
        user-select: none;
      }
      .cl-combined-desc__summary::-webkit-details-marker { display: none; }
      .cl-combined-desc__summary:hover { background: #f6f7f9; }
      .cl-combined-desc__chevron {
        flex: 0 0 auto;
        transition: transform 0.2s ease;
        color: #687078;
      }
      .cl-combined-desc[open] .cl-combined-desc__chevron { transform: rotate(180deg); }
      .cl-combined-desc__body {
        padding: 4px 18px 18px;
        border-top: 1px solid #eef0f3;
      }
    </style>
  {% endcapture %}
{% endif %}

{% assign gallery_column_slot = slot_gallery %}

{% if description_in_gallery %}
  {% capture gallery_stack_slot %}
    {{ slot_gallery }}
    {{ slot_description }}
  {% endcapture %}

  {% capture gallery_column_slot %}
    {% render 'layout.stack', gap_xs: 'md', gap_sm: 'lg', slot: gallery_stack_slot %}
  {% endcapture %}

  {%- comment -%}
    The description is now rendered under the gallery (above). The original
    description block still renders in the details column via `content_for
    'blocks'` (that comes from the section, not this snippet's default capture),
    so hide it there to avoid a duplicate. Only the details-column block carries
    the shopify-block id; the gallery copy is a plain render.
  {%- endcomment -%}
  <style>
    .cl-combined-listing__details [id$="__section_flex_pdp_description"] { display: none !important; }
  </style>
{% endif %}

{% capture product_details_stack %}
  {% render 'layout.stack', gap_xs: cl_details_gap_mobile, gap_sm: cl_details_gap_desktop, slot: slot_details %}
{% endcapture %}

{% capture product_form %}
  {% render 'form.product', product: product, id: form_id, slot: product_details_stack %}
{% endcapture %}

{% unless is_cl_combined_listing %}
  <style>
    /*
      Zepto Product Personalizer inserts its mount before Empire's layout stack
      with an inline `float: left`. Empire 13 renders layout-stack as
      `display: contents`, so the remaining product information wraps beside the
      float and collapses into a narrow column. Keep the app mount and product
      information in the normal document flow on standard product templates.
    */
    product-form form.shopify-product-form > .product-personalizer {
      float: none !important;
      clear: both;
      width: 100%;
    }

    product-form form.shopify-product-form > .product-personalizer ~ layout-stack {
      display: flex;
      flex-direction: column;
      clear: both;
      width: 100%;
      min-width: 0;
    }
  </style>

  <script>
    (() => {
      const placeZeptoPersonalizer = () => {
        document.querySelectorAll('product-form form.shopify-product-form').forEach((form) => {
          const mount = form.querySelector('.product-personalizer');
          const stack = form.querySelector(':scope > layout-stack');
          const divider = stack?.querySelector('[id*="section_flex_pdp_divider"]');

          if (!mount || !stack || !divider) return;

          const wrapper = mount.parentElement === form ? mount : mount.parentElement;
          if (wrapper.previousElementSibling === divider) return;

          divider.insertAdjacentElement('afterend', wrapper);
          wrapper.dataset.clZeptoPlacement = 'after-reviews-divider';
        });
      };

      placeZeptoPersonalizer();

      const observer = new MutationObserver(placeZeptoPersonalizer);
      observer.observe(document.documentElement, { childList: true, subtree: true });

      window.addEventListener('load', placeZeptoPersonalizer, { once: true });
    })();
  </script>
{% endunless %}

{% capture sticky_product_form %}
  {% render 'layout.sticky-scroller', slot: product_form %}
{% endcapture %}

{% if is_cl_combined_listing %}
  {% capture combined_listing_product_form %}
    <style>
      .cl-combined-listing__details {
        min-width: 0;
      }

      .cl-combined-listing-wrapper {
        box-sizing: border-box;
        width: 100%;
        max-width: {{ cl_max_width }}px;
        margin-inline: auto;
      }

      @media screen and (min-width: 768px) {
        .cl-combined-listing__details {
          padding-inline-start: 24px;
        }
      }

      {% if cl_use_mobile_layout %}
        @media screen and (max-width: 767px) {
          .cl-combined-listing-wrapper {
            max-width: {{ cl_mobile_max_width }}px;
            padding-inline: {{ cl_mobile_side_padding }}px;
          }

          .cl-combined-listing__details {
            padding-inline: {{ cl_mobile_details_gutter }}px;
          }
        }
      {% endif %}

      @media screen and (min-width: 1024px) {
        .cl-combined-listing__details {
          padding-inline-start: {{ cl_details_gutter }}px;
        }
      }
    </style>
    <div class="cl-combined-listing__details">
      {{ sticky_product_form }}
    </div>
  {% endcapture %}
{% else %}
  {% capture standard_listing_product_form %}
    <style>
      .cl-standard-product-wrapper {
        box-sizing: border-box;
        width: 100%;
        max-width: {{ cl_max_width }}px;
        margin-inline: auto;
      }

      .cl-standard-product__details {
        min-width: 0;
        width: 100%;
        box-sizing: border-box;
      }

      @media screen and (min-width: 768px) {
        .cl-standard-product__details {
          padding-inline-start: 24px;
        }
      }

      {% if cl_use_mobile_layout %}
        @media screen and (max-width: 767px) {
          .cl-standard-product-wrapper {
            max-width: {{ cl_mobile_max_width }}px;
            padding-inline: {{ cl_mobile_side_padding }}px;
          }

          .cl-standard-product__details {
            padding-inline: {{ cl_mobile_details_gutter }}px;
          }
        }
      {% endif %}

      @media screen and (min-width: 1024px) {
        .cl-standard-product__details {
          padding-inline-start: {{ cl_details_gutter }}px;
        }
      }
    </style>
    <div class="cl-standard-product__details">
      {{ sticky_product_form }}
    </div>
  {% endcapture %}
{% endif %}

{% capture grid_content %}
  {% if is_cl_combined_listing %}
    {% render 'layout.grid.cell', span_xs: 20, span_md: cl_gallery_span, span_lg: cl_gallery_span, slot: gallery_column_slot %}
    {% render 'layout.grid.cell', span_xs: 20, span_md: cl_details_span, span_lg: cl_details_span, slot: combined_listing_product_form %}
  {% else %}
    {% render 'layout.grid.cell', span_xs: 20, span_md: cl_gallery_span, span_lg: cl_gallery_span, slot: gallery_column_slot %}
    {% render 'layout.grid.cell', span_xs: 20, span_md: cl_details_span, span_lg: cl_details_span, slot: standard_listing_product_form %}
  {% endif %}
{% endcapture %}

{% capture grid_layout %}
  {% assign product_grid_columns = 20 %}
  {% if is_cl_combined_listing %}
    <nav class="cl-combined-breadcrumb" aria-label="Breadcrumb">
      <a href="/collections/custom-license-plate-hats-copy">Choose your state</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>
    <style>
      .cl-combined-breadcrumb {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        max-width: {{ cl_max_width }}px;
        margin: 0 auto 18px;
        padding-inline: 4px;
        color: #687078;
        font-size: 14px;
        line-height: 1.4;
      }

      .cl-combined-breadcrumb a {
        color: #159ee4;
        font-weight: 600;
        text-decoration: none;
      }

      .cl-combined-breadcrumb a:hover,
      .cl-combined-breadcrumb a:focus-visible {
        text-decoration: underline;
      }

      .cl-combined-breadcrumb [aria-current="page"] {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      @media screen and (max-width: 767px) {
        .cl-combined-breadcrumb {
          margin-bottom: 12px;
          padding-inline: 0;
          font-size: 13px;
        }
      }
    </style>
  {% endif %}
  <div class="{% if is_cl_combined_listing %}cl-combined-listing-wrapper{% else %}cl-standard-product-wrapper{% endif %}">
    {% render 'layout.grid',
      columns: product_grid_columns,
      slot: grid_content,
      gap_xs: cl_mobile_spacing,
      gap_sm: cl_column_gap
    %}
  </div>
{% endcapture %}

{% capture section_layout %}
  {% render 'layout.section', slot: grid_layout %}
{% endcapture %}

{% render 'product.hot-reload', section: section, product: product, slot: section_layout %}
