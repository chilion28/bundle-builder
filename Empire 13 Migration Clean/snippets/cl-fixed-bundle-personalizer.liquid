{%- comment -%}
  Compatibility wrapper for the complete fixed-bundle personalizer. Existing
  placements keep working; the four child snippets can also be placed freely.

  {% render 'cl-fixed-bundle-state' %}
  {% render 'cl-fixed-bundle-fields' %}
  {% render 'cl-fixed-bundle-preview' %}
  {% render 'cl-fixed-bundle-cta', cta_label: 'BUY NOW' %}
{%- endcomment -%}
{% render 'cl-fixed-bundle-bootstrap' %}
<div class="cl-fxb__scope cl-fxb__personalizer" id="cl-fxb-personalizer" data-cl-fxb-scope>
  {% render 'cl-fixed-bundle-state', include_assets: false %}
  {% render 'cl-fixed-bundle-fields', include_assets: false %}
  {% render 'cl-fixed-bundle-preview', include_assets: false %}
  {% render 'cl-fixed-bundle-cta', include_assets: false, cta_label: cta_label %}
</div>
