{%- comment -%}
  Fixed 3-Hat Bundle — personalizer block (state + design-driven fields + live preview +
  AJAX add-to-cart). Self-contained: loads its own CSS/JS assets so it can be
  dropped into a GemPages custom-code block OR rendered by the native section.

  Usage: {% render 'cl-fixed-bundle-personalizer' %}
  Optional: {% render 'cl-fixed-bundle-personalizer', cta_label: 'BUY NOW' %}
{%- endcomment -%}

{{ 'cl-pack-grid.css' | asset_url | stylesheet_tag }}
{{ 'cl-fixed-bundle.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  SKU-bridge: the promo Bundle Hat component variants share their SKUs with a
  matching variant on every chosen design product. Emit those SKUs so the JS can
  resolve them against /products/<design-handle>.js at add-time and send the real
  design-product variant GIDs to the cart transform (so production can route).
{%- endcomment -%}
{%- assign fxb_component_skus = '' -%}
{%- for fxb_variant in product.metafields.custom.bundle_components.value -%}
  {%- if fxb_variant.sku and fxb_variant.sku != blank -%}
    {%- if fxb_component_skus == '' -%}
      {%- assign fxb_component_skus = fxb_variant.sku -%}
    {%- else -%}
      {%- assign fxb_component_skus = fxb_component_skus | append: '|' | append: fxb_variant.sku -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
<div class="cl-fxb__personalizer" id="cl-fxb-personalizer" data-product-id="{{ product.id }}" data-component-skus="{{ fxb_component_skus | escape }}">
  {% form 'product', product, id: 'cl-fxb-form', class: 'cl-fxb__form' %}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <input type="hidden" name="quantity" value="1">

    <div class="cl-fxb__field">
      <span class="cl-fxb__field-label">1 · Choose your state</span>
      <div class="cl-fxb__combo" data-cl-combo>
        <input type="text" id="cl-fxb-state-search" class="cl-fxb__input cl-fxb__combo-input"
               placeholder="Search or choose a state…" autocomplete="off"
               role="combobox" aria-expanded="false" aria-controls="cl-fxb-state-menu" aria-autocomplete="list">
        <input type="hidden" id="cl-fxb-state" value="">
        <button type="button" class="cl-fxb__combo-clear" data-cl-combo-clear aria-label="Clear state" hidden>&times;</button>
        <ul class="cl-fxb__combo-menu" id="cl-fxb-state-menu" role="listbox" hidden></ul>
      </div>
    </div>

    <div id="cl-fxb-design" class="cl-fxb__design" hidden aria-live="polite">
      <span class="cl-fxb__design-label">Featured plate design</span>
      <strong id="cl-fxb-design-name"></strong>
    </div>

    <fieldset id="cl-fxb-fields" class="cl-fxb__fields" hidden>
      <legend class="cl-fxb__field-label">2 · Personalize your plate</legend>
      <div id="cl-fxb-fields-list" class="cl-fxb__fields-list"></div>
    </fieldset>

    {%- comment -%} Live inline preview — filled by window.CLPlatePreview. {%- endcomment -%}
    <div class="cl-fxb__preview-wrap">
      <span class="cl-fxb__preview-tag">PREVIEW</span>
      <div id="cl-fxb-preview" class="cl-fxb__preview"></div>
    </div>

    {%- comment -%} Kept for Zepto compatibility; this bundle uses the source plate's
      exact property names and the shared local preview rather than this mount. {%- endcomment -%}
    <div id="pplr-{{ product.id }}"
         data-id="{{ product.id }}"
         data-handle="{{ product.handle }}"
         class="product-personalizer cl-fxb__mount cl-fxb__zepto-hidden"></div>

    <button type="submit" class="cl-fxb__cta" name="add">
      {{ cta_label | default: 'CLAIM MY 3 HAT BUNDLE' }} <span aria-hidden="true">→</span>
    </button>
  {% endform %}
</div>

<script src="{{ 'cl-pack-grid.js' | asset_url }}" defer></script>
<script src="{{ 'cl-fixed-bundle.js' | asset_url }}" defer></script>
