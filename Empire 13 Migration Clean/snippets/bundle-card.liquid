{% assign is_featured = false %}
{% if featured_product and product.id == featured_product.id %}
  {% assign is_featured = true %}
{% endif %}

{% assign savings = 0 %}
{% if product.compare_at_price > product.price %}
  {% assign savings = product.compare_at_price | minus: product.price %}
{% endif %}

<a href="{{ product.url }}" class="cl-bundle-card {% if is_featured %}is-featured{% endif %}">
  {% if is_featured %}
  <div class="cl-bundle-top-badge">
    MOST POPULAR
  </div>
{% endif %}
  <div class="cl-bundle-image-wrap">
    {% if savings > 0 %}
      <div class="cl-bundle-save">
        <span>SAVE</span>
        <strong>{{ savings | money_without_trailing_zeros }}</strong>
      </div>
    {% endif %}

    {% if product.featured_image %}
      <img
        src="{{ product.featured_image | image_url: width: 900 }}"
        alt="{{ product.title | escape }}"
        loading="lazy"
        class="cl-bundle-image"
      >
    {% endif %}
  </div>

  <div class="cl-bundle-content">
    <h3>{{ product.title }}</h3>

    {% if product.metafields.custom.product_tagline != blank %}
  <div class="cl-bundle-subtitle">
    {{ product.metafields.custom.product_tagline.value }}
  </div>
{% endif %}

    <div class="cl-bundle-divider"></div>

    <div class="cl-bundle-includes">
      <div>
        <span class="cl-icon"><svg height="20" width="20" data-name="baseball-cap-light" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" data-id="508817609073361256">
              <path fill="currentColor" strokelinecap="round" strokelinejoin="round" d="M128,26A102.12,102.12,0,0,0,26,128v56a22,22,0,0,0,35,17.74c12.38-9,34.06-19.74,67-19.74s54.61,10.73,67,19.73A22,22,0,0,0,230,184V128A102.12,102.12,0,0,0,128,26Zm90,102v12.5a164.29,164.29,0,0,0-44.8-20.3A165.07,165.07,0,0,0,141.69,39,90.15,90.15,0,0,1,218,128Zm-57.21-10.78a168.56,168.56,0,0,0-65.58,0c5-38.38,24.16-65.59,32.79-76.14C136.63,51.65,155.8,78.85,160.79,117.23ZM114.31,39A165.07,165.07,0,0,0,82.8,120.21,164.29,164.29,0,0,0,38,140.51V128A90.15,90.15,0,0,1,114.31,39Zm98.26,153.85A9.94,9.94,0,0,1,202,192c-13.82-10-37.88-22-74-22s-60.22,12-74,22a9.92,9.92,0,0,1-10.53.85A9.79,9.79,0,0,1,38,184V155a154,154,0,0,1,180,0v29A9.79,9.79,0,0,1,212.57,192.89Z"></path></svg></span>
        <p>Leather Patch Hat</p>
      </div>

      <div>
        <span class="cl-icon"><svg height="20" width="20" data-name="pint-glass-regular" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" data-id="508817694269768040">
              <path fill="currentColor" strokelinecap="round" strokelinejoin="round" d="M206,26.69A8,8,0,0,0,200,24H56a8,8,0,0,0-7.94,9l23.15,193A16,16,0,0,0,87.1,240h81.8a16,16,0,0,0,15.89-14.09L207.94,33A8,8,0,0,0,206,26.69ZM191,40,188.1,64H67.9L65,40ZM168.9,224H87.1L69.82,80H186.18Z"></path></svg></span>
        <p>20 oz. Tumbler</p>
      </div>

      <div>
        <span class="cl-icon"><svg height="20" width="20" data-name="beer-bottle-light" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" data-id="508817609074934120">
              <path fill="currentColor" strokelinecap="round" strokelinejoin="round" d="M244.24,43.76l-32-32a6,6,0,0,0-8.48,8.48l3.11,3.11-57.38,43-38.67,7.74a5.92,5.92,0,0,0-3.06,1.64L24.44,159.07a22,22,0,0,0,0,31.11l41.38,41.38a22,22,0,0,0,31.11,0l83.31-83.32a5.92,5.92,0,0,0,1.64-3.06l7.74-38.67,43-57.38,3.11,3.11a6,6,0,0,0,8.48-8.48ZM88.44,223.07a10,10,0,0,1-14.14,0L32.93,181.7a10,10,0,0,1,0-14.14L40,160.49,95.51,216ZM104,207.51,48.49,152,96,104.49,151.51,160ZM179.2,100.4a5.88,5.88,0,0,0-1.08,2.42L170.47,141,160,151.51,104.49,96,115,85.53l38.22-7.65a5.88,5.88,0,0,0,2.42-1.08l59.84-44.88,8.64,8.64Z"></path></svg></span>
        <p>Bottle Opener</p>
      </div>
    </div>

    <div class="cl-bundle-price-row">
      {% if product.compare_at_price > product.price %}
        <span class="cl-compare">{{ product.compare_at_price | money }}</span>
      {% endif %}

      <span class="cl-price">{{ product.price | money }}</span>
    </div>

    <div class="cl-bundle-button">
      Shop {{ product.title | remove: 'Bundle' | strip }}
    </div>
  </div>
</a>

<style>
    .cl-bundle-card {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  color: #151515;
  text-decoration: none;
  background: #fff;
  border: 1px solid #111;
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.cl-bundle-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 14px 35px rgba(0, 0, 0, 0.12);
}

.cl-bundle-card.is-featured {
  border: 4px solid #f9c60f;
}

.cl-bundle-image-wrap {
  position: relative;
  background: #f7f7f7;
}

.cl-bundle-image {
  width: 100%;
  aspect-ratio: 1.32 / 1;
  object-fit: cover;
  display: block;
}

.cl-bundle-save {
  position: absolute;
  top: 16px;
  left: 16px;
  z-index: 2;
  width: 92px;
  min-height: 78px;
  border-radius: 8px;
  background: rgba(20, 20, 20, 0.82);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(2px);
  line-height: 1;
}

.cl-bundle-save span {
  font-size: 16px;
  font-weight: 800;
}

.cl-bundle-save strong {
  font-size: 34px;
  font-weight: 900;
}

.cl-bundle-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 28px 24px 24px;
  text-align: center;
}

.cl-bundle-content h3 {
  margin: 0;
  font-family: "Inter" !important;
  font-size: 24px;
  line-height: 1.1;
  font-weight: 900;
  text-transform: uppercase;
}

.cl-bundle-subtitle {
  margin-top: 8px;
  font-family: "Inter" !important;
  font-size: 16px;
  line-height: 1.4;
}

.cl-bundle-subtitle p {
  font-family: "Inter" !important;
  margin: 0;
}

.cl-bundle-divider {
  width: 100%;
  height: 1px;
  background: #ddd;
  margin: 22px 0 16px;
}

.cl-bundle-includes {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 22px;
}

.cl-bundle-includes > div {
  text-align: center;
}

.cl-icon {
  display: block;
  font-size: 24px;
  line-height: 1;
  margin-bottom: 6px;
}

.cl-icon svg {margin:auto;}

.cl-bundle-includes p {
  margin: 0;
  font-family: "Inter" !important;
  font-size: 12px;
  line-height: 1.2;
}

.cl-bundle-price-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 26px;
  margin-top: auto;
  margin-bottom: 22px;
}

.cl-compare {
  font-family: "Inter" !important;
  font-size: 24px;
  color: #555;
  text-decoration: line-through;
}

.cl-price {
  font-family: "Inter" !important;
  font-size: 42px;
  line-height: 1;
  font-weight: 900;
  color: #000;
}

.cl-bundle-button {
  width: 100%;
  border-radius: 8px;
  background: #111;
  color: #fff;
  padding: 16px 20px;
  font-family: "Inter" !important;
  font-size: 18px;
  font-weight: 900;
  text-transform: uppercase;
}

.cl-bundle-card.is-featured .cl-bundle-button {
  background: #f9c60f;
  color: #111;
}

.cl-bundle-card.is-featured {
  position: relative;
  border: 4px solid #f4c400;
  transform: scale(1.045);
  z-index: 3;
  box-shadow:
    0 20px 50px rgba(0,0,0,.16),
    0 0 0 1px rgba(244,196,0,.25);
}

.cl-bundle-top-badge {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 12;

  background: #f9c60f;
  color: #111;

  padding: 10px 18px;
  border-radius: 999px;
font-family: "Inter" !important;
  font-size: 14px;
  line-height: 1;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  white-space: nowrap;

  box-shadow: 0 6px 18px rgba(0,0,0,.14);
}

.cl-bundle-top-badge::before,
.cl-bundle-top-badge::after {
  display: none;
}

@media screen and (max-width: 767px) {
  .cl-bundle-content {
    padding: 22px 18px 18px;
  }

  .cl-bundle-content h3 {
    font-size: 21px;
  }

  .cl-bundle-subtitle {
    font-size: 14px;
  }

  .cl-price {
    font-size: 32px;
  }

  .cl-compare {
    font-size: 18px;
  }

  .cl-bundle-save {
    width: 74px;
    min-height: 62px;
  }

  .cl-bundle-save span {
    font-size: 13px;
  }

  .cl-bundle-save strong {
    font-size: 26px;
  }

   .cl-bundle-card.is-featured {
    transform: scale(1.02);
  }

  .cl-bundle-top-badge {
    min-width: 170px;
    font-size: 16px;
    padding: 10px 18px;
    top: 46%;
  
  }
}
</style>