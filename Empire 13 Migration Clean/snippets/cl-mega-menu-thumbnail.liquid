{% comment %}
  Renders an optional image for a Shopify Navigation link.

  Image priority:
  1. custom.mega_menu_image metafield on the linked resource
  2. matching legacy Qikify thumbnail
  3. linked collection/article image or product featured image
  4. the existing CSS fallback tile

  @param menu_link LinkDrop
  @param show_image Boolean
{% endcomment %}

{% if show_image %}
  {% capture legacy_image_asset %}{% render 'cl-mega-menu-legacy-image', menu_link: menu_link %}{% endcapture %}
  {% assign legacy_image_asset = legacy_image_asset | strip %}

  {% liquid
    assign menu_object = menu_link.object

    if menu_object == blank
      assign clean_url = menu_link.url | split: '?' | first | split: '#' | first
      assign url_parts = clean_url | split: '/'
      assign resource_kind = url_parts[1]
      assign resource_handle = url_parts[2]

      case resource_kind
        when 'collections'
          assign menu_object = collections[resource_handle]
        when 'products'
          assign menu_object = all_products[resource_handle]
        when 'pages'
          assign menu_object = pages[resource_handle]
        when 'blogs'
          if url_parts.size == 3
            assign menu_object = blogs[resource_handle]
          endif
      endcase
    endif

    assign menu_image_override = menu_object.metafields.custom.mega_menu_image.value
    assign resource_image = menu_object.image

    if resource_image == blank
      assign resource_image = menu_object.featured_image
    endif
  %}

  <span class="cl-native-mega__thumb{% if menu_image_override == blank and legacy_image_asset == blank and resource_image == blank %} cl-native-mega__thumb--empty{% endif %}">
    {% if menu_image_override != blank %}
      <img
        src="{{ menu_image_override | image_url: width: 112 }}"
        alt=""
        width="56"
        height="56"
        loading="lazy"
      >
    {% elsif legacy_image_asset != blank %}
      <img
        src="{{ legacy_image_asset | asset_url }}"
        alt=""
        width="56"
        height="56"
        loading="lazy"
      >
    {% elsif resource_image != blank %}
      <img
        src="{{ resource_image | image_url: width: 112 }}"
        alt=""
        width="56"
        height="56"
        loading="lazy"
      >
    {% endif %}
  </span>
{% endif %}
