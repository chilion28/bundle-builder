  Copyright © 2025 Archetype Themes LP. All rights reserved.
  
  Renders the product price with proper formatting.
  
  This component displays the product price using the product.price component, 
  which handles price formatting, compare-at pricing, and currency display. 
  The price is rendered with a large body text variant for prominence.
  
  @param {object} product - A product object
  @param {boolean} [superscript_decimals] - Whether to use superscript decimals for the price (default: true)
  @param {boolean} [product_save_amount] - Whether to show the product save amount (default: false)
  @param {string} [product_save_type] ('dollar', 'percentage') - The type of product save amount to show (default: 'dollar')
  
  @example
  {% render 'section.flex-pdp.price', product: closest.product %}
{% enddoc %}

{%- liquid
  assign superscript_decimals = superscript_decimals | default: block.settings.superscript_decimals, allow_false: true | default: settings.superscript_decimals, allow_false: true | default: true, allow_false: true
  assign product_save_amount = product_save_amount | default: block.settings.product_save_amount, allow_false: true | default: true, allow_false: true
  assign product_save_type = product_save_type | default: block.settings.product_save_type | default: 'dollar'
  assign price_font_size = block.settings.font_size | default: 18
  assign price_font_weight = block.settings.font_weight | default: '700'
  assign price_color = block.settings.color | default: '#1f2328'
  assign price_alignment = block.settings.alignment | default: 'left'
  if price_alignment == 'left'
    assign price_alignment = 'start'
  elsif price_alignment == 'right'
    assign price_alignment = 'end'
  endif
  assign price_spacing_top = block.settings.spacing_top | default: 0
  assign price_spacing_bottom = block.settings.spacing_bottom | default: 0
  assign price_font_size_mobile = block.settings.font_size_mobile | default: 18
  assign price_font_weight_mobile = block.settings.font_weight_mobile | default: '700'
  assign price_color_mobile = block.settings.color_mobile | default: '#1f2328'
  assign price_alignment_mobile = block.settings.alignment_mobile | default: 'left'
  if price_alignment_mobile == 'left'
    assign price_alignment_mobile = 'start'
  elsif price_alignment_mobile == 'right'
    assign price_alignment_mobile = 'end'
  endif
  assign price_spacing_top_mobile = block.settings.spacing_top_mobile | default: 0
  assign price_spacing_bottom_mobile = block.settings.spacing_bottom_mobile | default: 0
  assign price_class = 'product-price product-price--' | append: block.id
-%}

{% capture product_price_content %}
  {% render 'product.price', product: product, superscript_decimals: superscript_decimals, product_save_amount: product_save_amount, product_save_type: product_save_type %}
{% endcapture %}

{% capture price_style %}
  --_font-size: {{ price_font_size }}px;
  --_font-weight: {{ price_font_weight }};
  --_color: {{ price_color }};
  display: block;
  margin-block: {{ price_spacing_top }}px {{ price_spacing_bottom }}px;
{% endcapture %}

{% if block.settings.use_mobile_styles %}
  <style>
    @media screen and (max-width: 767px) {
      .product-price--{{ block.id }} {
        --_font-size: {{ price_font_size_mobile }}px !important;
        --_font-weight: {{ price_font_weight_mobile }} !important;
        --_color: {{ price_color_mobile }} !important;
        margin-block: {{ price_spacing_top_mobile }}px {{ price_spacing_bottom_mobile }}px !important;
        text-align: {{ price_alignment_mobile }} !important;
      }
    }
  </style>
{% endif %}

{% render 'element.text', variant: 'body-lg', text: product_price_content, classlist: price_class, alignment: price_alignment, style: price_style %}
