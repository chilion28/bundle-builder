{% doc %}
  @param {string} subheading - Subheading on the text side of the section
  @param {string} base_name - BEM prefix for emitted classes (default: 'image-with-text')
{% enddoc %}

{%- assign base_name = base_name | default: 'image-with-text' -%}

{%- if subheading != blank -%}
  <div class="{{ base_name }}__text">{{ subheading }}</div>
{%- endif -%}
