{% doc %}
  Copyright © 2025 Archetype Themes LP. All rights reserved.

  Renders the variant picker for the product, allowing customers to select
  different product options (such as size, color, etc.) using either radio
  buttons or a select dropdown, depending on the specified
  'variant_selector_type'.

  This snippet dynamically generates option labels and values, handles
  swatches and button styles for each value, and ensures unavailable
  options are disabled.

  It is designed to work with products that have multiple variants and
  adapts its UI based on the product's available options and the chosen
  selector type.

  @param {string} [variant_selector_type] ('radio'|'select') - The type of variant selector to render.

  @example
  {% render 'section.flex-pdp.variant-picker', variant_selector_type: 'radio', product: closest.product %}
{% enddoc %}

{% liquid
  assign variant_selector_type = variant_selector_type | default: block.settings.variant_selector_type | default: 'radio'
  assign is_cl_combined_listing = false
  assign has_cl_state = false
  assign has_cl_design = false
  for product_option in product.options_with_values
    assign product_option_name = product_option.name | strip | downcase
    if product_option_name == 'select state'
      assign has_cl_state = true
    elsif product_option_name == 'select design'
      assign has_cl_design = true
    endif
  endfor
  if has_cl_state and has_cl_design
    assign is_cl_combined_listing = true
  endif

  if is_cl_combined_listing
    for product_option in product.options_with_values
      assign product_option_name = product_option.name | strip | downcase
      if product_option_name == 'select state'
        assign cl_selected_state = product_option.selected_value
      elsif product_option_name == 'select design'
        assign cl_selected_design = product_option.selected_value
      endif
    endfor

    assign cl_preview_handle = ''
    assign cl_preview_has_date = false
    if cl_selected_state == 'California'
      if cl_selected_design == "60's"
        assign cl_preview_handle = 'hat-cali-plates'
        assign cl_preview_has_date = true
      elsif cl_selected_design == 'Blackout'
        assign cl_preview_handle = 'california-blackout-plate-hat'
      elsif cl_selected_design == 'Sunny'
        assign cl_preview_handle = 'california-sunny-plate-hat'
      endif
    elsif cl_selected_state == 'Texas'
      if cl_selected_design == '2000'
        assign cl_preview_handle = 'hat-tex-plate'
      elsif cl_selected_design == 'Black'
        assign cl_preview_handle = 'hat-60s-texas-plate'
      elsif cl_selected_design == 'Blackout'
        assign cl_preview_handle = 'texas-blackout-plate-hat'
      endif
    endif
  endif
%}

{% if is_cl_combined_listing %}
  {{ 'cl-pack-grid.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cl-pack-grid.js' | asset_url }}" defer></script>
  <script src="{{ 'cl-combined-quantity-state.js' | asset_url }}" defer></script>
{% endif %}

{% capture variant_selector %}
  {%- unless product.has_only_default_variant -%}
    {% for option in product.options_with_values %}
      {% assign normalized_option_name = option.name | strip | downcase %}
      {% assign option_selector_type = variant_selector_type %}
      {% if normalized_option_name == 'select state' %}
        {% assign option_selector_type = 'select' %}
      {% endif %}

      <div class="cl-combined-option cl-combined-option--{{ option.name | handleize }}{% if is_cl_combined_listing and normalized_option_name == 'select state' %} cl-combined-option--state-locked{% endif %}">
      {% if is_cl_combined_listing and normalized_option_name == 'color' %}
        <div class="cl-combined-quantity-grid" data-cl-combined-quantity-grid>
          <p class="cl-combined-quantity-grid__title">Choose colors &amp; quantities</p>
          <div class="cl-combined-quantity-grid__rows">
            {% for variant in product.variants %}
              {% assign variant_matches = true %}
              {% for comparison_option in product.options_with_values %}
                {% assign comparison_name = comparison_option.name | strip | downcase %}
                {% unless comparison_name == 'color' %}
                  {% assign comparison_index = comparison_option.position | minus: 1 %}
                  {% if variant.options[comparison_index] != comparison_option.selected_value %}
                    {% assign variant_matches = false %}
                  {% endif %}
                {% endunless %}
              {% endfor %}

              {% if variant_matches and variant.available %}
                {% assign color_index = option.position | minus: 1 %}
                {% assign color_name = variant.options[color_index] %}
                {% assign row_image = variant.featured_image | default: product.featured_image %}
                <div class="cl-combined-quantity-row" data-cl-combined-quantity-row data-variant-id="{{ variant.id }}" data-price="{{ variant.price }}">
                  <div class="cl-combined-quantity-row__image">
                    {% if row_image %}
                      {{ row_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 180', alt: color_name }}
                    {% endif %}
                  </div>
                  <span class="cl-combined-quantity-row__name">{{ color_name }}</span>
                  <div class="cl-combined-quantity-row__stepper">
                    <button type="button" data-cl-combined-minus aria-label="Decrease {{ color_name | escape }} quantity">−</button>
                    <input type="number" inputmode="numeric" min="0" value="0" data-cl-combined-qty aria-label="{{ color_name | escape }} quantity">
                    <button type="button" data-cl-combined-plus aria-label="Increase {{ color_name | escape }} quantity">+</button>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% else %}
      {% case option_selector_type %}
        {% when 'radio' %}
          {% capture option_name_content %}
            {% assign option_name = option.name | append: ':' %}
            {% render 'element.text', as: 'span', text: option_name, style: 'font-weight: 600;' %}
            {% render 'element.text', as: 'span', text: product.selected_or_first_available_variant.options[forloop.index0], style: 'opacity: 0.75;' %}
          {% endcapture %}

          {% capture option_name %}
            {% render 'element.text', variant: 'body-sm', text: option_name_content %}
          {% endcapture %}

          {% capture option_values %}
            {% for value in option.values %}
              {% comment %}
                The hot-reload resolver now selects the first genuinely
                available downstream variant whenever an upstream option
                changes, so unavailable values can be omitted safely.
              {% endcomment %}
              {% if value.available == false %}
                {% continue %}
              {% endif %}
              {%- assign classlist = '' -%}
              {% if is_cl_combined_listing and normalized_option_name == 'select design' %}
                {% assign classlist = 'cl-combined-design-radio' %}
              {% endif %}

              {%- capture input_id -%}
                {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
              {%- endcapture -%}

              {% assign input_value = value | escape %}

              {%- capture input_label -%}
                {% if is_cl_combined_listing and normalized_option_name == 'select design' %}
                  {% liquid
                    assign cl_design_product = product
                    assign cl_design_product_url = value.product_url | default: ''
                    if cl_design_product_url != blank
                      assign cl_design_handle = cl_design_product_url | split: '/products/' | last | split: '?' | first | split: '#' | first
                      assign cl_design_product_from_url = all_products[cl_design_handle]
                      if cl_design_product_from_url != blank
                        assign cl_design_product = cl_design_product_from_url
                      endif
                    endif
                    assign cl_design_swatch = cl_design_product.metafields.custom.design_swatch.value
                  %}
                  <span class="cl-combined-design-card{% if value.selected %} cl-combined-design-card--selected{% endif %}">
                    {% if cl_design_swatch != blank %}
                      <span class="cl-combined-design-card__image">
                        {{ cl_design_swatch | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360', sizes: '(max-width: 749px) 96px, 120px', alt: value }}
                      </span>
                    {% endif %}
                    <span class="cl-combined-design-card__label">{{ value }}</span>
                  </span>
                {% elsif value.swatch %}
                  {% assign swatch_disabled = false %}
                  {% if value.available == false %}
                    {% assign swatch_disabled = true %}
                  {% endif %}

                  {%- render 'element.text', text: value, visually_hidden: true -%}
                  {%- render 'element.swatch', swatch: value.swatch, large: true, selected: value.selected, disabled: swatch_disabled -%}
                {% else %}
                  {% if value.selected %}
                    {%- render 'element.button', as: 'span', text: value, classlist:'variant-option-value-name-selected', size: 'sm', style: '--element-button-color-primary: var(--color-primary); --element-button-color-secondary: var(--color-secondary);' -%}
                  {% else %}
                    {%- render 'element.button', as: 'span', text: value, classlist: 'variant-option-value-name', inverted: true, size: 'sm', style: '--element-button-color-primary: var(--color-primary); --element-button-color-secondary: var(--color-secondary);' -%} 
                  {% endif %}
                {% endif %}
              {%- endcapture -%}

              {%- capture input_attributes -%}
                {% render 'product.hot-reload.radio-attributes', value: value %}
              {%- endcapture -%}

              {%- render 'element.radio',
                id: input_id,
                name: option.name,
                value: input_value,
                slot: input_label,
                checked: value.selected,
                display_icon: false,
                classlist: classlist,
                attributes: input_attributes
              -%}
            {% endfor %}
          {% endcapture %}

          {% capture option_stack %}
            {{ option_name }}
            {% render 'layout.stack', horizontal: true, gap: 'xs', slot: option_values %}
            {% if is_cl_combined_listing and normalized_option_name == 'select design' %}
              <div class="cl-combined-personalizer cl-grid-perso" data-cl-combined-personalizer data-cl-preview-handle="{{ cl_preview_handle }}" data-cl-preview-script="{{ 'cl-pack-grid.js' | asset_url }}">
                <div class="cl-grid-perso-preview" data-cl-perso-preview aria-live="polite"></div>

                <label class="cl-combined-personalizer__field cl-grid-perso-field">
                  <span><strong>Custom Text</strong><small data-cl-counter="Custom Text">20/20</small></span>
                  <input type="text" name="properties[Custom Text]" maxlength="20" placeholder="CUSTOM" autocomplete="off" required data-cl-personalization-field="Custom Text">
                </label>

                <label class="cl-combined-personalizer__toggle">
                  <input type="checkbox" data-cl-second-line-toggle>
                  <span>Add a second line of text</span>
                </label>

                <label class="cl-combined-personalizer__field cl-grid-perso-field" data-cl-second-line-field hidden>
                  <span><strong>Second Line</strong><small data-cl-counter="Custom Text Two">26/26</small></span>
                  <input type="text" name="properties[Custom Text Two]" maxlength="26" placeholder="OPTIONAL" autocomplete="off" disabled data-cl-personalization-field="Custom Text Two">
                </label>

                <label class="cl-combined-personalizer__field cl-grid-perso-field"{% unless cl_preview_has_date %} hidden{% endunless %}>
                  <span><strong>Month</strong><small data-cl-counter="Month">3/3</small></span>
                  <input type="text" name="properties[Month]" maxlength="3" placeholder="MONTH" autocomplete="off"{% if cl_preview_has_date %} required{% else %} disabled{% endif %} data-cl-personalization-field="Month">
                </label>

                <label class="cl-combined-personalizer__field cl-grid-perso-field"{% unless cl_preview_has_date %} hidden{% endunless %}>
                  <span><strong>Year</strong><small data-cl-counter="Year">4/4</small></span>
                  <input type="text" name="properties[Year]" maxlength="4" placeholder="YEAR" autocomplete="off"{% if cl_preview_has_date %} required{% else %} disabled{% endif %} data-cl-personalization-field="Year">
                </label>
              </div>
            {% endif %}
          {% endcapture %}

          {% render 'layout.stack', gap: 'xs', horizontal: false, slot: option_stack %}
        {% when 'select' %}
          {%- capture input_id -%}
            {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
          {%- endcapture -%}

          {% capture options %}
            {% for value in option.values %}
              {%- capture option_input_attributes -%}
                {% if value.available == false %}
                  disabled
                {% endif %}
                {% if value.selected %}
                  selected
                {% endif %}
                {% render 'product.hot-reload.select-attributes', value: value, element: 'option' %}
              {%- endcapture -%}

              <option value="{{ value | escape }}" {{ option_input_attributes }}>{{ value }}</option>
            {% endfor %}
          {% endcapture %}

          {% capture select_attributes %}
            {% render 'product.hot-reload.select-attributes', element: 'select' %}
          {% endcapture %}

          {% capture option_stack %}
            {% render 'element.text', as: 'label', variant: 'body-sm', text: option.name, style: 'font-weight: 600;' %}
            {% render 'element.select',
              name: option.name,
              slot: options,
              id: input_id,
              placeholder: option.selected_value,
              attributes: select_attributes
            %}
          {% endcapture %}

          {% render 'layout.stack', gap: 'xs', horizontal: false, slot: option_stack %}
      {% endcase %}
      {% endif %}
      </div>
    {% endfor %}
  {%- endunless -%}
{% endcapture %}

{% render 'layout.stack', gap: 'sm', slot: variant_selector %}

<style>
  .cl-combined-option--select-state .element-select {
    width: 100%;
    min-height: 48px;
    font-weight: 600;
  }

  .cl-combined-option--select-state.cl-combined-option--state-locked,
  .cl-combined-state-locked .cl-combined-option--select-state {
    display: none !important;
  }

  .cl-combined-option--select-design .layout-stack[horizontal] {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
  }

  .cl-combined-option--select-design .cl-combined-design-radio {
    display: block;
    min-width: 112px;
    cursor: pointer;
  }

  .cl-combined-design-card {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: none;
    border-radius: 8px;
    background: #fff;
    transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease;
  }

  .cl-combined-design-card__image {
    display: block;
    width: 120px;
    object-fit: contain;
    overflow: hidden;
    background: #f5f5f5;
  }

  .cl-combined-design-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cl-combined-design-card__label {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: auto;
    padding: 4px;
    color: #252525;
    font-size: .9rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }

  .cl-combined-design-radio:hover .cl-combined-design-card {
    border-color: #8a8f96;
  }

  .cl-combined-design-radio:has(input:focus-visible) .cl-combined-design-card {
    outline: 2px solid var(--color-focus, #159ee4);
    outline-offset: 2px;
  }

  .cl-combined-design-radio:has(input:checked) .cl-combined-design-card,
  .cl-combined-design-card--selected {
    border-color: #159ee4;
    background: #e8f7ff;
    box-shadow: 0 0 0 1px #159ee4;
  }

  .cl-combined-option--select-design .element-button {
    min-height: 42px;
    padding-inline: 18px;
  }

  .cl-combined-personalizer {
    display: grid;
    gap: 12px;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    margin-top: 14px;
    padding: 16px;
    border: 1px dashed #cfd3d8;
    border-radius: 14px;
    background: #fafafa;
  }

  .cl-combined-personalizer__field { display: grid; gap: 5px; min-width: 0; }
  .cl-combined-personalizer__field > span { display: flex; justify-content: space-between; gap: 12px; }
  .cl-combined-personalizer__field small { color: #8a8f96; font-size: .9rem; }
  .cl-combined-personalizer__field input {
    box-sizing: border-box;
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 10px 14px;
    border: 1px solid #cfd3d8;
    border-radius: 10px;
    background: #fff;
    font: inherit;
    text-transform: uppercase;
  }
  .cl-combined-personalizer__field input:focus { outline: 2px solid #159ee4; outline-offset: 1px; }
  .cl-combined-personalizer__toggle { display: flex; gap: 10px; align-items: center; font-weight: 600; }
  .cl-combined-personalizer__toggle input { width: 22px; height: 22px; }
  .cl-combined-personalizer [hidden] { display: none !important; }

  product-hot-reload:has(.cl-combined-quantity-grid) .layout-stack:has(> quantity-selector),
  product-hot-reload:has(.cl-combined-quantity-grid) .shopify-payment-button,
  product-hot-reload:has(.cl-combined-quantity-grid) [data-shopify="payment-button"],
  product-hot-reload:has(.cl-combined-quantity-grid) quantity-selector,
  product-hot-reload:has(.cl-combined-quantity-grid) .inventory-status--in-stock,
  product-hot-reload:has(.cl-combined-quantity-grid) .inventory-status--low-stock,
  product-hot-reload:has(.cl-combined-quantity-grid) .inventory-status--sold-out {
    display: none !important;
  }

  .cl-combined-quantity-grid__title {
    margin: 0 0 14px;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .cl-combined-quantity-grid__rows {
    overflow: hidden;
    border: 1px solid #dfe3e8;
    border-radius: 14px;
  }

  .cl-combined-quantity-row {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    min-height: 78px;
    padding: 9px 14px;
    border-top: 1px solid #e8ebef;
  }

  .cl-combined-quantity-row:first-child { border-top: 0; }

  .cl-combined-quantity-row__image {
    width: 56px;
    height: 56px;
    overflow: hidden;
    border: 1px solid #dfe3e8;
    border-radius: 11px;
    background: #fff;
  }

  .cl-combined-quantity-row__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cl-combined-quantity-row__name {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .cl-combined-quantity-row__stepper {
    display: grid;
    grid-template-columns: 42px 48px 42px;
    overflow: hidden;
    border: 1px solid #dfe3e8;
    border-radius: 12px;
  }

  .cl-combined-quantity-row__stepper button,
  .cl-combined-quantity-row__stepper input {
    height: 42px;
    border: 0;
    background: #fff;
    color: #273142;
    text-align: center;
    font: inherit;
    font-size: 1rem;
  }

  .cl-combined-quantity-row__stepper [data-cl-combined-plus] {
    border-left: 1px solid #dfe3e8;
  }

  .cl-combined-quantity-row__stepper input {
    width: 100%;
    border-inline: 1px solid #dfe3e8;
    border-radius: 0;
    appearance: textfield;
  }

  .cl-combined-quantity-row__stepper input::-webkit-inner-spin-button,
  .cl-combined-quantity-row__stepper input::-webkit-outer-spin-button { appearance: none; }

  @media screen and (max-width: 749px) {
    .cl-combined-personalizer { padding: 12px; }
    .cl-combined-option--select-design .element-radio {
      flex: 1 1 calc(50% - var(--spacing-xs));
    }

    .cl-combined-option--select-design .cl-combined-design-radio {
      flex: 0 1 96px;
      min-width: 88px;
    }

    .cl-combined-design-card__image { width: 100%; }

    .cl-combined-option--select-design .element-button {
      width: 100%;
      justify-content: center;
    }

    .cl-combined-quantity-row {
      grid-template-columns: 50px minmax(0, 1fr) auto;
      gap: 8px;
      min-height: 68px;
      padding: 7px 9px;
    }

    .cl-combined-quantity-row__image { width: 48px; height: 48px; }
    .cl-combined-quantity-row__stepper { grid-template-columns: 36px 40px 36px; }
    .cl-combined-quantity-row__stepper button,
    .cl-combined-quantity-row__stepper input { height: 38px; }
  }
</style>

{% if is_cl_combined_listing %}
  <script>
    (() => {
      const stateFromLandingPage = new URLSearchParams(window.location.search).get('state');
      if (!stateFromLandingPage) return;

      const normalizeState = (value) => String(value || '')
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-');
      const requestedState = normalizeState(stateFromLandingPage);
      const stateOption = document.currentScript.previousElementSibling
        ?.parentElement
        ?.querySelector('.cl-combined-option--select-state');
      const stateSelect = stateOption?.querySelector('select');
      if (!stateSelect) return;

      const matchingOption = Array.from(stateSelect.options).find((option) => {
        return normalizeState(option.value) === requestedState
          || normalizeState(option.textContent) === requestedState;
      });

      if (!matchingOption) return;
      document.documentElement.classList.add('cl-combined-state-locked');

      if (stateSelect.value !== matchingOption.value) {
        customElements.whenDefined('product-hot-reload').then(() => {
          window.requestAnimationFrame(() => {
            stateSelect.value = matchingOption.value;
            stateSelect.dispatchEvent(new Event('change', { bubbles: true }));
          });
        });
        return;
      }

      stateOption.classList.add('cl-combined-option--state-locked');
    })();
  </script>
{% endif %}
