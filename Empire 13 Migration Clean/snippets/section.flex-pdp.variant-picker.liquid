    # product title, matching against the states present in the table above.
    # Match the LONGEST state name found in the title, not the first. This keeps
    # substring pairs from colliding: "Washington DC" beats "Washington", and
    # "West Virginia" beats "Virginia", regardless of table row order.
    if cl_selected_state == blank
      assign cl_title_dc = product.title | downcase
      assign cl_best_len = 0
      for cl_row in cl_rows
        assign cl_cols = cl_row | split: '~'
        assign cl_state_dc = cl_cols[0] | downcase
        if cl_state_dc != blank and cl_title_dc contains cl_state_dc
          assign cl_this_len = cl_state_dc | size
          if cl_this_len > cl_best_len
            assign cl_best_len = cl_this_len
            assign cl_selected_state = cl_cols[0]
          endif
        endif
      endfor
    endif

