  Renders the variant picker for the product, allowing customers to select
  different product options (such as size, color, etc.) using either radio
  buttons or a select dropdown, depending on the specified
  'variant_selector_type'.

  This snippet dynamically generates option labels and values, handles
  swatches and button styles for each value, and ensures unavailable
  options are disabled.

  It is designed to work with products that have multiple variants and
  adapts its UI based on the product's available options and the chosen
  selector type.

  @param {string} [variant_selector_type] ('radio'|'select') - The type of variant selector to render.

  @example
  {% render 'section.flex-pdp.variant-picker', variant_selector_type: 'radio', product: closest.product %}
{% enddoc %}

{% liquid
  # Theme blocks receive the product through closest.product. Keep the explicit
  # render parameter when present, while making the picker work in both
  # contexts (including Combined Listing parents).
  assign product = product | default: closest.product
  assign variant_selector_type = variant_selector_type | default: block.settings.variant_selector_type | default: 'radio'
  assign is_cl_combined_listing = false
  assign has_cl_state = false
  assign has_cl_design = false
  for product_option in product.options_with_values
    assign product_option_name = product_option.name | strip | downcase
    if product_option_name == 'select state'
      assign has_cl_state = true
    elsif product_option_name == 'select design'
      assign has_cl_design = true
    endif
  endfor
  # A state-specific Combined Listing parent has only "Select Design". The
  # original multi-state pilot has both options, so Select Design is the
  # common, intentional marker for CityLocs' custom combined-listing UI.
  if has_cl_design
    assign is_cl_combined_listing = true
  endif

  if is_cl_combined_listing
    for product_option in product.options_with_values
      assign product_option_name = product_option.name | strip | downcase
      if product_option_name == 'select state'
        assign cl_selected_state = product_option.selected_value
      elsif product_option_name == 'select design'
        assign cl_selected_design = product_option.selected_value
      endif
    endfor

    # ── Preview lookup table ───────────────────────────────────────────────
    # ONE row per design: "State~Design~Handle~HasDate".
    #   Design  = the value WITHOUT any " Plate" suffix ("2000 Plate" matches
    #             "2000" — the selected value is normalized in the lookup below).
    #   Handle  = a key in CL_PLATE_CFG (assets/cl-pack-grid.js).
    #   HasDate = 1 shows the Month/Year fields (e.g. California 60's), else 0.
