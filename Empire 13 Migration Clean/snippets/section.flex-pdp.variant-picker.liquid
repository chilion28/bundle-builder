    # selected design so a " Plate" suffix can't break the match.
    assign cl_preview_handle = ''
    assign cl_preview_has_date = false
    assign cl_design_key = cl_selected_design | remove: ' Plate' | strip
    for cl_row in cl_rows
      assign cl_cols = cl_row | split: '~'
      if cl_cols[0] == cl_selected_state and cl_cols[1] == cl_design_key
        assign cl_preview_handle = cl_cols[2]
        if cl_cols[3] == '1'
          assign cl_preview_has_date = true
        endif
        break
      endif
    endfor
  endif
%}

{% if is_cl_combined_listing %}
  {{ 'cl-pack-grid.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cl-pack-grid.js' | asset_url }}" defer></script>
  <script src="{{ 'cl-combined-quantity-state.js' | asset_url }}" defer></script>
{% endif %}

{% capture variant_selector %}
  {%- unless product.has_only_default_variant -%}
    {% for option in product.options_with_values %}
      {% assign normalized_option_name = option.name | strip | downcase %}
      {% assign option_selector_type = variant_selector_type %}
      {% if normalized_option_name == 'select state' %}
        {% assign option_selector_type = 'select' %}
      {% endif %}

      <div class="cl-combined-option cl-combined-option--{{ option.name | handleize }}{% if is_cl_combined_listing and normalized_option_name == 'select state' %} cl-combined-option--state-locked{% endif %}">
      {% if is_cl_combined_listing and normalized_option_name == 'color' %}
        <details class="cl-combined-perso-accordion cl-combined-qty-accordion" open>
          <summary class="cl-combined-perso-accordion__summary">
            <span>Choose colors &amp; quantities</span>
            <svg class="cl-combined-perso-accordion__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
        <div class="cl-combined-quantity-grid" data-cl-combined-quantity-grid>
          <div class="cl-combined-quantity-grid__rows">
            {% for variant in product.variants %}
              {% assign variant_matches = true %}
              {% for comparison_option in product.options_with_values %}
                {% assign comparison_name = comparison_option.name | strip | downcase %}
                {% unless comparison_name == 'color' %}
                  {% assign comparison_index = comparison_option.position | minus: 1 %}
                  {% if variant.options[comparison_index] != comparison_option.selected_value %}
                    {% assign variant_matches = false %}
                  {% endif %}
                {% endunless %}
              {% endfor %}

              {% if variant_matches and variant.available %}
                {% assign color_index = option.position | minus: 1 %}
                {% assign color_name = variant.options[color_index] %}
                {% assign row_image = variant.featured_image | default: product.featured_image %}
                <div class="cl-combined-quantity-row" data-cl-combined-quantity-row data-variant-id="{{ variant.id }}" data-price="{{ variant.price }}">
                  <div class="cl-combined-quantity-row__image">
                    {% if row_image %}
                      {{ row_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 180', alt: color_name }}
                    {% endif %}
                  </div>
                  <span class="cl-combined-quantity-row__name">{{ color_name }}</span>
                  <div class="cl-combined-quantity-row__stepper">
                    <button type="button" data-cl-combined-minus aria-label="Decrease {{ color_name | escape }} quantity">−</button>
                    <input type="number" inputmode="numeric" min="0" value="0" data-cl-combined-qty aria-label="{{ color_name | escape }} quantity">
                    <button type="button" data-cl-combined-plus aria-label="Increase {{ color_name | escape }} quantity">+</button>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        </details>
      {% else %}
      {% case option_selector_type %}
        {% when 'radio' %}
          {% capture option_name_content %}
            {% assign option_name = option.name | append: ':' %}
            {% render 'element.text', as: 'span', text: option_name, style: 'font-weight: 600;' %}
            {% render 'element.text', as: 'span', text: product.selected_or_first_available_variant.options[forloop.index0], style: 'opacity: 0.75;' %}
          {% endcapture %}

          {% capture option_name %}
            {% render 'element.text', variant: 'body-sm', text: option_name_content %}
          {% endcapture %}

          {% capture option_values %}
            {% for value in option.values %}
              {% comment %}
                The hot-reload resolver now selects the first genuinely
                available downstream variant whenever an upstream option
                changes, so unavailable values can be omitted safely.
              {% endcomment %}
              {% if value.available == false %}
                {% continue %}
              {% endif %}
              {%- assign classlist = '' -%}
              {% if is_cl_combined_listing and normalized_option_name == 'select design' %}
                {% assign classlist = 'cl-combined-design-radio' %}
              {% endif %}

              {%- capture input_id -%}
                {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
              {%- endcapture -%}

              {% assign input_value = value | escape %}

              {%- capture input_label -%}
                {% if is_cl_combined_listing and normalized_option_name == 'select design' %}
                  {% liquid
                    assign cl_design_product = product
                    assign cl_design_product_url = value.product_url | default: ''
                    if cl_design_product_url != blank
                      assign cl_design_handle = cl_design_product_url | split: '/products/' | last | split: '?' | first | split: '#' | first
                      assign cl_design_product_from_url = all_products[cl_design_handle]
                      if cl_design_product_from_url != blank
                        assign cl_design_product = cl_design_product_from_url
                      endif
                    endif
                    assign cl_design_swatch = cl_design_product.metafields.custom.design_swatch.value
                    # Cloned child products do not always inherit the custom
                    # swatch metafield. Use their own featured image as a
                    # graceful visual fallback instead of rendering text-only
                    # design controls.
                    if cl_design_swatch == blank and cl_design_product.featured_media != blank
                      assign cl_design_swatch = cl_design_product.featured_media.preview_image
                    endif
                  %}
                  <span class="cl-combined-design-card{% if value.selected %} cl-combined-design-card--selected{% endif %}">
                    {% if cl_design_swatch != blank %}
                      <span class="cl-combined-design-card__image">
                        {{ cl_design_swatch | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360', sizes: '(max-width: 749px) 96px, 120px', alt: value }}
                      </span>
                    {% endif %}
                    <span class="cl-combined-design-card__label">{{ value }}</span>
                  </span>
                {% elsif value.swatch %}
                  {% assign swatch_disabled = false %}
                  {% if value.available == false %}
                    {% assign swatch_disabled = true %}
                  {% endif %}

                  {%- render 'element.text', text: value, visually_hidden: true -%}
                  {%- render 'element.swatch', swatch: value.swatch, large: true, selected: value.selected, disabled: swatch_disabled -%}
                {% else %}
                  {% if value.selected %}
                    {%- render 'element.button', as: 'span', text: value, classlist:'variant-option-value-name-selected', size: 'sm', style: '--element-button-color-primary: var(--color-primary); --element-button-color-secondary: var(--color-secondary);' -%}
                  {% else %}
                    {%- render 'element.button', as: 'span', text: value, classlist: 'variant-option-value-name', inverted: true, size: 'sm', style: '--element-button-color-primary: var(--color-primary); --element-button-color-secondary: var(--color-secondary);' -%} 
                  {% endif %}
                {% endif %}
              {%- endcapture -%}

              {%- capture input_attributes -%}
                {% render 'product.hot-reload.radio-attributes', value: value %}
                {%- comment %}
                  Flag the state's own plate (the design whose normalized value
                  matches the inferred state, e.g. "Washington Plate" for
                  Washington) so the client can default to it on first load.
                  Multi-design pilots (CA/TX) have no such match and fall back to
                  Shopify's default variant.
                {% endcomment -%}
                {%- if is_cl_combined_listing and normalized_option_name == 'select design' and cl_selected_state != blank -%}
                  {%- assign cl_value_key = value | remove: ' Plate' | strip -%}
                  {%- if cl_value_key == cl_selected_state -%} data-cl-state-plate="1"{%- endif -%}
                {%- endif -%}
              {%- endcapture -%}

              {%- render 'element.radio',
                id: input_id,
                name: option.name,
                value: input_value,
                slot: input_label,
                checked: value.selected,
                display_icon: false,
                classlist: classlist,
                attributes: input_attributes
              -%}
            {% endfor %}
          {% endcapture %}

          {% capture option_stack %}
            {{ option_name }}
            {% render 'layout.stack', horizontal: true, gap: 'xs', slot: option_values %}
            {% if is_cl_combined_listing and normalized_option_name == 'select design' %}
              <details class="cl-combined-perso-accordion" open>
                <summary class="cl-combined-perso-accordion__summary">
                  <span>Customize your plate</span>
                  <svg class="cl-combined-perso-accordion__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
              <div class="cl-combined-personalizer cl-grid-perso" data-cl-combined-personalizer data-cl-preview-handle="{{ cl_preview_handle }}" data-cl-preview-script="{{ 'cl-pack-grid.js' | asset_url }}">
                <div class="cl-grid-perso-preview" data-cl-perso-preview aria-live="polite"></div>

                <label class="cl-combined-personalizer__field cl-grid-perso-field">
                  <span><strong>Custom Text</strong><small data-cl-counter="Custom Text">20/20</small></span>
                  <input type="text" name="properties[Custom Text]" maxlength="20" placeholder="CUSTOM" autocomplete="off" required data-cl-personalization-field="Custom Text">
                </label>

                <label class="cl-combined-personalizer__toggle">
                  <input type="checkbox" data-cl-second-line-toggle>
                  <span>Add a second line of text</span>
                </label>

                <label class="cl-combined-personalizer__field cl-grid-perso-field" data-cl-second-line-field hidden>
                  <span><strong>Second Line</strong><small data-cl-counter="Custom Text Two">26/26</small></span>
                  <input type="text" name="properties[Custom Text Two]" maxlength="26" placeholder="OPTIONAL" autocomplete="off" disabled data-cl-personalization-field="Custom Text Two">
                </label>

                <label class="cl-combined-personalizer__field cl-grid-perso-field"{% unless cl_preview_has_date %} hidden{% endunless %}>
                  <span><strong>Month</strong><small data-cl-counter="Month">3/3</small></span>
                  <input type="text" name="properties[Month]" maxlength="3" placeholder="MONTH" autocomplete="off"{% if cl_preview_has_date %} required{% else %} disabled{% endif %} data-cl-personalization-field="Month">
                </label>

                <label class="cl-combined-personalizer__field cl-grid-perso-field"{% unless cl_preview_has_date %} hidden{% endunless %}>
                  <span><strong>Year</strong><small data-cl-counter="Year">4/4</small></span>
                  <input type="text" name="properties[Year]" maxlength="4" placeholder="YEAR" autocomplete="off"{% if cl_preview_has_date %} required{% else %} disabled{% endif %} data-cl-personalization-field="Year">
                </label>
              </div>
              </details>
            {% endif %}
          {% endcapture %}

          {% render 'layout.stack', gap: 'xs', horizontal: false, slot: option_stack %}
        {% when 'select' %}
          {%- capture input_id -%}
            {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
          {%- endcapture -%}

          {% capture options %}
            {% for value in option.values %}
              {%- capture option_input_attributes -%}
                {% if value.available == false %}
                  disabled
                {% endif %}
                {% if value.selected %}
                  selected
                {% endif %}
                {% render 'product.hot-reload.select-attributes', value: value, element: 'option' %}
              {%- endcapture -%}

              <option value="{{ value | escape }}" {{ option_input_attributes }}>{{ value }}</option>
            {% endfor %}
          {% endcapture %}

          {% capture select_attributes %}
            {% render 'product.hot-reload.select-attributes', element: 'select' %}
          {% endcapture %}

          {% capture option_stack %}
            {% render 'element.text', as: 'label', variant: 'body-sm', text: option.name, style: 'font-weight: 600;' %}
            {% render 'element.select',
              name: option.name,
              slot: options,
              id: input_id,
              placeholder: option.selected_value,
              attributes: select_attributes
            %}
          {% endcapture %}

          {% render 'layout.stack', gap: 'xs', horizontal: false, slot: option_stack %}
      {% endcase %}
      {% endif %}
      </div>
    {% endfor %}
  {%- endunless -%}
{% endcapture %}

{% render 'layout.stack', gap: 'sm', slot: variant_selector %}

