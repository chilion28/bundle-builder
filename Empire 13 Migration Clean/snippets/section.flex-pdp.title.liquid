  Copyright © 2025 Archetype Themes LP. All rights reserved.
  
  Renders the product title as a heading element.
  
  This component displays the product title using the element.text component with 
  heading styling. The size can be customized to fit different design requirements.
  
  @param {object} product - A product object
  @param {string} [size] - The heading size variant ('sm', 'md', 'lg', 'xl', '2xl') (default: 'xl')
  
  @example
  {% render 'section.flex-pdp.title', size: '2xl', product: closest.product %}
{% enddoc %}

{% liquid
  assign size = size | default: block.settings.size | default: 'xl'
  assign title_font_source = block.settings.font_source | default: 'heading'
  assign title_font_weight = block.settings.font_weight | default: '700'
  assign title_line_height = block.settings.line_height | default: 110
  assign title_letter_spacing = block.settings.letter_spacing | default: 0
  assign title_transform = block.settings.text_transform | default: 'none'
  assign title_alignment = block.settings.alignment | default: 'start'
  assign title_color = block.settings.color | default: '#1f2328'
  assign title_spacing_top = block.settings.spacing_top | default: 0
  assign title_spacing_bottom = block.settings.spacing_bottom | default: 0
  assign title_class = 'product-title product-title--' | append: block.id

  assign title_font_source_mobile = block.settings.font_source_mobile | default: 'heading'
  assign title_font_weight_mobile = block.settings.font_weight_mobile | default: '700'
  assign title_line_height_mobile = block.settings.line_height_mobile | default: 110
  assign title_letter_spacing_mobile = block.settings.letter_spacing_mobile | default: 0
  assign title_transform_mobile = block.settings.text_transform_mobile | default: 'none'
  assign title_alignment_mobile = block.settings.alignment_mobile | default: 'start'
  assign title_color_mobile = block.settings.color_mobile | default: '#1f2328'
  assign title_spacing_top_mobile = block.settings.spacing_top_mobile | default: 0
  assign title_spacing_bottom_mobile = block.settings.spacing_bottom_mobile | default: 0

  if title_font_source == 'body'
    assign title_font_family = 'var(--body-font-family)'
    assign title_font_fallback = 'var(--body-font-family-fallback)'
  else
    assign title_font_family = 'var(--heading-font-family)'
    assign title_font_fallback = 'var(--heading-font-family-fallback)'
  endif

  if title_font_source_mobile == 'body'
    assign title_font_family_mobile = 'var(--body-font-family)'
    assign title_font_fallback_mobile = 'var(--body-font-family-fallback)'
  else
    assign title_font_family_mobile = 'var(--heading-font-family)'
    assign title_font_fallback_mobile = 'var(--heading-font-family-fallback)'
  endif
%}

{% capture title_style %}
  --_font-family: {{ title_font_family }};
  --_font-family-fallback: {{ title_font_fallback }};
  --_font-weight: {{ title_font_weight }};
  --_line-height: {{ title_line_height | divided_by: 100.0 }};
  --_letter-spacing: {{ title_letter_spacing }}px;
  --_color: {{ title_color }};
  display: block;
  margin-block: {{ title_spacing_top }}px {{ title_spacing_bottom }}px;
{% endcapture %}

{% if block.settings.custom_font_sizes %}
  <style>
    .product-title--{{ block.id }} {
      --_font-size: {{ block.settings.font_size_desktop }}px;
    }

    @media screen and (max-width: 767px) {
      .product-title--{{ block.id }} {
        --_font-size: {{ block.settings.font_size_mobile }}px;
      }
    }
  </style>
{% endif %}

{% if block.settings.use_mobile_styles %}
  <style>
    @media screen and (max-width: 767px) {
      .product-title--{{ block.id }} {
        --_font-size: {{ block.settings.font_size_mobile | default: 32 }}px !important;
        --_font-family: {{ title_font_family_mobile }} !important;
        --_font-family-fallback: {{ title_font_fallback_mobile }} !important;
        --_font-weight: {{ title_font_weight_mobile }} !important;
        --_line-height: {{ title_line_height_mobile | divided_by: 100.0 }} !important;
        --_letter-spacing: {{ title_letter_spacing_mobile }}px !important;
        --_color: {{ title_color_mobile }} !important;
        margin-block: {{ title_spacing_top_mobile }}px {{ title_spacing_bottom_mobile }}px !important;
        text-align: {{ title_alignment_mobile }} !important;
        text-transform: {{ title_transform_mobile }} !important;
      }
    }
  </style>
{% endif %}

{% render 'element.text', as: 'h1', variant: 'heading', size: size, text: product.title, classlist: title_class, alignment: title_alignment, text_transform: title_transform, style: title_style %}
