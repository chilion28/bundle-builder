{% render 'section.flex-pdp.price', product: closest.product %}

{% schema %}
{
  "name": "t:flex_pdp.blocks.price.name",
  "settings": [
    {
      "type": "range",
      "id": "font_size",
      "label": "Price font size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Price font weight",
      "default": "700",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "color",
      "id": "color",
      "label": "Price color",
      "default": "#1f2328"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Price alignment",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "superscript_decimals",
      "label": "Superscript cents",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "product_save_amount",
      "label": "Show savings",
      "default": true
    },
    {
      "type": "select",
      "id": "product_save_type",
      "label": "Savings format",
      "default": "dollar",
      "options": [
        { "value": "dollar", "label": "Dollar amount" },
        { "value": "percent", "label": "Percentage" }
      ]
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Spacing above",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Spacing below",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile price styling"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_styles",
      "label": "Use custom mobile price styles",
      "default": false
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Mobile price font size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18,
      "visible_if": "{{ block.settings.use_mobile_styles }}"
    },
    {
      "type": "select",
      "id": "font_weight_mobile",
      "label": "Mobile price font weight",
      "default": "700",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "visible_if": "{{ block.settings.use_mobile_styles }}"
    },
    {
      "type": "color",
      "id": "color_mobile",
      "label": "Mobile price color",
      "default": "#1f2328",
      "visible_if": "{{ block.settings.use_mobile_styles }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment_mobile",
      "label": "Mobile price alignment",
      "default": "left",
      "visible_if": "{{ block.settings.use_mobile_styles }}"
    },
    {
      "type": "range",
      "id": "spacing_top_mobile",
      "label": "Mobile spacing above",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_styles }}"
    },
    {
      "type": "range",
      "id": "spacing_bottom_mobile",
      "label": "Mobile spacing below",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_styles }}"
    }
  ],
  "presets": [
    {
      "name": "t:flex_pdp.blocks.price.name"
    }
  ]
}
{% endschema %}
