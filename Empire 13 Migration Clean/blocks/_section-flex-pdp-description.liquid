<div
  class="product-description product-description--{{ block.id }}"
  data-mobile-styles="{{ block.settings.use_mobile_styles }}"
  style="--product-description-font-size: {{ block.settings.font_size | default: 16 }}px; --product-description-line-height: {{ block.settings.line_height | default: 165 | divided_by: 100.0 }}; --product-description-spacing-top: {{ block.settings.spacing_top | default: 0 }}px; --product-description-spacing-bottom: {{ block.settings.spacing_bottom | default: 0 }}px; --product-description-font-size-mobile: {{ block.settings.font_size_mobile | default: 16 }}px; --product-description-line-height-mobile: {{ block.settings.line_height_mobile | default: 165 | divided_by: 100.0 }}; --product-description-spacing-top-mobile: {{ block.settings.spacing_top_mobile | default: 0 }}px; --product-description-spacing-bottom-mobile: {{ block.settings.spacing_bottom_mobile | default: 0 }}px;"
>
  {% render 'section.flex-pdp.description', product: closest.product %}
</div>

{% stylesheet %}
  .product-description {
    font-size: var(--product-description-font-size, 16px);
    line-height: var(--product-description-line-height, 1.65);
    margin-block: var(--product-description-spacing-top, 0) var(--product-description-spacing-bottom, 0);
  }

  .product-description :is(p, li) {
    font-size: inherit;
    line-height: inherit;
  }

  @media screen and (max-width: 767px) {
    .product-description[data-mobile-styles="true"] {
      font-size: var(--product-description-font-size-mobile, var(--product-description-font-size, 16px));
      line-height: var(--product-description-line-height-mobile, var(--product-description-line-height, 1.65));
      margin-block: var(--product-description-spacing-top-mobile, 0) var(--product-description-spacing-bottom-mobile, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:flex_pdp.blocks.description.name",
  "settings": [
    {
      "type": "range",
      "id": "font_size",
      "label": "Description font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Description line height",
      "min": 120,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 165
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Spacing above",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Spacing below",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile description styling"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_styles",
      "label": "Use custom mobile description styles",
      "default": false
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Mobile description font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.use_mobile_styles }}"
    },
    {
      "type": "range",
      "id": "line_height_mobile",
      "label": "Mobile description line height",
      "min": 120,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 165,
      "visible_if": "{{ block.settings.use_mobile_styles }}"
    },
    {
      "type": "range",
      "id": "spacing_top_mobile",
      "label": "Mobile spacing above",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_styles }}"
    },
    {
      "type": "range",
      "id": "spacing_bottom_mobile",
      "label": "Mobile spacing below",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_styles }}"
    }
  ],
  "presets": [
    {
      "name": "t:flex_pdp.blocks.description.name"
    }
  ]
}
{% endschema %}
